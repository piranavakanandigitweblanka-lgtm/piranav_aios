{"sections":{"main":{"type":"main-page","settings":{}},"custom_html_Qg4GLA":{"type":"custom-html","name":"Custom HTML","settings":{"heading_logo_svg":"","heading":"","description":"","text_alignment":"text-center","container":"container","color_scheme":"","content_html":"<div class=\"loyalty-offer-card-fr\" id=\"shopify-loyalty-offer\">\n  <style>\n    \/* Loyalty Offers French Styling *\/\n    .loyalty-offer-card-fr {\n      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;\n      max-width: 1200px;\n      margin: 0 auto;\n      background: white;\n      border-radius: 12px;\n      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n      overflow: hidden;\n      border: 1px solid #e1e5e9;\n    }\n    \n    .loyalty-offer-card-fr .card-header {\n      background: linear-gradient(135deg, #0055a4 0%, #003d7a 100%);\n      color: white;\n      padding: 22px 25px;\n      position: relative;\n    }\n    \n    .loyalty-offer-card-fr .card-header h2 {\n      margin: 0;\n      font-size: 1.6rem;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n    \n    .loyalty-offer-card-fr .card-header h2 i {\n      color: #ffd700;\n    }\n    \n    .loyalty-offer-card-fr .card-content {\n      padding: 25px;\n      display: flex;\n      flex-wrap: wrap;\n      gap: 25px;\n    }\n    \n    .loyalty-offer-card-fr .offer-column {\n      flex: 1;\n      min-width: 300px;\n    }\n    \n    .loyalty-offer-card-fr .column-title {\n      font-size: 1.4rem;\n      font-weight: 700;\n      color: #2d3748;\n      margin-bottom: 15px;\n      padding-bottom: 10px;\n      border-bottom: 2px solid #0055a4;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n    \n    .loyalty-offer-card-fr .column-title i {\n      color: #0055a4;\n    }\n    \n    .loyalty-offer-card-fr .intro-text {\n      color: #4a5568;\n      font-size: 1.4rem;\n      line-height: 1.5;\n      margin-bottom: 20px;\n      padding-bottom: 15px;\n      border-bottom: 1px solid #edf2f7;\n    }\n    \n    .loyalty-offer-card-fr .offers-list {\n      list-style: none;\n      padding: 0;\n      margin: 0 0 25px 0;\n    }\n    \n    .loyalty-offer-card-fr .offer-item {\n      display: flex;\n      align-items: center;\n      margin-bottom: 14px;\n      padding: 12px 15px;\n      background-color: #f8f9fa;\n      border-radius: 8px;\n      border-left: 4px solid #ffd700;\n    }\n    \n    .loyalty-offer-card-fr .bulk-offer-item {\n      border-left: 4px solid #0055a4;\n    }\n    \n    .loyalty-offer-card-fr .offer-icon {\n      min-width: 24px;\n      color: #0055a4;\n      margin-right: 12px;\n      font-size: 1.4rem;\n    }\n    \n    .loyalty-offer-card-fr .offer-text {\n      color: #2d3748;\n      font-size: 1.3rem;\n      font-weight: 500;\n      line-height: 1.4;\n    }\n    \n    .loyalty-offer-card-fr .footer-text {\n      color: #718096;\n      font-size: 1.3rem;\n      line-height: 1.5;\n      font-style: italic;\n      margin-bottom: 20px;\n      padding: 12px;\n      background-color: #f8f9fa;\n      border-radius: 6px;\n      border-left: 3px solid #0055a4;\n    }\n    \n    .loyalty-offer-card-fr .bulk-description {\n      color: #4a5568;\n      font-size: 1.3rem;\n      line-height: 1.5;\n      margin-bottom: 20px;\n      padding: 15px;\n      background-color: #f8f9fa;\n      border-radius: 8px;\n      border: 1px solid #e1e5e9;\n    }\n    \n    .loyalty-offer-card-fr .bulk-highlight {\n      color: #0055a4;\n      font-weight: 600;\n    }\n    \n    .loyalty-offer-card-fr .buttons-container {\n      display: flex;\n      gap: 15px;\n      margin-top: 25px;\n    }\n    \n    .loyalty-offer-card-fr .learn-more-btn {\n      flex: 1;\n      background-color: #0055a4;\n      color: white;\n      border: none;\n      padding: 14px;\n      border-radius: 6px;\n      font-size: 1.4rem;\n      font-weight: 600;\n      text-align: center;\n      cursor: pointer;\n      transition: all 0.2s ease;\n      text-decoration: none;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    \n    .loyalty-offer-card-fr .bulk-btn {\n      background-color: #2d3748;\n    }\n    \n    .loyalty-offer-card-fr .bulk-btn:hover {\n      background-color: #1a202c;\n    }\n    \n    .loyalty-offer-card-fr .learn-more-btn:hover {\n      background-color: #004a8f;\n      transform: translateY(-2px);\n      box-shadow: 0 4px 12px rgba(0, 85, 164, 0.2);\n    }\n    \n    .loyalty-offer-card-fr .learn-more-btn i {\n      margin-left: 8px;\n      transition: transform 0.2s ease;\n    }\n    \n    .loyalty-offer-card-fr .learn-more-btn:hover i {\n      transform: translateX(3px);\n    }\n    \n    \/* Responsive adjustments *\/\n    @media (max-width: 768px) {\n      .loyalty-offer-card-fr .card-content {\n        flex-direction: column;\n        gap: 30px;\n      }\n      \n      .loyalty-offer-card-fr .offer-column {\n        min-width: 100%;\n      }\n      \n      .loyalty-offer-card-fr .buttons-container {\n        flex-direction: column;\n      }\n    }\n    \n    @media (max-width: 480px) {\n      .loyalty-offer-card-fr {\n        max-width: 100%;\n      }\n      \n      .loyalty-offer-card-fr .card-header,\n      .loyalty-offer-card-fr .card-content {\n        padding: 18px;\n      }\n      \n      .loyalty-offer-card-fr .card-header h2 {\n        font-size: 1.4rem;\n      }\n    }\n  <\/style>\n  \n  <div class=\"card-header\">\n    <h2>\n      <i class=\"fas fa-crown\"><\/i> Offres de Fidélité &amp; Achat en Gros\n    <\/h2>\n  <\/div>\n  \n  <div class=\"card-content\">\n    <!-- Left Column: Loyalty Offers -->\n    <div class=\"offer-column\">\n      <h3 class=\"column-title\">\n        <i class=\"fas fa-gift\"><\/i> Offres de Fidélité\n      <\/h3>\n      \n      <p class=\"intro-text\">Nous apprécions votre soutien continu et nous voulons vous rendre la pareille !<\/p>\n      \n      <ul class=\"offers-list\">\n        <li class=\"offer-item\">\n          <div class=\"offer-icon\"><i class=\"fas fa-percentage\"><\/i><\/div>\n          <div class=\"offer-text\">10% DE RÉDUCTION pour les clients fidèles<\/div>\n        <\/li>\n        \n        <li class=\"offer-item\">\n          <div class=\"offer-icon\"><i class=\"fas fa-envelope\"><\/i><\/div>\n          <div class=\"offer-text\">Abonnés à la newsletter uniquement<\/div>\n        <\/li>\n        \n        <li class=\"offer-item\">\n          <div class=\"offer-icon\"><i class=\"fas fa-check-circle\"><\/i><\/div>\n          <div class=\"offer-text\">Valable uniquement sur des produits sélectionnés<\/div>\n        <\/li>\n      <\/ul>\n      \n      <p class=\"footer-text\">Votre fidélité compte pour nous — profitez d'économies exclusives à chaque fois que vous magasinez.<\/p>\n    <\/div>\n    \n    <!-- Right Column: Bulk Purchase Offers -->\n    <div class=\"offer-column\">\n      <h3 class=\"column-title\">\n        <i class=\"fas fa-boxes\"><\/i> Offre d'Achat en Gros\n      <\/h3>\n      \n      <p class=\"bulk-description\">\n        <span class=\"bulk-highlight\">Planning a large project or stocking up for your business?<\/span> \n        Enjoy exclusive savings when you buy in bulk.\n      <\/p>\n      \n      <ul class=\"offers-list\">\n        <li class=\"offer-item bulk-offer-item\">\n          <div class=\"offer-icon\"><i class=\"fas fa-tags\"><\/i><\/div>\n          <div class=\"offer-text\">\n<strong>15% OFF<\/strong> votre commande complète<\/div>\n        <\/li>\n        \n        <li class=\"offer-item bulk-offer-item\">\n          <div class=\"offer-icon\"><i class=\"fas fa-shopping-cart\"><\/i><\/div>\n          <div class=\"offer-text\">Achat minimum : <strong>€500.00<\/strong>\n<\/div>\n        <\/li>\n        \n        <li class=\"offer-item bulk-offer-item\">\n          <div class=\"offer-icon\"><i class=\"fas fa-users\"><\/i><\/div>\n          <div class=\"offer-text\">Idéal pour détaillants, designers d'intérieur, électriciens et entrepreneurs<\/div>\n        <\/li>\n        \n        <li class=\"offer-item bulk-offer-item\">\n          <div class=\"offer-icon\"><i class=\"fas fa-random\"><\/i><\/div>\n          <div class=\"offer-text\">Mélanger &amp; assortir les produits dans toute notre boutique<\/div>\n        <\/li>\n      <\/ul>\n      \n      <p class=\"footer-text\">\n        Obtenez des luminaires et accessoires premium au meilleur prix — parfait pour la revente ou les grandes installations.\n      <\/p>\n    <\/div>\n  <\/div>\n  \n  <div class=\"buttons-container\" style=\"padding: 0 25px 25px 25px;\">\n    <a href=\"https:\/\/ledsone.fr\/collections\/lampes-suspendues\" class=\"learn-more-btn\">\n      En savoir plus sur la fidélité\n      <i class=\"fas fa-arrow-right\"><\/i>\n    <\/a>\n    <a href=\"https:\/\/ledsone.fr\/\" class=\"learn-more-btn bulk-btn\">\n      Voir les produits en gros\n      <i class=\"fas fa-boxes\"><\/i>\n    <\/a>\n  <\/div>\n\n  <script>\n    \/\/ Load FontAwesome if not already loaded\n    if (!document.querySelector('link[href*=\"font-awesome\"]')) {\n      const link = document.createElement('link');\n      link.rel = 'stylesheet';\n      link.href = 'https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.4.0\/css\/all.min.css';\n      document.head.appendChild(link);\n    }\n    \n    \/\/ Simple animation on load\n    document.addEventListener('DOMContentLoaded', function() {\n      const card = document.getElementById('shopify-loyalty-offer');\n      if (card) {\n        card.style.opacity = '0';\n        card.style.transform = 'translateY(20px)';\n        card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';\n        \n        setTimeout(() => {\n          card.style.opacity = '1';\n          card.style.transform = 'translateY(0)';\n        }, 100);\n      }\n      \n      \/\/ Add click animation to offer items\n      const offerItems = document.querySelectorAll('.loyalty-offer-card-fr .offer-item');\n      offerItems.forEach(item => {\n        item.addEventListener('click', function() {\n          this.style.transform = 'scale(0.98)';\n          setTimeout(() => {\n            this.style.transform = '';\n          }, 200);\n        });\n      });\n    });\n  <\/script>\n<\/div>","padding_top":0,"padding_bottom":0,"reset_spacing":false}},"176517361329319cae":{"type":"apps","blocks":{"forms_inline_GniCj8":{"type":"shopify:\/\/apps\/forms\/blocks\/inline\/8744a304-fcb1-4347-b211-bb6b4759a76a","settings":{"form_id":"781528","text_color":"#202020","button_background_color":"#202020","button_label_color":"#ffffff","links_color":"#1878b9","errors_color":"#e02229","text_alignment":"center","form_alignment":"center","padding_top":0,"padding_bottom":24,"padding_right":0,"padding_left":0}}},"block_order":["forms_inline_GniCj8"],"settings":{}}},"order":["main","custom_html_Qg4GLA","176517361329319cae"]}