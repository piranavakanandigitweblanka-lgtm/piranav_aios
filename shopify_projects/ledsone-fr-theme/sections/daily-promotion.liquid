<!-- DAILY PROMOTION WITH TIMER IN GRID -->
<section class="daily-promotion-grid-timer">
  <div class="bls__section-inner">
    <!-- SECTION HEADER -->
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="dp-section-header">
        {% if section.settings.title != blank %}
          <h2 class="dp-section-title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="dp-section-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- PROMOTION PRODUCTS GRID WITH TIMER -->
    {% if section.settings.collection != blank %}
      {% assign selected_collection = collections[section.settings.collection] %}
      {% if selected_collection.products.size > 0 %}

        {% assign current_day = 'now' | date: '%j' | plus: 0 %}
        {% assign desktop_products = 5 %}
        {% assign mobile_products = 4 %}
        {% assign total_products = selected_collection.products.size %}
        {% assign total_sets_desktop = total_products | divided_by: desktop_products %}
        {% assign total_sets_mobile = total_products | divided_by: mobile_products %}

        {% if total_sets_desktop < 1 %}
          {% assign total_sets_desktop = 1 %}
        {% endif %}

        {% if total_sets_mobile < 1 %}
          {% assign total_sets_mobile = 1 %}
        {% endif %}

        {% assign today_set_index_desktop = current_day | modulo: total_sets_desktop %}
        {% assign start_index_desktop = today_set_index_desktop | times: desktop_products %}

        <div class="promo-grid-with-timer">
          {% for product in selected_collection.products offset:start_index_desktop %}
            {% if forloop.index0 < desktop_products %}

              {%- liquid
                assign target = product.selected_or_first_available_variant
                assign compare_at_price = target.compare_at_price
                assign price = target.price | default: 1999
              -%}

              <div class="promo-card product-card-{{ forloop.index }}">
                <div class="promo-image">
                  <a href="{{ product.url }}">
                    <img
                      src="{{ product.featured_image | image_url: width: 400 }}"
                      alt="{{ product.title | escape }}"
                      loading="lazy"
                      width="400"
                      height="400"
                    >
                  </a>

                  <!-- DISCOUNT BADGE -->
                  {%- if compare_at_price > price and compare_at_price != blank -%}
                    {%- assign discount_amount = compare_at_price | minus: price -%}
                    {%- if discount_amount > 0 -%}
                      {%- assign discount_percentage = discount_amount | times: 100.0 | divided_by: compare_at_price | round -%}
                    {%- endif -%}
                    <div class="dp-discount-badge">-{{ discount_percentage }}%</div>
                  {%- endif -%}

                  <!-- SOLD OUT BADGE -->
                  {% unless product.available %}
                    <div class="dp-sold-out-badge">{{ 'products.product.sold_out' | t }}</div>
                  {% endunless %}

                  <!-- MINI COUNTDOWN TIMER -->
                  <div class="dp-card-timer">
                    <span class="dp-timer-label">{{ section.settings.timer_label }}</span>
                    <span class="dp-timer-value" id="card-timer-{{ forloop.index }}">23:59:59</span>
                  </div>
                </div>

                <div class="promo-content">
                  <h3 class="dp-product-title">
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  </h3>

                  <div class="dp-pricing">
                    <div class="dp-price-wrap">
                      {% render 'price', product: product, use_variant: true %}
                    </div>
                    <a href="{{ product.url }}" class="dp-buy-now btn btn-primary btn-radius">
                      {{ section.settings.cta_label }}
                    </a>
                  </div>
                </div>
              </div>

            {% endif %}
          {% endfor %}
        </div>

      {% else %}
        <div class="dp-empty-message">
          <p>{{ 'sections.featured_collection.empty' | t }}</p>
        </div>
      {% endif %}
    {% else %}
      <div class="dp-empty-message">
        <p>{{ 'sections.featured_collection.no_collection' | t }}</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
.daily-promotion-grid-timer {
  padding: clamp(2rem, 3vw, 3rem) 0;
}

.daily-promotion-grid-timer .bls__section-inner {
  max-width: 1600px;
  margin: 0 auto;
  padding: 0 2rem;
}

/* SECTION HEADER */
.dp-section-header {
  text-align: center;
  margin-bottom: 2rem;
}

.dp-section-title {
  font-size: clamp(2rem, 3vw, 2.8rem);
  font-weight: var(--heading-font-weight, 700);
  color: var(--heading-color);
  margin-bottom: 0.6rem;
  letter-spacing: -0.03em;
}

.dp-section-subtitle {
  font-size: 1.4rem;
  color: var(--grey-color);
  margin: 0;
}

/* GRID — 5 columns desktop */
.promo-grid-with-timer {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem;
  align-items: start;
}

/* PRODUCT CARD */
.promo-card {
  background: var(--color-white, #fff);
  border-radius: var(--card-border-radius, var(--btn-border-radius, 8px));
  overflow: hidden;
  box-shadow: var(--bls-box-shadow, 0 4px 15px rgba(0,0,0,.08));
  transition: var(--bls-transition, all .3s ease);
  position: relative;
}

.promo-card:hover {
  box-shadow: 0 8px 25px rgba(0,0,0,.12);
  transform: translateY(-2px);
}

/* PRODUCT IMAGE */
.promo-image {
  position: relative;
  overflow: hidden;
  padding-top: 100%;
}

.promo-image img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: var(--bls-transition, transform .4s ease);
}

.promo-card:hover .promo-image img {
  transform: var(--bls-transform, scale(1.04));
}

/* DISCOUNT BADGE */
.dp-discount-badge {
  position: absolute;
  top: 0;
  left: 0;
  width: 120px;
  background: var(--primary-color);
  color: #fff;
  font-size: 1.8rem;
  font-weight: 700;
  text-align: center;
  padding: 6px 3px;
  transform: rotate(-45deg) translate(-28px, -20px);
  z-index: 2;
}

/* SOLD OUT BADGE */
.dp-sold-out-badge {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: rgba(0,0,0,.75);
  color: #fff;
  padding: 5px 10px;
  border-radius: var(--btn-border-radius, 6px);
  font-size: 1.2rem;
  font-weight: 600;
  z-index: 3;
  backdrop-filter: blur(4px);
}

/* COUNTDOWN TIMER */
.dp-card-timer {
  position: absolute;
  bottom: 1rem;
  left: 1rem;
  right: 1rem;
  background: rgba(0,0,0,.45);
  color: #fff;
  padding: 7px 12px;
  border-radius: var(--btn-border-radius, 8px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(8px);
  z-index: 2;
}

.dp-timer-label {
  font-size: 1.2rem;
  opacity: .9;
}

.dp-timer-value {
  font-size: 1.3rem;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  letter-spacing: .5px;
}

/* CARD CONTENT */
.promo-content {
  padding: 1rem;
}

.dp-product-title {
  margin-bottom: .8rem;
}

.dp-product-title a {
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--heading-color);
  text-decoration: none;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: var(--bls-transition, color .2s ease);
}

.dp-product-title a:hover {
  color: var(--primary-color);
}

/* PRICING ROW */
.dp-pricing {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .8rem;
  flex-wrap: wrap;
}

.dp-price-wrap {
  flex: 1;
}

/* Inherit theme price styles — bls__price handles colours via theme vars */
.dp-price-wrap .bls__product-price {
  margin-top: 0;
}

/* BUY NOW BUTTON — uses theme btn classes */
.dp-buy-now {
  font-size: 1.2rem;
  white-space: nowrap;
  padding: 7px 14px;
  text-decoration: none;
}

/* EMPTY STATE */
.dp-empty-message {
  text-align: center;
  padding: 4rem;
  background: var(--color-white, #fff);
  border-radius: var(--btn-border-radius, 8px);
  box-shadow: var(--bls-box-shadow, 0 4px 15px rgba(0,0,0,.08));
  color: var(--grey-color);
  grid-column: 1 / -1;
}

/* ── RESPONSIVE ── */

/* Tablet ≤ 1200px — 4 columns, hide 5th card */
@media (max-width: 1200px) {
  .promo-grid-with-timer {
    grid-template-columns: repeat(4, 1fr);
  }
  .promo-card.product-card-5 {
    display: none;
  }
}

/* Tablet ≤ 768px — 2×2 grid, hide 5th card */
@media (max-width: 768px) {
  .promo-grid-with-timer {
    grid-template-columns: repeat(2, 1fr);
  }
  .promo-card.product-card-5 {
    display: none !important;
  }
  .promo-content {
    padding: 1.2rem;
  }
  .dp-buy-now {
    width: 100%;
    text-align: center;
  }
}

/* Small phones ≤ 480px */
@media (max-width: 480px) {
  .daily-promotion-grid-timer .bls__section-inner {
    padding: 0 1.2rem;
  }
  .promo-grid-with-timer {
    gap: 1.2rem;
  }
  .promo-image {
    padding-top: 90%;
  }
  .dp-card-timer {
    padding: 5px 8px;
  }
  .dp-product-title a {
    font-size: 1.2rem;
  }
}

/* Very narrow ≤ 360px */
@media (max-width: 360px) {
  .promo-grid-with-timer {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  function updateCardTimers() {
    var now = new Date();
    var midnight = new Date();
    midnight.setHours(24, 0, 0, 0);
    var diff = midnight - now;
    if (diff <= 0) return;

    var h = Math.floor(diff / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    var pad = function (n) { return n < 10 ? "0" + n : n; };
    var display = pad(h) + ":" + pad(m) + ":" + pad(s);

    document.querySelectorAll('[id^="card-timer-"]').forEach(function (el) {
      el.textContent = display;
    });
  }

  updateCardTimers();
  setInterval(updateCardTimers, 1000);
});
</script>

{% schema %}
{
  "name": "Daily Promotion Timer",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Un jour. Une décision intelligente."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Offres à durée limitée - Actualisez-les toutes les 24 heures"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose collection"
    },
    {
      "type": "text",
      "id": "timer_label",
      "label": "Timer label",
      "default": "Ends in:"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Buy Now →"
    }
  ],
  "presets": [
    {
      "name": "Daily Promotion Timer"
    }
  ]
}
{% endschema %}
