{% comment %}
  Bento Grid Features Section — UI Upgraded 2026-09-07
{% endcomment %}

<section class="bento-grid-section" id="bento-grid-{{ section.id }}">

  {% if section.settings.title != blank or section.settings.subtitle != blank %}
    <div class="bento-section-header">
      {% if section.settings.eyebrow != blank %}
        <span class="bento-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="bento-heading">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="bento-subheading">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="bento-wrapper">
    <div class="bento-grid">

      {% for block in section.blocks %}
        {% case block.type %}

          {% when 'feature_card' %}
            <div class="bento-card bento-card--{{ block.settings.size }} bento-card--{{ block.settings.style }}"
                 style="--card-index: {{ forloop.index }};"
                 {{ block.shopify_attributes }}>

              {% if block.settings.image %}
                <div class="bento-card__image">
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                  >
                </div>
                {% if block.settings.style == 'image-bg' %}
                  <div class="bento-card__overlay"></div>
                {% endif %}
              {% endif %}

              <div class="bento-card__content">
                {% if block.settings.tag != blank %}
                  <span class="bento-card__tag">
                    <span class="bento-tag-dot"></span>
                    {{ block.settings.tag }}
                  </span>
                {% endif %}
                {% if block.settings.title != blank %}
                  <h3 class="bento-card__title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.description != blank %}
                  <p class="bento-card__desc">{{ block.settings.description }}</p>
                {% endif %}
                {% if block.settings.badge_1 != blank or block.settings.badge_2 != blank %}
                  <div class="bento-card__badges">
                    {% if block.settings.badge_1 != blank %}
                      <span class="bento-badge">{{ block.settings.badge_1 }}</span>
                    {% endif %}
                    {% if block.settings.badge_2 != blank %}
                      <span class="bento-badge">{{ block.settings.badge_2 }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="bento-card__link" aria-label="{{ block.settings.title | escape }}">
                  <span class="bento-card__arrow">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </a>
              {% endif %}

            </div>

        {% endcase %}
      {% endfor %}

    </div>
  </div>
</section>

<style>
  /* ── SECTION SCOPED TOKENS ── */
  #bento-grid-{{ section.id }} {
    --bento-gap:         {{ section.settings.gap }}px;
    --bento-radius:      {{ section.settings.border_radius }}px;
    --bento-card-bg:     {{ section.settings.card_bg }};
    --bento-text:        {{ section.settings.text_color }};
    --bento-accent:      {{ section.settings.accent_color }};
    --bento-badge-bg:    {{ section.settings.badge_bg }};
    --bento-badge-text:  {{ section.settings.badge_text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_bg }};
  }

  /* ── WRAPPER ── */
  #bento-grid-{{ section.id }} .bento-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ── SECTION HEADER ── */
  .bento-section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto clamp(2.4rem, 4vw, 4rem);
    padding: 0 2rem;
  }

  .bento-eyebrow {
    display: inline-block;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--bento-accent, var(--primary-color));
    margin-bottom: .8rem;
  }

  .bento-heading {
    font-size: clamp(2.2rem, 3.5vw, 3.4rem);
    font-weight: var(--heading-font-weight, 700);
    color: var(--bento-text, var(--heading-color));
    line-height: 1.2;
    letter-spacing: -.03em;
    margin: 0 0 1rem;
  }

  .bento-subheading {
    font-size: 1.5rem;
    color: var(--grey-color, #666);
    line-height: 1.6;
    margin: 0;
  }

  /* ── GRID ── */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(200px, auto);
    gap: var(--bento-gap);
  }

  /* ── SIZE VARIANTS ── */
  .bento-card--small  { grid-column: span 1; grid-row: span 1; }
  .bento-card--medium { grid-column: span 1; grid-row: span 2; }
  .bento-card--wide   { grid-column: span 2; grid-row: span 1; }
  .bento-card--large  { grid-column: span 2; grid-row: span 2; }

  /* ── BASE CARD ── */
  .bento-card {
    position: relative;
    background: var(--bento-card-bg);
    border-radius: var(--bento-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* Entrance animation */
    animation: bento-fade-up .5s cubic-bezier(.22,.68,0,1.2) both;
    animation-delay: calc(var(--card-index, 1) * 60ms);
    /* Subtle border */
    box-shadow:
      0 0 0 1px rgba(0,0,0,.06),
      0 2px 8px rgba(0,0,0,.04);
    transition: transform .25s cubic-bezier(.22,.68,0,1.2),
                box-shadow .25s ease;
  }

  @keyframes bento-fade-up {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .bento-card:hover {
    transform: translateY(-3px);
    box-shadow:
      0 0 0 1px rgba(0,0,0,.08),
      0 12px 32px rgba(0,0,0,.1);
  }

  /* ── IMAGE ── */
  .bento-card__image {
    overflow: hidden;
    flex-shrink: 0;
  }

  .bento-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s cubic-bezier(.22,.68,0,1.2);
  }

  .bento-card:hover .bento-card__image img {
    transform: scale(1.05);
  }

  .bento-card--small .bento-card__image,
  .bento-card--wide .bento-card__image {
    max-height: 200px;
  }

  .bento-card--medium .bento-card__image,
  .bento-card--large .bento-card__image {
    flex: 1;
    min-height: 180px;
  }

  /* ── STYLE: text-only ── */
  .bento-card--text-only {
    background: linear-gradient(135deg, var(--bento-card-bg) 0%, color-mix(in srgb, var(--bento-accent, #0ea5e9) 8%, var(--bento-card-bg)) 100%);
  }

  .bento-card--text-only .bento-card__content {
    justify-content: center;
    flex: 1;
    padding: 3.2rem 2.4rem;
    text-align: center;
  }

  .bento-card--text-only .bento-card__title {
    font-size: clamp(2rem, 2.5vw, 2.6rem);
  }

  /* ── STYLE: image-bottom ── */
  .bento-card--image-bottom .bento-card__image {
    order: 2;
    margin-top: auto;
  }

  /* ── STYLE: image-bg ── */
  .bento-card--image-bg {
    color: #fff;
  }

  .bento-card--image-bg .bento-card__image {
    position: absolute;
    inset: 0;
    z-index: 0;
    max-height: none;
  }

  .bento-card--image-bg .bento-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Gradient overlay — dark at bottom for legibility */
  .bento-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,.08) 0%,
      rgba(0,0,0,.18) 40%,
      rgba(0,0,0,.72) 100%
    );
    pointer-events: none;
  }

  .bento-card--image-bg .bento-card__content {
    position: relative;
    z-index: 2;
    margin-top: auto;
    /* Glassmorphism pill */
    background: rgba(255,255,255,.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255,255,255,.18);
    color: #fff;
  }

  .bento-card--image-bg .bento-card__tag {
    color: rgba(255,255,255,.85);
  }

  .bento-card--image-bg .bento-card__title,
  .bento-card--image-bg .bento-card__desc {
    color: #fff;
  }

  .bento-card--image-bg .bento-card__desc {
    opacity: .8;
  }

  /* ── CONTENT AREA ── */
  .bento-card__content {
    padding: 2rem 2.2rem;
    display: flex;
    flex-direction: column;
    gap: .6rem;
    color: var(--bento-text);
  }

  /* ── TAG ── */
  .bento-card__tag {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--bento-accent, var(--primary-color));
    margin-bottom: .2rem;
  }

  .bento-tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
    animation: bento-dot-pulse 2s ease-in-out infinite;
  }

  @keyframes bento-dot-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: .5; transform: scale(.7); }
  }

  /* ── TITLE ── */
  .bento-card__title {
    font-size: clamp(1.5rem, 1.8vw, 1.9rem);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: var(--bento-text);
    letter-spacing: -.02em;
  }

  /* ── DESCRIPTION ── */
  .bento-card__desc {
    font-size: 1.35rem;
    line-height: 1.55;
    margin: .2rem 0 0;
    opacity: .65;
    color: var(--bento-text);
  }

  /* ── BADGES ── */
  .bento-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    margin-top: 1rem;
  }

  .bento-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bento-badge-bg);
    color: var(--bento-badge-text);
    border-radius: 50px;
    padding: .5rem 1.4rem;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -.01em;
    line-height: 1;
  }

  /* ── ARROW BUTTON ── */
  .bento-card__link {
    position: absolute;
    bottom: 1.4rem;
    right: 1.4rem;
    text-decoration: none;
    z-index: 3;
  }

  .bento-card__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: rgba(255,255,255,.18);
    border: 1px solid rgba(255,255,255,.3);
    color: var(--bento-text);
    backdrop-filter: blur(6px);
    transition: background .2s ease, transform .2s ease, border-color .2s ease;
  }

  .bento-card--image-bg .bento-card__arrow {
    color: #fff;
    background: rgba(255,255,255,.2);
    border-color: rgba(255,255,255,.35);
  }

  .bento-card__link:hover .bento-card__arrow {
    background: var(--bento-accent, var(--primary-color));
    border-color: var(--bento-accent, var(--primary-color));
    color: #fff;
    transform: scale(1.1);
  }

  /* ── RESPONSIVE ── */
  @media screen and (max-width: 960px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .bento-card--large,
    .bento-card--wide { grid-column: span 2; }
  }

  @media screen and (max-width: 600px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .bento-card--small,
    .bento-card--medium,
    .bento-card--wide,
    .bento-card--large {
      grid-column: span 1;
      grid-row: span 1;
    }
    .bento-card--text-only .bento-card__content {
      padding: 2.4rem 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Bento Grid",
  "tag": "section",
  "class": "bento-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "placeholder": "e.g. Why choose us"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "placeholder": "e.g. Built for performance"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "min": 800,
      "max": 1600,
      "step": 20,
      "default": 1200
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid gap (px)",
      "min": 4,
      "max": 32,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card border radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / tag color",
      "default": "#0ea5e9"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#ccf2e4"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#0a7a50"
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "header",
          "content": "Card size"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "small",  "label": "Small (1×1)" },
            { "value": "medium", "label": "Medium tall (1×2)" },
            { "value": "wide",   "label": "Wide (2×1)" },
            { "value": "large",  "label": "Large (2×2)" }
          ],
          "default": "small"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Card style",
          "options": [
            { "value": "default",      "label": "Default (image top)" },
            { "value": "text-only",    "label": "Text only" },
            { "value": "image-bottom", "label": "Image bottom" },
            { "value": "image-bg",     "label": "Full image background" }
          ],
          "default": "default"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag / eyebrow text",
          "placeholder": "e.g. New"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "placeholder": "e.g. 4K/60fps HDR True Vertical Shooting"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description (optional)"
        },
        {
          "type": "text",
          "id": "badge_1",
          "label": "Badge 1 (optional)",
          "placeholder": "e.g. 34-min"
        },
        {
          "type": "text",
          "id": "badge_2",
          "label": "Badge 2 (optional)",
          "placeholder": "e.g. 45-min"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bento Grid",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "size": "small",
            "style": "text-only",
            "title": "Under 249 g"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "size": "medium",
            "style": "default",
            "title": "4K/60fps HDR True Vertical Shooting"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "size": "small",
            "style": "default",
            "title": "Omnidirectional Obstacle Sensing"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "size": "small",
            "style": "text-only",
            "title": "Extended Battery Life",
            "badge_1": "34-min",
            "badge_2": "45-min"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "size": "small",
            "style": "default",
            "title": "20km FHD Video Transmission"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "size": "small",
            "style": "image-bg",
            "title": "ActiveTrack 360°"
          }
        }
      ]
    }
  ]
}
{% endschema %}
