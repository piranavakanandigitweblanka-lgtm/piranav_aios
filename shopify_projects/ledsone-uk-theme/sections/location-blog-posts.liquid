{{ 'blog-template.css' | asset_url | stylesheet_tag }}
{{ 'blog-item.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign st = section.settings
  assign container = st.container
  assign heading = st.heading
  assign description = st.description
  assign text_align = st.text_align
  assign column_gap = st.column_gap
  assign item_desktop = st.item_desktop
  assign show_author = st.show_author
  assign show_category = st.show_category
  assign show_date = st.show_date
  assign show_excerpt = st.show_excerpt
  assign show_readmore = st.show_readmore
  assign hover_effect = st.hover_effect
  assign aspect_ratio = st.aspect_ratio
  assign custom_ratio = st.custom_ratio
  assign bg_color = st.background_color
  assign enabled_animations = settings.animations_enabled

  assign selected_posts = page.metafields.custom.blog_posts.value

  assign has_bg = ''
  if bg_color != blank
    assign has_bg = ' has-bg'
  endif
-%}

{%- capture style -%}
  {%- if bg_color != blank -%}--section-bg-color: {{ bg_color }};{%- endif -%}
  --section-padding-top: {{ st.padding_top }}px;
  --section-padding-bottom: {{ st.padding_bottom }}px;
  --bls-gutter-x: {{ column_gap }}px;
{%- endcapture -%}

{%- if selected_posts != blank -%}
<section
  class="bls__section bls__blog-posts{{ has_bg }}"
  id="{{ section.id }}"
  data-id="{{ section.id }}"
  data-type="bls_swiper"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ container }}">

    {%- if heading != blank or description != blank -%}
      <div class="bls__section-header {{ text_align }} {% if enabled_animations %}scroll-trigger animate--slide-in{% endif %}">
        {%- if heading != blank -%}
          <h2 class="bls__section-heading mb-5">{{ heading }}</h2>
        {%- endif -%}
        {%- if description != blank -%}
          <div class="bls__section-des">{{ description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bls__blog-posts-main">
      <div
        class="swiper bls__swiper hover__show-nav"
        id="bls__swiper-{{ section.id }}"
        data-section-id="{{ section.id }}"
        data-autoplay="false"
        data-loop="false"
        data-mobile="1"
        data-tablet="2"
        data-desktop="{{ item_desktop }}"
        data-spacing="{{ column_gap }}"
      >
        <div class="swiper-wrapper" style="--perload-gap: {{ column_gap }}px">
          {%- for article in selected_posts -%}
            <div class="swiper-slide {% if enabled_animations %}scroll-trigger animate--slide-in{% endif %}"
              {% if enabled_animations %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {%- render 'article-card',
                article: article,
                show_category: show_category,
                show_date: show_date,
                show_excerpt: show_excerpt,
                show_readmore: show_readmore,
                show_author: show_author,
                aspect_ratio: aspect_ratio,
                custom_ratio: custom_ratio,
                hover_effect: hover_effect
              -%}
            </div>
          {%- endfor -%}
        </div>
        {%- render 'swiper-control',
          show_bullet: false,
          show_arrow: true,
          show_bullet_mobile: false
        -%}
      </div>
    </div>

  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Location blog posts",
  "tag": "section",
  "class": "section-location-blog-posts",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Articles"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p></p>"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "text-center",
      "options": [
        { "value": "text-left", "label": "Left" },
        { "value": "text-center", "label": "Center" },
        { "value": "text-right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "container-fluid", "label": "Fluid" },
        { "value": "full-width", "label": "Full width" }
      ]
    },
    {
      "type": "range",
      "id": "item_desktop",
      "label": "Posts per row (desktop)",
      "default": 3,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "default": 30,
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Post settings"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "default": "16/9",
      "options": [
        { "value": "original", "label": "Original" },
        { "value": "16/9", "label": "16:9" },
        { "value": "4/3", "label": "4:3" },
        { "value": "3/4", "label": "3:4" },
        { "value": "1/1", "label": "1:1" },
        { "value": "custom", "label": "Custom" }
      ]
    },
    {
      "type": "text",
      "id": "custom_ratio",
      "label": "Custom ratio",
      "default": "21:9"
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover effect",
      "default": "zoom",
      "options": [
        { "value": "zoom", "label": "Zoom" },
        { "value": "translate-to-top", "label": "Translate up" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_readmore",
      "label": "Show read more",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px"
    }
  ]
}
{% endschema %}
