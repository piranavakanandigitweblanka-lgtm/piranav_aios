    <path d="M6.47907 11.3287C6.32583 11.3287 6.17886 11.2672 6.0705 11.1576C5.96214 11.048 5.90127 10.8994 5.90127 10.7444H4.74023C4.74023 10.9749 4.78514 11.2032 4.87238 11.4162C4.95962 11.6292 5.08748 11.8228 5.24868 11.9858C5.40988 12.1488 5.60125 12.2782 5.81186 12.3664C6.02248 12.4546 6.24822 12.5 6.47618 12.5C6.70415 12.5 6.92989 12.4546 7.1405 12.3664C7.35112 12.2782 7.54249 12.1488 7.70368 11.9858C7.86488 11.8228 7.99275 11.6292 8.07999 11.4162C8.16723 11.2032 8.21213 10.9749 8.21213 10.7444H7.05652C7.05652 10.8993 6.99569 11.0479 6.88741 11.1575C6.77913 11.267 6.63225 11.3286 6.47907 11.3287Z" fill="#111"/>
    <path d="M14.0173 1.66048C13.9858 1.65506 13.9539 1.65237 13.9219 1.65244H4.67702C4.52377 1.65244 4.37681 1.71401 4.26845 1.8236C4.16009 1.93319 4.09921 2.08182 4.09921 2.23681C4.09921 2.39179 4.16009 2.54042 4.26845 2.65001C4.37681 2.7596 4.52377 2.82117 4.67702 2.82117H13.2398L13.087 3.74811L12.277 8.66477H4.73949L2.77495 3.74811L1.60308 0.840914C1.54111 0.70415 1.42937 0.596826 1.29113 0.541284C1.15289 0.485742 0.998786 0.486261 0.860911 0.542733C0.723035 0.599206 0.612007 0.70728 0.550938 0.844458C0.489868 0.981637 0.483464 1.13735 0.533058 1.27918L2.40407 5.9223L3.68102 9.34519C3.77528 9.63335 3.96993 9.83349 4.25088 9.83349H12.7663C12.9031 9.83356 13.0355 9.78452 13.14 9.6951C13.2444 9.60568 13.314 9.48168 13.3365 9.34519L14.2589 3.74811L14.4921 2.33286C14.5173 2.18001 14.4814 2.02331 14.3924 1.89722C14.3033 1.77113 14.1684 1.68598 14.0173 1.66048Z" fill="#111"/>
  </symbol>
  <symbol id="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 6L9 17l-5-5"/>
  </symbol>
</svg>

<div class="section-{{ section.id }} section-collection-product" data-section-id="{{ section.id }}">
  <div class="{{ st.layout }}">
    <div class="custom-collection-filters">
      <div class="filter-controls">
        {% comment %} Size Filter {% endcomment %}
        <div class="filter-group size-filter-group" data-filter-label="{{ st.filter_1_label }}">
          <button class="filter-accordion-header" type="button" aria-expanded="false">
            <span>{{ st.filter_1_label }}</span>
            <span class="acc-right">
              <span class="acc-selected-label">All</span>
              <span class="acc-chevron">▼</span>
            </span>
          </button>
          <div class="filter-accordion-body">
          <div class="size-buttons">
            <button class="size-btn size-btn-all active" data-f1="">All {{ st.filter_1_label | split: ' ' | last }}</button>
            {%- liquid
              assign sizes_str = ""
              for product in collection.products limit: 1000
                if product.available
                  assign f1_meta = product.metafields[f1_ns][f1_key]
                  assign val = f1_meta.value
                  if val != blank
                    if f1_meta.type contains "list"
                      for s in val
                        assign s_clean = s | strip
                        assign s_check = "|" | append: s_clean | append: "|"
                        assign wrapped_sizes = "|" | append: sizes_str | append: "|"
                        unless wrapped_sizes contains s_check
                          if sizes_str == ""
                            assign sizes_str = s_clean
                          else
                            assign sizes_str = sizes_str | append: "|" | append: s_clean
                          endif
                        endunless
                      endfor
                    else
                      assign s_clean = val | strip
                      assign s_check = "|" | append: s_clean | append: "|"
                      assign wrapped_sizes = "|" | append: sizes_str | append: "|"
                      unless wrapped_sizes contains s_check
                        if sizes_str == ""
                          assign sizes_str = s_clean
                        else
                          assign sizes_str = sizes_str | append: "|" | append: s_clean
                        endif
                      endunless
                    endif
                  endif
                endif
              endfor
              assign sizes_array = sizes_str | split: "|" | sort
            -%}
            {% for size in sizes_array %}
              {% if size != blank %}
                <button class="size-btn" data-f1="{{ size }}">{{ size }}</button>
              {% endif %}
            {% endfor %}
          </div>
          </div>
        </div>

        {% comment %} Type Filter {% endcomment %}
        <div class="filter-group type-filter-group" data-filter-label="{{ st.filter_2_label }}">
          <button class="filter-accordion-header" type="button" aria-expanded="false">
            <span>{{ st.filter_2_label }}</span>
            <span class="acc-right">
              <span class="acc-selected-label">All</span>
              <span class="acc-chevron">▼</span>
            </span>
          </button>
          <div class="filter-accordion-body">
          <div class="type-buttons">
            <button class="type-btn type-btn-all active" data-f2="">All {{ st.filter_2_label | split: ' ' | last }}</button>
            {%- liquid
              assign types_str = ""
              for product in collection.products limit: 1000
                if product.available
                  assign f2_meta = product.metafields[f2_ns][f2_key]
                  assign val = f2_meta.value
                  if val != blank
                    if f2_meta.type contains "list"
                      for t in val
                        assign t_clean = t | strip
                        assign t_check = "|" | append: t_clean | append: "|"
                        assign wrapped_types = "|" | append: types_str | append: "|"
                        unless wrapped_types contains t_check
                          if types_str == ""
                            assign types_str = t_clean
                          else
                            assign types_str = types_str | append: "|" | append: t_clean
                          endif
                        endunless
                      endfor
                    else
                      assign t_clean = val | strip
                      assign t_check = "|" | append: t_clean | append: "|"
                      assign wrapped_types = "|" | append: types_str | append: "|"
                      unless wrapped_types contains t_check
                        if types_str == ""
                          assign types_str = t_clean
                        else
                          assign types_str = types_str | append: "|" | append: t_clean
                        endif
                      endunless
                    endif
                  endif
                endif
              endfor
              assign types_array = types_str | split: "|" | sort
            -%}
            {% for type in types_array %}
              {% if type != blank %}
                <button class="type-btn" data-f2="{{ type }}">{{ type }}</button>
              {% endif %}
            {% endfor %}
          </div>
          </div>
        </div>

        {% comment %} Finish / Colour Filter {% endcomment %}
        <div class="filter-group colour-filter-group" data-filter-label="{{ st.filter_3_label }}">
          <button class="filter-accordion-header" type="button" aria-expanded="false">
            <span>{{ st.filter_3_label }}</span>
            <span class="acc-right">
              <span class="acc-selected-label">All</span>
              <span class="acc-chevron">▼</span>
            </span>
          </button>
          <div class="filter-accordion-body">
          <div class="colour-buttons">
            <button class="colour-btn colour-btn-all active" data-f3="">All Finishes</button>
            {%- liquid
              assign colours_str = ""
              for product in collection.products limit: 1000
                for opt in product.options_with_values
                  if opt.name == f3_option_name
                    for v in opt.values
                      assign c_clean = v | strip
                      assign c_check = "|" | append: c_clean | append: "|"
                      assign wrapped_colours = "|" | append: colours_str | append: "|"
                      unless wrapped_colours contains c_check
                        if colours_str == ""
                          assign colours_str = c_clean
                        else
                          assign colours_str = colours_str | append: "|" | append: c_clean
                        endif
                      endunless
                    endfor
                  endif
                endfor
              endfor
              assign colours_array = colours_str | split: "|" | sort
            -%}
            {% for colour in colours_array %}
              {% if colour != blank %}
                <button class="colour-btn" data-f3="{{ colour | downcase | strip }}">{{ colour }}</button>
              {% endif %}
            {% endfor %}
          </div>
          </div>
        </div>

        {% comment %} Clear Button {% endcomment %}
        <button id="clear-filters" class="btn-clear-filters">Reset All Filters</button>
      </div>
    </div>

    <div id="productgridcontainer" class="flex-1">
      <div class="product-grid-container">
        <div id="bls__product-grid" 
             class="grid product-grid {{ product_style }} container-products-switch bls__grid row row-cols-2 row-cols-lg-{{ products_column }}"
             data-view-mode="{{ products_column }}">
          
          {%- for product in collection.products limit: products_limit -%}
            {%- liquid
              assign f1_obj = product.metafields[f1_ns][f1_key]
              assign card_f1 = f1_obj.value
              if f1_obj.type contains "list"
                assign card_f1 = card_f1 | join: ','
              endif
              
              assign f2_obj = product.metafields[f2_ns][f2_key]
              assign card_f2 = f2_obj.value
              if f2_obj.type contains "list"
                assign card_f2 = card_f2 | join: ','
              endif

              assign colour_index = nil
              for opt in product.options
                if opt == f3_option_name
                  assign colour_index = forloop.index0
                endif
              endfor
            -%}
            
            <div class="bls__grid__item product-card-wrapper is-default-product" 
                 data-f1="{{ card_f1 | downcase | strip }}"
                 data-f2="{{ card_f2 | downcase | strip }}"
                 data-available="{{ product.available }}">
              {%- render 'product-item', product: product -%}
            </div>

            {%- for variant in product.variants -%}
              {%- assign card_f3 = variant.options[colour_index] | default: '' | downcase | strip -%}
              <div class="bls__grid__item product-card-wrapper is-variant-card hidden"
                   data-f1="{{ card_f1 | downcase | strip }}"
                   data-f2="{{ card_f2 | downcase | strip }}"
                   data-f3="{{ card_f3 }}"
                   data-available="{{ variant.available }}">
                {%- render 'product-item', product: product, variant: variant -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}

          <div class="no-results" id="no-results" style="display: none;">
            <p>No products found matching the selected filters.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sizeButtons   = document.querySelectorAll('.size-btn');
    const typeButtons   = document.querySelectorAll('.type-btn');
    const colourButtons = document.querySelectorAll('.colour-btn');
    const clearBtn  = document.getElementById('clear-filters');
    const noResults = document.getElementById('no-results');

    let selectedSize   = '';
    let selectedType   = '';
    let selectedColour = '';

    function filterProducts() {
      const productCards = document.querySelectorAll('.product-card-wrapper');
      let visibleCount = 0;

      const availableF1 = new Set();
      const availableF2 = new Set();
      const availableF3 = new Set();

      const isFilterActive = selectedSize !== '' || selectedType !== '' || selectedColour !== '';
      const grid = document.getElementById('bls__product-grid');

      if (isFilterActive) {
        grid.classList.add('filters-active');
      } else {
        grid.classList.remove('filters-active');
      }

      productCards.forEach(card => {
        const f1Attr = (card.dataset.f1 || '').toLowerCase();
        const f2Attr = (card.dataset.f2 || '').toLowerCase();
        const f3Attr = (card.dataset.f3 || '').toLowerCase();

        const cardF1s = f1Attr.split(',').map(s => s.trim()).filter(s => s !== '');
        const cardF2s = f2Attr.split(',').map(t => t.trim()).filter(t => t !== '');
        const cardF3s = f3Attr !== '' ? [f3Attr] : [];

        let isVisible = true;

        if (isFilterActive) {
          if (card.classList.contains('is-default-product')) {
            isVisible = false;
          } else {
            if (card.dataset.available === 'false') {
              isVisible = false;
            }
            if (isVisible && selectedSize) {
              if (!cardF1s.includes(selectedSize.toLowerCase())) {
                isVisible = false;
              }
            }
            if (isVisible && selectedType) {
              if (!cardF2s.includes(selectedType.toLowerCase())) {
                isVisible = false;
              }
            }
            if (isVisible && selectedColour) {
              if (!cardF3s.includes(selectedColour.toLowerCase())) {
                isVisible = false;
              }
            }
          }
        } else {
          if (card.classList.contains('is-variant-card')) {
            isVisible = false;
          }
        }

        if (isVisible) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }

        // Dynamic facets — only available variant cards contribute
        // Each filter's available values are derived from cards matching the OTHER two filters
        if (card.classList.contains('is-variant-card') && card.dataset.available !== 'false') {
          // F1 available: cards matching current Type AND Colour
          let matchesF2F3 = true;
          if (selectedType   && !cardF2s.includes(selectedType.toLowerCase()))   matchesF2F3 = false;
          if (selectedColour && !cardF3s.includes(selectedColour.toLowerCase())) matchesF2F3 = false;
          if (matchesF2F3) cardF1s.forEach(s => availableF1.add(s));

          // F2 available: cards matching current Size AND Colour
          let matchesF1F3 = true;
          if (selectedSize   && !cardF1s.includes(selectedSize.toLowerCase()))   matchesF1F3 = false;
          if (selectedColour && !cardF3s.includes(selectedColour.toLowerCase())) matchesF1F3 = false;
          if (matchesF1F3) cardF2s.forEach(t => availableF2.add(t));

          // F3 available: cards matching current Size AND Type
          let matchesF1F2 = true;
          if (selectedSize && !cardF1s.includes(selectedSize.toLowerCase())) matchesF1F2 = false;
          if (selectedType && !cardF2s.includes(selectedType.toLowerCase())) matchesF1F2 = false;
          if (matchesF1F2) cardF3s.forEach(c => availableF3.add(c));
        }
      });

      // Update F1 button visibility
      sizeButtons.forEach(btn => {
        const v = (btn.dataset.f1 || '').toLowerCase();
        btn.style.display = (v === '' || availableF1.has(v)) ? '' : 'none';
      });

      // Update F2 button visibility
      typeButtons.forEach(btn => {
        const v = (btn.dataset.f2 || '').toLowerCase();
        btn.style.display = (v === '' || availableF2.has(v)) ? '' : 'none';
      });

      // Update F3 button visibility
      colourButtons.forEach(btn => {
        const v = (btn.dataset.f3 || '').toLowerCase();
        btn.style.display = (v === '' || availableF3.has(v)) ? '' : 'none';
      });

      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    function updateSizeButtons(activeSize) {
      sizeButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.f1 === activeSize));
    }

    function updateTypeButtons(activeType) {
      typeButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.f2 === activeType));
    }

    function updateColourButtons(activeColour) {
      colourButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.f3 === activeColour));
    }

    sizeButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        selectedSize = this.dataset.f1;
        updateSizeButtons(selectedSize);
        filterProducts();
      });
    });

    typeButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        selectedType = this.dataset.f2;
        updateTypeButtons(selectedType);
        filterProducts();
      });
    });

    colourButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        selectedColour = this.dataset.f3;
        updateColourButtons(selectedColour);
        filterProducts();
      });
    });

    clearBtn.addEventListener('click', function() {
      selectedSize   = '';
      selectedType   = '';
      selectedColour = '';
      updateSizeButtons('');
      updateTypeButtons('');
      updateColourButtons('');
      filterProducts();
    });

    // Initial run to hide variant cards on load
    filterProducts();

    // Mobile accordion — only active below 768px
    // Reads the filter name from data-filter-label on each group
    // Updates the summary label (acc-selected-label) when a filter value is selected
    function initMobileAccordion() {
      const groups = document.querySelectorAll('.filter-group');

      groups.forEach(function(group) {
        const header = group.querySelector('.filter-accordion-header');
        if (!header) return;

        header.addEventListener('click', function() {
          const isOpen = group.classList.contains('acc-open');
          // Close all, open clicked
          groups.forEach(function(g) {
            g.classList.remove('acc-open');
            const h = g.querySelector('.filter-accordion-header');
            if (h) h.setAttribute('aria-expanded', 'false');
          });
          if (!isOpen) {
            group.classList.add('acc-open');
            header.setAttribute('aria-expanded', 'true');
          }
        });
      });

      // Update the summary label shown beside chevron when a filter button is clicked
      function updateAccSummary(group, value) {
        const lbl = group.querySelector('.acc-selected-label');
        if (!lbl) return;
        lbl.textContent = value || 'All';
      }

      sizeButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          const group = this.closest('.filter-group');
          updateAccSummary(group, this.dataset.f1 || '');
        });
      });

      typeButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          const group = this.closest('.filter-group');
          updateAccSummary(group, this.dataset.f2 || '');
        });
      });

      colourButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          const group = this.closest('.filter-group');
          updateAccSummary(group, this.dataset.f3 || '');
        });
      });

      // Reset clears all summaries
      clearBtn.addEventListener('click', function() {
        groups.forEach(function(group) {
          updateAccSummary(group, '');
        });
      });
    }

    initMobileAccordion();
  });
</script>

{% schema %}
{
  "name": "Collection with Filters",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "container-fluid", "label": "Fluid container" },
        { "value": "full-width", "label": "Full width" }
      ]
    },
    {
      "type": "range",
      "id": "products_column",
      "label": "Items per row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 100,
      "step": 1,
      "label": "Max Products to Show",
      "default": 24
    },
    {
      "type": "header",
      "content": "Filter 1 Settings"
    },
    {
      "type": "text",
      "id": "filter_1_label",
      "label": "Filter 1 Label",
      "default": "Select Diameter"
    },
    {
      "type": "text",
      "id": "filter_1_metafield",
      "label": "Filter 1 Metafield (namespace.key)",
      "default": "custom.size"
    },
    {
      "type": "header",
      "content": "Filter 2 Settings"
    },
    {
      "type": "text",
      "id": "filter_2_label",
      "label": "Filter 2 Label",
      "default": "Select Type"
    },
    {
      "type": "text",
      "id": "filter_2_metafield",
      "label": "Filter 2 Metafield (namespace.key)",
      "default": "custom.core"
    },
    {
      "type": "header",
      "content": "Filter 3 Settings"
    },
    {
      "type": "text",
      "id": "filter_3_label",
      "label": "Filter 3 Label",
      "default": "FINISH / COLOUR",
      "info": "Filter 3 reads from the variant option name set in Theme Settings > Product > Option name > Color."
    }
  ],
  "presets": [
    {
      "name": "Collection with Filters"
    }
  ]
}
{% endschema %}
