{{ 'product.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign th_st = settings
  assign product_style = th_st.product_style
  assign st = section.settings
  assign products_column = st.products_column
  assign products_limit = st.products_limit

  assign f1_parts = st.filter_1_metafield | split: '.'
  assign f1_ns = f1_parts[0] | strip
  assign f1_key = f1_parts[1] | strip
  
  assign f2_parts = st.filter_2_metafield | split: '.'
  assign f2_ns = f2_parts[0] | strip
  assign f2_key = f2_parts[1] | strip

  assign f3_option_name = settings.option_name_color | default: 'Colour'
-%}

<style>
  .custom-collection-filters {
    padding: 12px 16px;
    background: #f9f9f9;
    border-radius: 12px;
    margin-bottom: 20px;
    border: 1px solid #eee;
  }
  .filter-controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 100%;
  }
  .size-buttons, .type-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .size-btn, .type-btn {
    padding: 5px 14px;
    border: 1px solid #ddd;
    background: #fff;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.25s ease;
    color: #444;
  }
  .size-btn:hover, .type-btn:hover {
    border-color: #111;
    color: #111;
    background: #f0f0f0;
  }
  .size-btn.active, .type-btn.active {
    background: #111;
    color: #fff;
    border-color: #111;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }
  .btn-clear-filters {
    padding: 7px 18px;
    background: #fff;
    color: #111;
    border: 1px solid #111;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .btn-clear-filters:hover {
    background: #111;
    color: #fff;
  }
  .product-card-wrapper.hidden {
    display: none;
  }
  .no-results {
    text-align: center;
    padding: 60px 20px;
    background: #fff;
    border: 1px dashed #ccc;
    border-radius: 12px;
    width: 100%;
    grid-column: 1 / -1;
  }

  .variant-title-suffix {
    display: none;
  }
  .filters-active .variant-title-suffix {
    display: inline;
  }
  .filters-active div.variant-title-suffix {
    display: block;
  }

  .colour-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .colour-btn {
    padding: 5px 14px;
    border: 1px solid #ddd;
    background: #fff;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.25s ease;
    color: #444;
  }
  .colour-btn:hover {
    border-color: #111;
    color: #111;
    background: #f0f0f0;
  }
  .colour-btn.active {
    background: #111;
    color: #fff;
    border-color: #111;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }
  /* Mobile accordion */
  .filter-accordion-header {
    display: none;
  }
  @media (max-width: 767px) {
    .filter-controls {
      gap: 0;
    }
    .filter-group {
      gap: 0;
      border-bottom: 1px solid #e5e5e5;
    }
    .filter-accordion-header,
    .filter-accordion-header:hover,
    .filter-accordion-header:focus,
    .filter-accordion-header:focus-visible,
    .filter-accordion-header:active {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 4px;
      cursor: pointer;
      user-select: none;
      font-weight: 700;
      font-size: 13px;
      text-transform: uppercase;
      color: #111;
      letter-spacing: 0.5px;
      background: #fff;
      border: none;
      outline: none;
      box-shadow: none;
      width: 100%;
      text-align: left;
      -webkit-tap-highlight-color: transparent;
    }
    .filter-accordion-header:focus-visible {
      outline: 2px solid #bbb;
      outline-offset: -2px;
    }
    .filter-accordion-header .acc-right {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 500;
      color: #555;
      white-space: nowrap;
    }
    .filter-accordion-header .acc-chevron {
      display: inline-block;
      font-style: normal;
      font-size: 10px;
      transition: transform 0.2s ease;
      color: #555;
    }
    .filter-group.acc-open .filter-accordion-header,
    .filter-group.acc-open .filter-accordion-header:hover,
    .filter-group.acc-open .filter-accordion-header:focus,
    .filter-group.acc-open .filter-accordion-header:active {
      background: #fff;
      color: #111;
      border-color: #e5e5e5;
    }
    .filter-group.acc-open .filter-accordion-header .acc-right,
    .filter-group.acc-open .filter-accordion-header .acc-chevron {
      color: #111;
    }
    .filter-group.acc-open .filter-accordion-header .acc-chevron {
      transform: rotate(180deg);
    }
    .filter-accordion-body {
      display: none;
      padding: 8px 4px 12px;
    }
    .filter-group.acc-open .filter-accordion-body {
      display: block;
    }
    .size-buttons, .type-buttons, .colour-buttons {
      gap: 6px;
    }
    .size-btn, .type-btn, .colour-btn {
      padding: 5px 12px;
      font-size: 12px;
    }
    .btn-clear-filters {
      margin-top: 10px;
      width: 100%;
    }
  }
  /* stock icons — moved from product-item.liquid, emitted once */
  .product-stock {
    display: flex;
    align-items: center;
    margin-top: 5px;
    font-size: 14px;
    font-weight: 500;
  }
  .product-stock .in-stock {
    color: #166534;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .product-stock .check-icon {
    width: 16px;
    height: 16px;
  }
  .product-stock .out-of-stock {
    color: #e74c3c;
    font-weight: bold;
  }
  .product-stock .partial-stock {
    color: #92400e;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  /* Task 6 — swatch overflow count chip */
  .bls__swatch-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 24px;
    min-width: 24px;
    padding: 0 4px;
    border-radius: 50%;
    border: 1px solid #ddd;
    font-size: 11px;
    color: #555;
    background: #f5f5f5;
    cursor: default;
  }
  /* Task 6 card-alignment fix v2 — equal-height rows + swatches pinned to bottom */

  /* Step 1: row stretches all grid items to the tallest card height in the row */
  #bls__product-grid {
    align-items: stretch;
  }

  /* Step 2: grid item stretches explicitly (redundant but forces specificity) */
  #bls__product-grid > .bls__grid__item {
    align-self: stretch;
    display: flex;
    flex-direction: column;
  }

  /* Step 3: card fills the stretched grid item via height:100%
     (flex:1 alone fails here because the grid-item has no explicitly declared height;
      height:100% references the used/stretched height from the parent row) */
  #bls__product-grid > .bls__grid__item > .bls__product-item {
    height: 100%;
  }

  /* Step 4: details area fills remaining card height after the image */
  #bls__product-grid .bls__product-item > .bls__product-details {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  /* Step 5: swatches pinned to bottom of details column;
     !important overrides the mt-4 utility class on the swatch wrapper */
  #bls__product-grid .bls__product-option.option_color {
    margin-top: auto !important;
  }
</style>

