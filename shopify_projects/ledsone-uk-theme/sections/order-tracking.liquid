<section class="ot-section">
  <div class="ot-container">

    <!-- Compact single-row bar -->
    <div class="ot-bar">

      <!-- Delivery estimate -->
      <div class="ot-delivery">
        <svg class="ot-truck" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
        <div class="ot-delivery-text">
          <span class="ot-delivery-label">Receive by</span>
          <span class="ot-date-range">
            <strong id="deliveryDateMin">--</strong>
            <span>&ndash;</span>
            <strong id="deliveryDateMax">--</strong>
          </span>
          <span class="ot-badge">3–5 days</span>
          <span class="ot-express">Need it faster? <strong>Express Delivery</strong> &mdash; <strong>next day</strong> available.</span>
        </div>
        <a href="https://ledsone.co.uk/pages/delivery-information" class="ot-delivery-link" target="_blank" rel="noopener">Delivery info</a>
      </div>

      <div class="ot-divider"></div>

      <!-- Tracking input -->
      <div class="ot-track">
        <div class="ot-input-group">
          <input
            type="text"
            id="trackingNumber"
            class="ot-input"
            placeholder="Enter tracking number"
            autocomplete="off"
          />
          <button class="ot-btn" onclick="trackOrder()">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            Track
          </button>
        </div>
        <p class="ot-note">Tracking number is in your dispatch email &middot;
          <span class="ot-carriers">Royal Mail &middot; Evri &middot; DPD &middot; SmartTrack</span>
        </p>
      </div>

    </div>
  </div>
</section>

<style>
.ot-section {
  font-family: 'GeneralSans', sans-serif;
  padding: 16px 0;
}

.ot-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Single compact bar */
.ot-bar {
  display: flex;
  align-items: center;
  gap: 0;
  background: #f1f5f6;
  border: 1px solid #e5e8ec;
  border-radius: 5px;
  padding: 12px 20px;
  flex-wrap: wrap;
}

/* LEFT: delivery */
.ot-delivery {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.ot-truck {
  color: #012f6d;
  flex-shrink: 0;
}

.ot-delivery-text {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.ot-delivery-label {
  font-size: 12px;
  font-weight: 500;
  color: #555555;
  white-space: nowrap;
}

.ot-date-range {
  display: flex;
  align-items: center;
  gap: 3px;
  font-size: 13px;
  font-weight: 600;
  color: #012f6d;
}

.ot-badge {
  font-size: 11px;
  font-weight: 500;
  background: #012f6d;
  color: #ffffff;
  padding: 2px 10px;
  border-radius: 30px;
  white-space: nowrap;
}

.ot-express {
  font-size: 11px;
  font-weight: 500;
  color: #555555;
  white-space: nowrap;
}

.ot-express strong {
  color: #012f6d;
}

.ot-delivery-link {
  font-size: 12px;
  font-weight: 500;
  color: #012f6d;
  text-decoration: underline;
  text-underline-offset: 2px;
  white-space: nowrap;
  flex-shrink: 0;
}

.ot-delivery-link:hover { color: #364a9b; }

/* Divider */
.ot-divider {
  width: 1px;
  height: 36px;
  background: #e5e8ec;
  margin: 0 20px;
  flex-shrink: 0;
}

/* RIGHT: tracking */
.ot-track {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.ot-input-group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.ot-input {
  flex: 1;
  min-width: 0;
  padding: 8px 12px;
  font-size: 13px;
  font-family: 'GeneralSans', sans-serif;
  font-weight: 500;
  color: #111111;
  background: #ffffff;
  border: 1px solid #e5e8ec;
  border-radius: 5px;
  outline: none;
  transition: border-color 0.2s;
  box-sizing: border-box;
}

.ot-input:focus { border-color: #012f6d; }
.ot-input::placeholder { color: #aaaaaa; }

.ot-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 8px 18px;
  font-size: 13px;
  font-family: 'GeneralSans', sans-serif;
  font-weight: 500;
  background: #012f6d;
  color: #ffffff;
  border: none;
  border-radius: 30px;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background 0.2s;
}

.ot-btn:hover { background: #364a9b; }

.ot-note {
  font-size: 11px;
  font-weight: 500;
  color: #888888;
  margin: 0;
  line-height: 1.4;
}

.ot-carriers {
  color: #aaaaaa;
}

/* Mobile */
@media (max-width: 768px) {
  .ot-bar {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
  }

  .ot-divider {
    width: 100%;
    height: 1px;
    margin: 0;
  }

  .ot-track {
    width: 100%;
  }

  .ot-delivery-link {
    display: none;
  }
}
</style>

<script>
function trackOrder() {
  var trackingNo = document.getElementById("trackingNumber").value.trim();

  if (!trackingNo) {
    alert("Please enter a tracking number");
    return;
  }

  var url = "";

  // 1. SmartTrack — most specific: UK + exactly 10 digits
  if (/^UK\d{10}$/i.test(trackingNo)) {
    url = "https://www.smarttrack.co/tracking.php?tracking_number=" + trackingNo;
  }
  // 2. Royal Mail — ends with GB (e.g. AB123456789GB)
  else if (trackingNo.toUpperCase().endsWith("GB")) {
    url = "https://www.royalmail.com/track-your-item#/tracking-results/" + trackingNo;
  }
  // 3. Evri — starts with H, T, or G followed by alphanumeric
  else if (/^[HTG]\w+/i.test(trackingNo)) {
    url = "https://www.evri.com/track/parcel/" + trackingNo;
  }
  // 4. DPD — 12–14 digit numeric, or starts with 1550
  else if (/^\d{12,14}$/.test(trackingNo) || trackingNo.startsWith("1550")) {
    url = "https://www.dpd.co.uk/service/tracking?parcel=" + trackingNo;
  }
  // 5. Royal Mail fallback — long alphanumeric (18–30 chars) not caught above
  else if (/^[A-Z0-9]{18,30}$/i.test(trackingNo)) {
    url = "https://www.royalmail.com/track-your-item#/tracking-results/" + trackingNo;
  }
  else {
    alert("Carrier not recognised. Please check your tracking number.");
    return;
  }

  window.open(url, "_blank");
}

document.addEventListener("DOMContentLoaded", function () {
  var minDays = 3;
  var maxDays = 5;
  var today = new Date();

  var minDate = new Date(today);
  minDate.setDate(today.getDate() + minDays);

  var maxDate = new Date(today);
  maxDate.setDate(today.getDate() + maxDays);

  var options = { day: 'numeric', month: 'long' };

  document.getElementById("deliveryDateMin").innerText = minDate.toLocaleDateString('en-GB', options);
  document.getElementById("deliveryDateMax").innerText = maxDate.toLocaleDateString('en-GB', options);
});
</script>

{% schema %}
{
  "name": "Order Tracking",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Track Your Order"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Sub text",
      "default": "Enter your tracking number to see delivery updates"
    }
  ],
  "presets": [
    {
      "name": "Order Tracking"
    }
  ]
}
{% endschema %}
