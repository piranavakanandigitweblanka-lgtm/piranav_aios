<section class="piranav-promo">
  <div class="pp-container">

    <!-- Header -->
    <div class="pp-header">
      <h2 class="pp-title">{{ section.settings.heading }}</h2>
      <span class="pp-line"></span>
      <p class="pp-subtitle">{{ section.settings.subheading }}</p>
    </div>

    <!-- Slim Timer Bar -->
    {% if section.settings.show_timer %}
      <div class="pp-timer">
        <div class="pp-timer-left">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span class="pp-timer-label">Ends in</span>
          <div class="pp-units">
            <span class="pp-unit"><strong id="t-hours">23</strong><em>h</em></span>
            <span class="pp-sep">:</span>
            <span class="pp-unit"><strong id="t-mins">59</strong><em>m</em></span>
            <span class="pp-sep">:</span>
            <span class="pp-unit"><strong id="t-secs">59</strong><em>s</em></span>
          </div>
        </div>
        <div class="pp-timer-right">
          <span class="pp-trust-chip">Free delivery over £25</span>
          <span class="pp-trust-chip">30-day returns</span>
        </div>
        <div class="pp-timer-track"><div id="timer-bar-fill"></div></div>
      </div>
    {% endif %}

    {% if section.settings.collection %}
      {% assign coll = collections[section.settings.collection] %}
      {% if coll and coll.products.size > 0 %}

        {% assign per_day = 5 %}
        {% assign day_num = 'now' | date: '%j' | plus: 0 %}
        {% assign total_sets = coll.products.size | plus: per_day | minus: 1 | divided_by: per_day %}
        {% assign offset_num = day_num | modulo: total_sets | times: per_day %}

        <!-- Desktop grid -->
        <div class="pp-grid desktop-view">
          {% for product in coll.products limit: per_day offset: offset_num %}
            {% assign variant = product.selected_or_first_available_variant %}
            {% assign price = variant.price %}
            {% assign compare_at_price = variant.compare_at_price %}
            {% assign discount = 0 %}
            {% if compare_at_price and compare_at_price > price %}
              {% assign discount = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round %}
            {% endif %}

            <div class="pp-card">
              <a href="{{ product.url }}" class="pp-img-wrap">
                <img
                  src="{{ product.featured_image | img_url: '400x533', crop: 'center' }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy" width="400" height="533"
                >
                {% if section.settings.banner_line1 != blank %}
                  <span class="pp-label">{{ section.settings.banner_line1 }}</span>
                {% endif %}
                {% if discount > 0 %}
                  <span class="pp-badge">-{{ discount }}%</span>
                {% endif %}
              </a>
              <div class="pp-info">
                <a href="{{ product.url }}" class="pp-name">{{ product.title }}</a>
                <div class="pp-price-row">
                  {% if discount > 0 %}
                    <span class="pp-price pp-price--sale">{{ price | money }}</span>
                    <span class="pp-price pp-price--compare">{{ compare_at_price | money }}</span>
                  {% else %}
                    <span class="pp-price">{{ price | money }}</span>
                  {% endif %}
                </div>
                <a href="{{ product.url }}" class="pp-btn">Shop Now</a>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Mobile swiper -->
        <div class="pp-swiper mobile-view">
          <div class="swiper-container">
            <div class="swiper-wrapper">
              {% for product in coll.products limit: per_day offset: offset_num %}
                {% assign variant = product.selected_or_first_available_variant %}
                {% assign price = variant.price %}
                {% assign compare_at_price = variant.compare_at_price %}
                {% assign discount = 0 %}
                {% if compare_at_price and compare_at_price > price %}
                  {% assign discount = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round %}
                {% endif %}

                <div class="swiper-slide">
                  <div class="pp-card">
                    <a href="{{ product.url }}" class="pp-img-wrap">
                      <img
                        src="{{ product.featured_image | img_url: '400x533', crop: 'center' }}"
                        alt="{{ product.title | escape }}"
                        loading="lazy" width="400" height="533"
                      >
                      {% if discount > 0 %}
                        <span class="pp-badge">-{{ discount }}%</span>
                      {% endif %}
                    </a>
                    <div class="pp-info">
                      <a href="{{ product.url }}" class="pp-name">{{ product.title }}</a>
                      <div class="pp-price-row">
                        {% if discount > 0 %}
                          <span class="pp-price pp-price--sale">{{ price | money }}</span>
                          <span class="pp-price pp-price--compare">{{ compare_at_price | money }}</span>
                        {% else %}
                          <span class="pp-price">{{ price | money }}</span>
                        {% endif %}
                      </div>
                      <a href="{{ product.url }}" class="pp-btn">Shop Now</a>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
            <div class="swiper-pagination"></div>
            <div class="swiper-button-next">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div class="swiper-button-prev">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div class="pp-progress"><div class="pp-progress-bar"></div></div>
          </div>
        </div>

      {% endif %}
    {% endif %}

  </div>
</section>

<style>
.pp-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
  font-family: 'GeneralSans', sans-serif;
}

/* Header — same pattern as wholesale-trendy-discovery */
.pp-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}
.pp-title {
  font-size: clamp(16px, 2vw, 20px);
  font-weight: 600;
  color: #111111;
  white-space: nowrap;
  margin: 0;
}
.pp-line { flex: 1; height: 1px; background: #e5e8ec; }
.pp-subtitle {
  font-size: 13px;
  font-weight: 500;
  color: #555555;
  white-space: nowrap;
  margin: 0;
}

/* Timer — light bar, same style as order-tracking */
.pp-timer {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f1f5f6;
  border: 1px solid #e5e8ec;
  border-radius: 5px;
  padding: 0 16px;
  height: 44px;
  margin-bottom: 14px;
  gap: 12px;
  overflow: hidden;
}
.pp-timer-left {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}
.pp-timer-left svg { color: #012f6d; flex-shrink: 0; }
.pp-timer-label {
  font-size: 12px;
  font-weight: 500;
  color: #555555;
  white-space: nowrap;
}
.pp-units {
  display: flex;
  align-items: center;
  gap: 2px;
}
.pp-unit {
  display: inline-flex;
  align-items: baseline;
  gap: 1px;
}
.pp-unit strong {
  font-size: 15px;
  font-weight: 700;
  color: #012f6d;
  min-width: 20px;
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.pp-unit em {
  font-size: 11px;
  font-weight: 500;
  color: #555555;
  font-style: normal;
}
.pp-sep {
  font-size: 13px;
  font-weight: 600;
  color: #aaaaaa;
  margin: 0 2px;
}
.pp-timer-right {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}
.pp-trust-chip {
  font-size: 11px;
  font-weight: 500;
  color: #555555;
  background: #ffffff;
  border: 1px solid #e5e8ec;
  border-radius: 30px;
  padding: 2px 10px;
  white-space: nowrap;
}
.pp-timer-track {
  position: absolute;
  bottom: 0; left: 0;
  width: 100%; height: 2px;
  background: #e5e8ec;
}
#timer-bar-fill {
  height: 100%; width: 0%;
  background: #012f6d;
  transition: width 1s linear;
}

/* Grid — 5 col, 1:1 square images matching theme */
.pp-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10px;
}

/* Card — light, matches theme product card weight */
.pp-card {
  background: #ffffff;
  border-radius: 5px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.pp-card:hover .pp-img-wrap img { transform: scale(1.04); }

/* Image — 1:1 square to match theme */
.pp-img-wrap {
  position: relative;
  display: block;
  aspect-ratio: 1 / 1;
  background: #f1f5f6;
  overflow: hidden;
  flex-shrink: 0;
}
.pp-img-wrap img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
}

/* Promo label — top-left thin pill */
.pp-label {
  position: absolute;
  top: 8px; left: 8px;
  background: #012f6d;
  color: #ffffff;
  font-size: 10px;
  font-weight: 600;
  padding: 2px 9px;
  border-radius: 30px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  z-index: 2;
}

/* Discount badge — top-right thin pill */
.pp-badge {
  position: absolute;
  top: 8px; right: 8px;
  background: #ffffff;
  color: #012f6d;
  font-size: 11px;
  font-weight: 700;
  padding: 2px 9px;
  border-radius: 30px;
  border: 1px solid #e5e8ec;
  z-index: 2;
}

/* Card info */
.pp-info {
  padding: 8px 10px 10px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  flex: 1;
}
.pp-name {
  font-size: 13px;
  font-weight: 500;
  color: #111111;
  text-decoration: none;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}
.pp-name:hover { color: #012f6d; }

.pp-price-row {
  display: flex;
  align-items: center;
  gap: 5px;
}
.pp-price { font-size: 14px; font-weight: 600; color: #111111; }
.pp-price--sale { color: #012f6d; }
.pp-price--compare {
  font-size: 12px;
  font-weight: 500;
  color: #aaaaaa;
  text-decoration: line-through;
}

.pp-btn {
  display: block;
  text-align: center;
  background: #012f6d;
  color: #ffffff;
  font-size: 13px;
  font-weight: 500;
  font-family: 'GeneralSans', sans-serif;
  padding: 7px 0;
  border-radius: 30px;
  text-decoration: none;
  margin-top: auto;
  transition: background 0.2s;
}
.pp-btn:hover { background: #364a9b; color: #ffffff; }

/* Mobile swiper */
.mobile-view { display: none; }
.pp-swiper { width: 100%; position: relative; }
.pp-swiper .swiper-container {
  width: 100%;
  padding: 4px 0 38px;
  overflow: hidden;
}
.pp-swiper .swiper-slide {
  height: auto;
  padding: 0 5px;
  -webkit-tap-highlight-color: transparent;
}

/* Pagination */
.pp-swiper .swiper-pagination {
  position: absolute;
  bottom: 12px; left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 5px;
  z-index: 10;
}
.pp-swiper .swiper-pagination-bullet {
  width: 24px !important; height: 24px !important;
  background: transparent !important;
  opacity: 1; position: relative; cursor: pointer;
}
.pp-swiper .swiper-pagination-bullet::before {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 6px; height: 6px;
  border-radius: 6px;
  background: #cccccc;
  transition: all 0.22s ease;
}
.pp-swiper .swiper-pagination-bullet-active::before {
  background: #012f6d; width: 18px;
}

/* Nav arrows */
.pp-swiper .swiper-button-next,
.pp-swiper .swiper-button-prev {
  color: #012f6d;
  background: white;
  width: 30px; height: 30px;
  border-radius: 50%;
  border: 1px solid #e5e8ec;
  display: flex;
  align-items: center;
  justify-content: center;
  top: 38%; transform: translateY(-50%);
  margin-top: 0;
  transition: background 0.2s, color 0.2s;
}
.pp-swiper .swiper-button-next:hover,
.pp-swiper .swiper-button-prev:hover { background: #012f6d; color: white; }
.pp-swiper .swiper-button-next:after,
.pp-swiper .swiper-button-prev:after { display: none; }
.pp-swiper .swiper-button-next { right: 2px; }
.pp-swiper .swiper-button-prev { left: 2px; }

/* Progress */
.pp-progress {
  position: absolute;
  bottom: 0; left: 0;
  width: 100%; height: 2px;
  background: #e5e8ec;
}
.pp-progress-bar {
  height: 100%; width: 0%;
  background: #012f6d;
  transition: width 0.3s ease;
}

/* Responsive */
@media (max-width: 1100px) {
  .pp-grid { grid-template-columns: repeat(3, 1fr); }
  .pp-timer-right { display: none; }
}

@media (max-width: 768px) {
  .desktop-view { display: none; }
  .mobile-view { display: block; }
  .pp-subtitle { display: none; }
  .pp-timer { height: 40px; padding: 0 12px; }
  .pp-unit strong { font-size: 13px; }
}

@media (max-width: 480px) {
  .pp-swiper .swiper-button-next,
  .pp-swiper .swiper-button-prev { display: none; }
  .pp-swiper .swiper-container { padding: 4px 0 34px; }
}

.pp-swiper .swiper-slide { animation: ppFadeIn 0.3s ease; }
@keyframes ppFadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}
.pp-card, .pp-swiper .swiper-slide { user-select: none; }
</style>

<script>
function promoTimer() {
  if (!document.getElementById("timer-bar-fill")) return;

  function tick() {
    const now = new Date();
    const midnight = new Date();
    midnight.setHours(24,0,0,0);

    const diff = midnight - now;
    if (diff <= 0) location.reload();

    let h = Math.floor(diff / (1000*60*60));
    let m = Math.floor((diff % (1000*60*60)) / (1000*60));
    let s = Math.floor((diff % (1000*60)) / 1000);

    document.getElementById("t-hours").textContent = h < 10 ? "0"+h : h;
    document.getElementById("t-mins").textContent = m < 10 ? "0"+m : m;
    document.getElementById("t-secs").textContent = s < 10 ? "0"+s : s;

    const total = 24*60*60*1000;
    const used = total - diff;
    const percent = (used / total) * 100;

    document.getElementById("timer-bar-fill").style.width = percent + "%";
  }

  tick();
  setInterval(tick, 1000);
}

function initSwiper() {
  if (typeof Swiper === 'undefined') {
    return;
  }
  
  const container = document.querySelector('.pp-swiper .swiper-container');
  if (!container) return;

  if (window.matchMedia('(max-width: 768px)').matches) {
    if (!window.promoSwiper) {
      window.promoSwiper = new Swiper(container, {
        slidesPerView: 1,
        spaceBetween: 12,
        centeredSlides: false,
        loop: false,
        speed: 400,
        grabCursor: true,
        observer: true,
        observeParents: true,
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
          dynamicBullets: true,
        },
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        breakpoints: {
          480: {
            slidesPerView: 1.05,
            spaceBetween: 14
          },
          400: {
            slidesPerView: 1.03,
            spaceBetween: 12
          },
          360: {
            slidesPerView: 1,
            spaceBetween: 10
          }
        },
        on: {
          init: function() {
            updateProgressBar(this);
          },
          slideChange: function() {
            updateProgressBar(this);
          }
        }
      });
    }
  } else {
    if (window.promoSwiper) {
      window.promoSwiper.destroy(true, true);
      window.promoSwiper = null;
    }
  }
}

function updateProgressBar(swiper) {
  const progressBar = document.querySelector('.pp-progress-bar');
  if (progressBar) {
    const progress = (swiper.activeIndex + 1) / swiper.slides.length * 100;
    progressBar.style.width = progress + '%';
  }
}

document.addEventListener("DOMContentLoaded", function() {
  promoTimer();
  
  const section = document.querySelector('.pp-swiper');
  if (section) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          initSwiper();
          observer.unobserve(section);
        }
      });
    }, { rootMargin: '100px' });
    observer.observe(section);
  }

  window.addEventListener('resize', initSwiper);
  document.addEventListener('touchstart', function() {}, {passive: true});
});
</script>

{% schema %}
{
  "name": "Piranav Promo Section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Daily Promotion" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Fresh Offers Every 24 Hours" },

    { "type": "checkbox", "id": "show_timer", "label": "Show Timer Card", "default": true },

    { "type": "collection", "id": "collection", "label": "Choose Collection" },

    { "type": "text", "id": "banner_line1", "label": "Banner Line 1", "default": "BLACK FRIDAY" },
    { "type": "text", "id": "banner_line2", "label": "Banner Line 2", "default": "WEEKEND SALE" },
    { "type": "text", "id": "banner_subtitle", "label": "Banner Subtitle", "default": "Limited Time Deal" }
  ],
  "presets": [
    { "name": "Piranav Promo Section", "category": "Promotional" }
  ]
}
{% endschema %}