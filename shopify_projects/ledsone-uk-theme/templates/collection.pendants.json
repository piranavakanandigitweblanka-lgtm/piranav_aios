necap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"><\/rect><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1\n  2 2v1\"><\/path><\/svg>\n        <span class=\"pb-tooltip\" id=\"pb-tooltip\">Copied!<\/span>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <style>\n  * { box-sizing: border-box; }\n\n  .pb-wrap {\n    width: 100%;\n    padding: 0 20px;\n  }\n\n  .pb-banner {\n    font-family: 'GeneralSans', 'Jost', sans-serif;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 16px;\n    padding: 16px 24px;\n    border-radius: 5px;\n    background: #e8edf7;\n    border: 1px solid #c5d3ed;\n    width: 100%;\n  }\n\n  .pb-text {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    flex: 1;\n  }\n\n  .pb-discount {\n    font-size: 18px;\n    font-weight: 700;\n    color: #012f6d;\n    line-height: 1.2;\n  }\n\n  .pb-offer {\n    font-size: 13px;\n    font-weight: 500;\n    color: #364a9b;\n    margin-top: 3px;\n  }\n\n  .pb-code {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    background: #012f6d;\n    color: #ffffff;\n    padding: 10px 22px;\n    border-radius: 30px;\n    cursor: pointer;\n    font-family: 'GeneralSans', 'Jost', sans-serif;\n    font-size: 14px;\n    font-weight: 600;\n    position: relative;\n    transition: background-color 0.2s;\n    user-select: none;\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n\n  .pb-code:hover { background: #364a9b; }\n  .pb-code:active { transform: scale(0.98); }\n\n  .pb-code-label {\n    opacity: 0.85;\n    font-weight: 500;\n  }\n\n  .pb-code-value {\n    font-weight: 700;\n    letter-spacing: 0.06em;\n  }\n\n  .pb-tooltip {\n    position: absolute;\n    bottom: calc(100% + 8px);\n    left: 50%;\n    transform: translateX(-50%) translateY(4px);\n    background: #012f6d;\n    color: #ffffff;\n    font-size: 12px;\n    font-weight: 600;\n    padding: 6px 12px;\n    border-radius: 5px;\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 0.2s ease, transform 0.2s ease;\n    white-space: nowrap;\n    z-index: 10;\n  }\n\n  .pb-tooltip::after {\n    content: '';\n    position: absolute;\n    top: 100%;\n    left: 50%;\n    transform: translateX(-50%);\n    border-left: 6px solid transparent;\n    border-right: 6px solid transparent;\n    border-top: 6px solid #012f6d;\n  }\n\n  .pb-tooltip.visible {\n    opacity: 1;\n    transform: translateX(-50%) translateY(0);\n  }\n\n  \/* ── TABLET ── *\/\n  @media (max-width: 768px) {\n    .pb-wrap { padding: 0 16px; }\n    .pb-banner { padding: 14px 18px; gap: 14px; }\n    .pb-discount { font-size: 16px; }\n    .pb-code { padding: 9px 18px; font-size: 13px; }\n  }\n\n   \/* ── MOBILE ── *\/\n  @media (max-width: 600px) {\n    .pb-wrap { padding: 0 12px; }\n\n    .pb-banner {\n      flex-direction: row;\n      align-items: center;\n      justify-content: space-between;\n      padding: 10px 14px;\n      gap: 10px;\n    }\n\n    .pb-text {\n      align-items: flex-start;\n      flex: 1;\n      min-width: 0;\n    }\n\n    .pb-discount {\n      font-size: 13px;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    .pb-offer {\n      font-size: 11px;\n      margin-top: 2px;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    .pb-code {\n      flex-shrink: 0;\n      padding: 7px 12px;\n      font-size: 12px;\n      gap: 5px;\n      border-radius: 30px;\n    }\n\n    .pb-code-label { display: none; }\n\n    .pb-tooltip {\n      bottom: calc(100% + 8px);\n      top: auto;\n    }\n  }\n\n  \/* ── SMALL MOBILE ── *\/\n  @media (max-width: 380px) {\n    .pb-wrap { padding: 0 8px; }\n    .pb-banner { padding: 8px 12px; }\n    .pb-discount { font-size: 12px; }\n    .pb-offer { font-size: 11px; }\n    .pb-code { padding: 6px 10px; font-size: 11px; }\n  }\n  <\/style>\n\n  <script>\n  (function () {\n    var btn     = document.getElementById('pb-copy-btn');\n    var tooltip = document.getElementById('pb-tooltip');\n    var resetTimer = null;\n\n    function doCopy() {\n      var code = btn.querySelector('.pb-code-value').innerText.trim();\n      navigator.clipboard.writeText(code).then(showCopied).catch(function () {\n        var ta = document.createElement('textarea');\n        ta.value = code;\n        ta.style.cssText = 'position:fixed;opacity:0;';\n        document.body.appendChild(ta);\n        ta.select();\n        document.execCommand('copy');\n        document.body.removeChild(ta);\n        showCopied();\n      });\n    }\n\n    function showCopied() {\n      tooltip.classList.add('visible');\n      clearTimeout(resetTimer);\n      resetTimer = setTimeout(function () {\n        tooltip.classList.remove('visible');\n      }, 2000);\n    }\n\n    btn.addEventListener('click', doCopy);\n    btn.addEventListener('keydown', function (e) {\n      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); doCopy(); }\n    });\n  })();\n  <\/script>","padding_top":0,"padding_bottom":0,"reset_spacing":false}},"8498460c-0376-40d1-bafc-199edbe0edfc":{"type":"collection-list","blocks":{"616f3472-abe6-41ef-8d49-4e190d1fc5cc":{"type":"collection_item","settings":{"title_collection":"Multi Outlet Pendant","collection":"spider-light","image":"shopify:\/\/shop_images\/pendant_light_spider.jpg"}},"36a53b4a-830c-4660-a410-d73343bf9d7d":{"type":"collection_item","settings":{"title_collection":"Pendant Holder","collection":"pendant-holder","image":"shopify:\/\/shop_images\/1128.jpg"}},"981b08cc-5195-40cd-b5f4-79c51acd6dbb":{"type":"collection_item","settings":{"title_collection":"Hemp Lighting","collection":"hemp-rope-lighting","image":"shopify:\/\/shop_images\/Hemprope.jpg"}},"template--16567751475447__8498460c-0376-40d1-bafc-199edbe0edfc-16665857567f9937b1-3":{"type":"collection_item","settings":{"title_collection":"Cage pendant light","colle