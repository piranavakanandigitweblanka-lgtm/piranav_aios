    55599867068802,55606987555202,55766021603714,55766021669250,55766021734786,
    55766021800322,55766021833090,55766021865858,55766021898626,55766021931394,
    55766497296770,55766497329538,55767137190274,55767178543490,55767538434434,
    55767598072194,55782020481410,55782020678018,55782020710786,55785829466498,
    55785829499266,55794628133250,55795335528834,55795335561602,55795335594370,
    55795377144194,55806921277826,55806961582466,55806961615234,55806961713538,
