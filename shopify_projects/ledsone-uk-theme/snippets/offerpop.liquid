<!-- SPICELY COLLECTION — BUY 2 GET 15% TOAST POPUPS -->
<!-- Pop 1: Buy 2 alert (1 qualifying item in cart) -->
<div id="spicely-pop1" class="spicely-toast pop1">
  <div class="toast-inner">
    <button class="toast-close" aria-label="Close">&times;</button>
    <div class="toast-icon-wrap">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#012f6d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    </div>
    <div class="toast-body">
      <p class="toast-title">Add One More to Save!</p>
      <p class="toast-message">Buy 2 items and get <strong>15% off</strong> both.</p>
    </div>
  </div>
  <div class="toast-progress"></div>
</div>

<!-- Pop 2: Eligible discount (2+ qualifying items in cart) -->
<div id="spicely-pop2" class="spicely-toast pop2">
  <div class="toast-inner">
    <button class="toast-close" aria-label="Close">&times;</button>
    <div class="toast-icon-wrap">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#012f6d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    </div>
    <div class="toast-body">
      <p class="toast-title">You qualify for 15% off!</p>
      <p class="toast-discount">Save 15%</p>
      <p class="toast-message">Click below to copy your discount code.</p>
      <div class="toast-code" id="spicely-copy-btn" title="Click to copy">
        <span class="code-label">Use Code</span>
        <span class="code-value">B2P10</span>
        <span class="copy-icon" id="spicely-copy-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </span>
      </div>
    </div>
  </div>
  <div class="toast-progress"></div>
</div>

<style>
  .spicely-toast {
    font-family: 'GeneralSans', 'Jost', sans-serif;
    position: fixed;
    top: 50%;
    right: 24px;
    transform: translateY(-50%) translateX(calc(100% + 40px));
    width: 300px;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(1, 47, 109, 0.15), 0 1px 4px rgba(1, 47, 109, 0.08);
    z-index: 9999;
    overflow: hidden;
    opacity: 0;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.35s ease;
    pointer-events: none;
    background: #ffffff;
    border: 1px solid #e5e8ec;
  }

  .spicely-toast.pop2 {
    border-color: #012f6d;
  }

  .spicely-toast.is-open {
    transform: translateY(-50%) translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  .toast-inner {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 16px 14px 16px;
    position: relative;
  }

  .toast-close {
    position: absolute;
    top: 10px;
    right: 12px;
    background: none;
    border: none;
    color: #aaa;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    padding: 2px 5px;
    border-radius: 4px;
    transition: color 0.2s, background 0.2s;
  }

  .toast-close:hover {
    color: #012f6d;
    background: #e8edf7;
  }

  .toast-icon-wrap {
    flex-shrink: 0;
    margin-top: 2px;
    background: #e8edf7;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toast-body {
    flex: 1;
    padding-right: 18px;
  }

  .toast-title {
    font-size: 14px;
    font-weight: 700;
    color: #012f6d;
    margin: 0 0 4px 0;
  }

  .toast-discount {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    color: #ffffff;
    background: #012f6d;
    padding: 2px 8px;
    border-radius: 3px;
    margin: 0 0 6px 0;
    letter-spacing: 0.02em;
  }

  .toast-message {
    font-size: 13px;
    color: #555;
    margin: 0 0 10px 0;
    line-height: 1.45;
  }

  .toast-message strong {
    color: #012f6d;
  }

  .pop1 .toast-message {
    margin-bottom: 0;
  }

  /* Copy code block */
  .toast-code {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #e8edf7;
    border: 1px solid #012f6d;
    border-radius: 5px;
    padding: 5px 10px;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    user-select: none;
  }

  .toast-code:hover {
    background: #c5d3ed;
  }

  .toast-code:active {
    transform: scale(0.97);
  }

  .code-label {
    font-size: 11px;
    color: #364a9b;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    transition: color 0.2s;
  }

  .code-value {
    font-size: 13px;
    font-weight: 700;
    color: #012f6d;
    letter-spacing: 0.06em;
  }

  .copy-icon {
    color: #012f6d;
    display: flex;
    align-items: center;
  }

  .toast-code.copied .code-label {
    color: #012f6d;
  }

  .toast-code.copied .code-value::after {
    content: ' ✓';
  }

  /* Progress bar */
  .toast-progress {
    height: 3px;
    width: 100%;
    transform-origin: left;
    transform: scaleX(0);
    background: #012f6d;
    transition: none;
  }

  .spicely-toast.is-open .toast-progress {
    transform: scaleX(1);
    transition: transform 6s linear;
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  var QUALIFYING_VARIANT_IDS = new Set([
    55623289504130,55623289536898,55627041702274,55627041735042,55627359158658,
