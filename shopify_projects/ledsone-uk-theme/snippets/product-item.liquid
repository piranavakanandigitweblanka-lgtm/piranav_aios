{%- liquid
  assign current_variant = variant | default: product.selected_or_first_available_variant
  assign sold_out = false
  assign th_st = settings
  assign option_name = "Color"
  if th_st.option_name_color != blank
    assign option_name = th_st.option_name_color
  endif
  assign color_swatches_style = th_st.color_swatches_style
  assign color_type = th_st.swatch_type
  assign show_quick_view = th_st.show_quick_view
  assign show_add_to_cart = th_st.show_add_to_cart
  assign show_wishlist = th_st.show_wishlist
  assign show_compare = th_st.show_compare
  assign show_review = th_st.show_review
  assign show_product_type = th_st.show_product_type
  assign enable_hover_image = th_st.enable_hover_image
  assign show_action = true
  if show_add_to_cart != true and show_compare != true and show_wishlist != true and show_quick_view != true
    assign show_action = false
  endif
  assign show_product_action_on_mobile = th_st.show_product_action_on_mobile
  assign product_style = th_st.product_style
  assign product_name_t_transfrom = th_st.product_name_t_transfrom
  assign product_name_line = th_st.product_name_line
  assign enable_sale_label = th_st.enable_sale_label
  assign enable_sold_out = th_st.enable_sold_out
  assign enable_preorder = th_st.enable_preorder
  assign product_label_style = th_st.product_label_style
assign enable_catalog_mode = th_st.enable_catalog_mode
  assign compare_at_price = current_variant.compare_at_price | default: product.compare_at_price_max
  assign price = current_variant.price | default: product.price_min
  assign sale = false
  if compare_at_price > price and compare_at_price != blank
    assign sale = true
  endif
  assign product_avail = false
  assign product_qty = 0
  assign pre_order = false
  if product.has_only_default_variant == false

    if product.options_with_values[0].name == option_name
      if product.options_with_values.size < 2
        for variant in product.variants limit: 1
          assign product_qty = product_qty | plus: variant.inventory_quantity
          assign product_avail = variant.available
          assign product_management = variant.inventory_management
          assign compare_at_price = variant.compare_at_price
          assign price = variant.price
        endfor
        if product_management != null
          if product_qty < 1
            if product_avail == true
              assign pre_order = true
              assign sold_out = false
            else
              assign pre_order = false
              assign sold_out = true
            endif
          else
            assign pre_order = false
            assign sold_out = false
          endif
        else
          assign pre_order = false
          assign sold_out = false
        endif
      else
        assign prod = product.variants | where: 'option1', product.options_with_values[0].values[0]
        assign product_management = 'shopify'
        for p in prod
          assign product_qty = product_qty | plus: p.inventory_quantity
          if p.available
            assign product_avail = true
          endif
          if p.inventory_management == null
            assign product_management = 'null'
          endif
        endfor
        assign compare_at_price = prod[0].compare_at_price
        assign price = prod[0].price
        if product_management != null
          if product_qty < 1
            if product_avail == true
              assign pre_order = true
              assign sold_out = false
            else
              assign pre_order = false
              assign sold_out = true
            endif
          else
            assign pre_order = false
            assign sold_out = false
          endif
        else
          assign pre_order = false
          assign sold_out = false
        endif
      endif
    else
      assign product_management = 'shopify'
      for variant in product.variants
        assign product_qty = product_qty | plus: variant.inventory_quantity
        if variant.available == true
          assign product_avail = true
        endif
        if variant.inventory_management == null
          assign product_management = 'null'
        endif
      endfor
      assign compare_at_price = product.variants[0].compare_at_price
      assign price = product.variants[0].price

      if product_management != "null"
        if product_qty < 1
          if product_avail == true
            assign pre_order = true
            assign sold_out = false
          else
            assign pre_order = false
            assign sold_out = true
          endif
        else
          assign pre_order = false
          assign sold_out = false
        endif
      else
        assign pre_order = false
        assign sold_out = false
      endif
    endif
  else
    if product.available != true
      assign sold_out = true
    endif
    assign qty = 0
    for v in product.variants
      if v.inventory_quantity
        assign qty = qty | plus: v.inventory_quantity
      endif
    endfor
    if qty < 1 and product.available == true
      assign pre_order = true
      assign sold_out = false
    endif
    for v in product.variants
      if v.inventory_management == null
        assign pre_order = false
        assign sold_out = false
      endif
    endfor
  endif

  if product.available == false
    assign sold_out = true
    assign pre_order = false
  else
    assign sold_out = false
    assign qty = 0
    assign has_untracked = false
    for v in product.variants
      if v.inventory_management == null
        assign has_untracked = true
      endif
      if v.inventory_quantity > 0
        assign qty = qty | plus: v.inventory_quantity
      endif
    endfor
    if qty < 1 and has_untracked == false
      assign pre_order = true
    else
      assign pre_order = false
    endif
  endif

  assign label = false
  if sold_out == true or sale == true or pre_order == true
    assign label = true
  endif

  assign d_none = ''
  if sold_out == true
    assign d_none = 'd-none'
  endif
  assign p = compare_at_price | minus: price
  if p > 0
    assign p = p | times: 100.0 | divided_by: compare_at_price | round
  endif
  if product == blank
    assign pre_order = false
    assign sold_out = false
  endif
  assign enabled_animations = th_st.animations_enabled
-%}
<div class="bls__product-item {% if enabled_animations %}scroll-trigger animate--slide-in{% endif %} {{ product_label_style }} {{ color_swatches_style }} {%- if show_product_action_on_mobile -%}show__action-mobile{%- endif -%}" data-product-handle="{{ product.handle }}"
  {% if enabled_animations %}
    data-cascade
    style="--animation-order: {{ forloop.index }};"
  {% endif %}
>
  <div class="bls__product-img overflow-hidden relative{% if enable_sale_label != true %} sale-off{% endif %}{% if enable_sold_out != true %} sold-out-off{% endif %}{% if enable_preorder != true %} pre-order-off{% endif %}">
    {%- if label -%}
      <div class="bls__product-label fs-12 pointer-events-none absolute">
        {%- if enable_sale_label and compare_at_price > price and compare_at_price != blank -%}
          <div class="bls__sale-label">
            -
            {{- p -}}
            %
          </div>
        {%- endif -%}
        {%- if enable_sold_out and sold_out -%}
          <div class="bls__sold-out-label">
            {{ 'products.product.sold_out' | t }}
          </div>
        {%- else -%}
          {%- if enable_preorder and pre_order -%}
            <div class="bls__pre-order-label">
              {{ 'products.product.pre_order' | t }}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- assign img = product.media -%}

    <a class="bls__img-url{% if enable_hover_image %} bls__hover-image{% endif %}" href="{{ current_variant.url | default: product.url | within: collection }}">
      <div class="bls__product-main-img">
        {%- if variant -%}
          {%- if variant.featured_image != blank -%}
            {%- render 'responsive-image', image: variant.featured_image, type: 'product', cls: 'bls__product-grid bls__product-img-sw', loading: loading -%}
          {%- elsif img[0] != blank -%}
            {%- render 'responsive-image', image: img[0], type: 'product', cls: 'bls__product-grid bls__product-img-sw', loading: loading -%}
          {%- else -%}
            {%- render 'responsive-image', type: 'product', cls: 'bls__product-grid-plh', loading: loading -%}
          {%- endif -%}
        {%- elsif product.has_only_default_variant -%}
          {%- if img[0] != blank -%}
            {%- render 'responsive-image', image: img[0], type: 'product', cls: 'bls__product-grid bls__product-img-sw', loading: loading -%}
          {%- else -%}
            {%- render 'responsive-image', type: 'product', cls: 'bls__product-grid-plh', loading: loading -%}
          {%- endif -%}
        {%- else -%}
        {%- assign hasColor = false -%}
        {%- for o in product.options_with_values -%}
          {%- if o == option_name -%}
            {%- assign hasColor = true -%}
          {%- endif -%}
        {%- endfor -%}
          {%- if hasColor -%}
            {%- for variant in product.variants limit: 1 -%}
              {%- if variant.featured_image != blank -%}
                {%- render 'responsive-image', image: variant.featured_image, type: 'product', cls: 'bls__product-grid bls__product-img-sw', loading: loading -%}
              {%- else -%}
                {%- if img[0] != blank -%}
                  {%- render 'responsive-image', image: img[0], type: 'product', cls: 'bls__product-grid bls__product-img-sw', loading: loading -%}
                {%- else -%}
                  {%- render 'responsive-image', type: 'product', cls: 'bls__product-grid-plh', loading: loading -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- if img[0] != blank -%}
              {%- render 'responsive-image', image: img[0], type: 'product', cls: 'bls__product-grid bls__product-img-sw', loading: loading -%}
            {%- else -%}
              {%- render 'responsive-image', type: 'product', cls: 'bls__product-grid-plh', loading: loading -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- if enable_hover_image -%}
        {%- if img[1] != blank -%}
          <div class="bls__product-hover-img opacity-0 absolute inset-0">
            {%- render 'responsive-image', image: img[1], type: 'product', cls: 'bls__product-grid' -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </a>

    {%- if show_action -%}
      {%- if product_style == 'bls__product-style-1' or product_style == 'bls__product-style-2' or product_style == 'bls__product-style-3' %}
        <div class="bls__product-action d-flex">
          {%- if show_wishlist or show_compare or show_quick_view -%}
            <div class="bls__product-action-inner flex">
              {%- if show_wishlist -%}
                <button
                  type="button"
                  name="add"
                  role="button"
                  aria-label="button"
                  class="btn-reset bls__product-wishlist bls__product-wishlist-js bls__product-action-btn-js bls_tooltip"
                  data-pro-add-wishlist="{{ 'products.product.wishlist' | t }}"
                  data-pro-remove-wishlist="{{ 'products.product.browse_wishlist' | t }}"
                  data-product-handle="{{ product.handle }}">
                  <span class="bls__product-icon">
                    <svg width="14" height="13" aria-hidden="true"><use href="#icon-wishlist"/></svg>
                  </span>
                  <span class="bls_tooltip-content">{{ 'products.product.wishlist' | t }}</span>
                </button>
              {%- endif -%}
              {%- if show_compare -%}
                <button
                  type="button"
                  name="add"
                  role="button"
                  aria-label="button"
                  class="btn-reset bls__product-compare bls__product-compare-js bls__product-action-btn-js bls_tooltip"
                  data-pro-add-compare="{{ 'products.product.compare' | t }}"
                  data-pro-remove-compare="{{ 'products.product.browse_compare' | t }}"
                  data-product-handle="{{ product.handle }}">
                  <span class="bls__product-icon">
                    <svg width="14" height="14" aria-hidden="true"><use href="#icon-compare"/></svg>
                  </span>
                  <span class="bls_tooltip-content">{{ 'products.product.compare' | t }}</span>
                </button>
              {%- endif -%}
              {%- if tpl == blank -%}
                {%- if show_quick_view -%}
                  <button
                    type="button"
                    name="add"
                    role="button"
                    aria-label="button"
                    class="btn-reset bls__product-quickview bls_tooltip"
                  data-variant-id="{{ current_variant.id }}">
                    <span class="bls__product-icon">
                      <svg width="14" height="12" aria-hidden="true"><use href="#icon-quickview"/></svg>
                    </span>
                    <span class="bls_tooltip-content">{{ 'products.product.quickview' | t }}</span>
                  </button>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if product.metafields.custom.external_affiliate == blank -%}
            {%- if show_add_to_cart and sold_out == false and tpl == blank and enable_catalog_mode == false -%}
              <div class="bls__product-addtocart bls__product-addtocart-js {{ d_none }}" data-product-variant-id="{{ current_variant.id }}">
                <button
                  class="bls__js-addtocart btn-secondary border-none button bls_tooltip button--full-width"
                  type="button"
                  name="add"
                  role="button"
                  aria-label="button">
                  <span class="bls__product-icon">
                    <svg width="15" height="13" aria-hidden="true"><use href="#icon-cart"/></svg>
                  </span>
                  {%- if pre_order -%}
                    <span class="bls_tooltip-content">{{ 'products.product.pre_order' | t }}</span>
                    <span class="add-cart bls__button-content hidden-loading">{{ 'products.product.pre_order' | t }}</span>
                  {%- else -%}
                    <span class="bls_tooltip-content">{{ 'products.product.add_to_cart' | t }}</span>
                    <span class="add-cart bls__button-content hidden-loading">
                      {{- 'products.product.add_to_cart' | t -}}
                    </span>
                  {%- endif -%}
                </button>
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- else -%}
        {%- if tpl == blank and show_quick_view -%}
          <div class="bls__product-action bls__quick-view-inner d-flex absolute">
            <div class="bls__product-action-inner flex">
              <button
                type="button"
                name="add"
                role="button"
                aria-label="button"
                class="btn-secondary bls__product-quickview bls_tooltip"
                data-variant-id="{{ current_variant.id }}">
                <span class="bls__product-icon origin-style">
                  {{ 'products.product.quickview' | t }}
                </span>
              </button>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="bls__product-details pt-15">
    {%- if th_st.show_vendors -%}
      <div class="bls__product-vendor fs-small mt-5 mb-5">
        {{ product.vendor | link_to_vendor }}
      </div>
    {%- endif -%}
    {% if variant %}
      <div class="bls__variant-name variant-title-suffix fs-12 uppercase grey-color mb-5" style="font-weight: 600; letter-spacing: 0.5px;">
        {{ variant.title }}
      </div>
    {% endif %}
    <h3 class="bls__product-name regular mb-0">
      <a
        class="limited-line {{ product_name_t_transfrom }}"
        style="--line-clamp: {{ product_name_line }}"
       href="{{ current_variant.url | default: product.url | within: collection }}">
        {{ product.title }}<span class="variant-title-suffix">{% if variant %} - {{ variant.title }}{% endif %}</span>
      </a>
    </h3>

    <!-- Start of Judge.me code -->
    <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'>
      {{ product.metafields.judgeme.badge }}
    </div>
    <!-- End of Judge.me code -->

    {%- if product_style == 'bls__product-style-4' %}
      <div class="price-review flex flex-wrap flex-end row-reverse">
      {%- endif -%}
      {%- if show_review -%}
        <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
      {%- endif -%}
      <div class="bls__product-price mb-4">
        {%- render 'price', product: product, variant: variant, use_variant: true, price_class: 'price--large' -%}
      </div>
      {% comment %} piranav add stock icon 2026/01/22 — partial-stock fix 2026-10-07 {% endcomment %}
      <div class="product-stock">
        {%- if variant != nil -%}
          {%- if variant.available -%}
            <span class="in-stock">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="check-icon" aria-hidden="true"><use href="#icon-check"/></svg>
              In Stock
            </span>
          {%- else -%}
            <span class="out-of-stock">Out of Stock</span>
          {%- endif -%}
        {%- else -%}
          {%- assign available_count = 0 -%}
          {%- for v in product.variants -%}
            {%- if v.available -%}{%- assign available_count = available_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          {%- if available_count == 0 -%}
            <span class="out-of-stock">Out of Stock</span>
          {%- elsif available_count < product.variants.size -%}
            <span class="partial-stock">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="check-icon" aria-hidden="true"><use href="#icon-check"/></svg>
              Some options sold out
            </span>
          {%- else -%}
            <span class="in-stock">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="check-icon" aria-hidden="true"><use href="#icon-check"/></svg>
              In Stock
            </span>
          {%- endif -%}
        {%- endif -%}
      </div>
      {% comment %} end stock {% endcomment %}
      {%- if product_style == 'bls__product-style-4' %}
      </div>
    {%- endif -%}
    {%- assign allow_swatches = false -%}
    {%- if th_st.enable_sw_only_product_detail == false or request.path == '/collections/conduit-lighting' -%}
      {%- assign allow_swatches = true -%}
    {%- endif -%}
    {%- if color_type != 'radio' and color_type != 'dropdown' and allow_swatches -%}
        {%- render 'product-color-swatches', product: product -%}
    {%- endif -%}
    {%- if show_action -%}
      {%- if product_style == 'bls__product-style-4' %}
        <div class="bls__product-action d-flex space-between border-top pt-10 mt-15">
          {%- if show_add_to_cart and sold_out == false and tpl == blank -%}
            <div class="bls__product-addtocart bls__product-addtocart-js {{ d_none }}" data-product-variant-id="{{ current_variant.id }}">
              <button
                class="bls__js-addtocart btn-secondary border-none button bls_tooltip button--full-width btn-reset"
                type="button"
                name="add"
                role="button"
                aria-label="button">
                <span class="icon-plus"></span>
                {%- if pre_order -%}
                  <span class="add-cart bls__button-content hidden-loading">{{ 'products.product.pre_order' | t }}</span>
                {%- else -%}
                  <span class="add-cart bls__button-content hidden-loading">
                    {{- 'products.product.add_to_cart' | t -}}
                  </span>
                {%- endif -%}
              </button>
            </div>
          {%- endif -%}
          {%- if show_wishlist or show_compare or show_quick_view -%}
            <div class="bls__product-action-inner flex">
              {%- if show_wishlist -%}
                <button
                  type="button"
                  name="add"
                  role="button"
                  aria-label="button"
                  class="btn-reset bls__product-wishlist bls__product-wishlist-js bls__product-action-btn-js bls_tooltip"
                  data-pro-add-wishlist="{{ 'products.product.wishlist' | t }}"
                  data-pro-remove-wishlist="{{ 'products.product.browse_wishlist' | t }}"
                  data-product-handle="{{ product.handle }}">
                  <span class="bls__product-icon origin-style">
                    <svg width="14" height="13" aria-hidden="true"><use href="#icon-wishlist"/></svg>
                  </span>
                  <span class="bls_tooltip-content">{{ 'products.product.wishlist' | t }}</span>
                </button>
              {%- endif -%}
              {%- if show_compare -%}
                <button
                  type="button"
                  name="add"
                  role="button"
                  aria-label="button"
                  class="btn-reset bls__product-compare bls__product-compare-js bls__product-action-btn-js bls_tooltip"
                  data-pro-add-compare="{{ 'products.product.compare' | t }}"
                  data-pro-remove-compare="{{ 'products.product.browse_compare' | t }}"
                  data-product-handle="{{ product.handle }}">
                  <span class="bls__product-icon origin-style">
                    <svg width="14" height="14" aria-hidden="true"><use href="#icon-compare"/></svg>
                  </span>
                  <span class="bls_tooltip-content">{{ 'products.product.compare' | t }}</span>
                </button>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
  {%- unless product.has_only_default_variant -%}
    {%- unless variant -%}
      <script type="application/json" class="productinfo">
        {{ product.variants | json }}
      </script>
      <script type="application/json" class="productVariantsQty">
        [
        {%- for variant in product.variants -%}
          {%- liquid
                assign id = '"id":' | append: variant.id
                assign option = '"option":"' | append: variant.option1 | append: '"'
                assign quantity = '"qty":' | append: variant.inventory_quantity
                assign available = '"available":' | append: variant.available
                assign mamagement = '"mamagement":"' | append: variant.inventory_management | append: '"'
            -%}
            { {{ id }},{{ option }},{{ quantity }},{{ available }},{{ mamagement }}}
          {%- unless forloop.last -%},{%- endunless forloop.last -%}
        {%- endfor -%}
        ]
      </script>
    {%- endunless -%}
  {%- endunless -%}
</div>
