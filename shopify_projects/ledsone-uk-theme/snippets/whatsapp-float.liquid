<style>
  .leds-wa-float {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .leds-wa-popup {
    width: 280px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.18);
    overflow: hidden;
    display: none;
    flex-direction: column;
    animation: ledsWaSlideUp 0.25s ease;
  }

  .leds-wa-popup.leds-wa-open {
    display: flex;
  }

  @keyframes ledsWaSlideUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .leds-wa-popup-header {
    background: #22994dff;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .leds-wa-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .leds-wa-avatar svg { display: block; }

  .leds-wa-header-info { flex: 1; }

  .leds-wa-header-name {
    font-weight: 700;
    font-size: 14px;
    color: #fff;
    margin: 0;
    line-height: 1.2;
  }

  .leds-wa-header-status {
    font-size: 11px;
    color: rgba(255,255,255,0.85);
    margin: 2px 0 0;
  }

  .leds-wa-close {
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(255,255,255,0.8);
    font-size: 20px;
    padding: 0;
    line-height: 1;
  }

  .leds-wa-popup-body {
    padding: 16px;
    background: #f0f4f8;
  }

  .leds-wa-bubble {
    background: #fff;
    border-radius: 0 12px 12px 12px;
    padding: 10px 14px;
    font-size: 13px;
    color: #333;
    box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    line-height: 1.5;
  }

  .leds-wa-popup-footer {
    padding: 12px 16px;
    background: #fff;
  }

  .leds-wa-start-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 11px 0;
    background: #16863fff;
    color: #fff;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: background 0.2s;
  }

  .leds-wa-start-btn:hover { background: #21954fff; color: #fff; }

  .leds-wa-btn {
    width: 56px;
    height: 56px;
    background: #24a352ff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(37,211,102,0.45);
    transition: transform 0.2s, box-shadow 0.2s;
    border: none;
    padding: 0;
  }

  .leds-wa-btn:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 20px rgba(37,211,102,0.55);
  }

  .leds-wa-btn-wrap {
    position: relative;
    display: inline-flex;
  }

  .leds-wa-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 14px;
    height: 14px;
    background: #ff4444;
    border-radius: 50%;
    border: 2px solid #fff;
  }

  @media (max-width: 768px) {
    .leds-wa-float {
      bottom: 80px;
      left: 16px;
    }
    .leds-wa-popup { width: calc(100vw - 32px); }
  }
</style>

<div class="leds-wa-float" id="ledsWaFloat">

