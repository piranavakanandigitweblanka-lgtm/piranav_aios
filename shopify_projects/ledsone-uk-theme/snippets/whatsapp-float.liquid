        </svg>
      </div>
      <div class="leds-wa-header-info">
        <p class="leds-wa-header-name">LEDSone Team</p>
        <p class="leds-wa-header-status">&#x2022; Typically replies within 24hrs<br>Text chat only Not call</p>
      </div>
