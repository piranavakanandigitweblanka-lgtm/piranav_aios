      </svg>
    </button>
    <span class="leds-wa-badge" id="ledsWaBadge" aria-hidden="true"></span>
  </div>

</div>

<script>
  (function () {
    var toggle = document.getElementById('ledsWaToggle');
    var popup  = document.getElementById('ledsWaPopup');
    var close  = document.getElementById('ledsWaClose');
    var badge  = document.getElementById('ledsWaBadge');

    function openPopup() {
      popup.classList.add('leds-wa-open');
      badge.style.display = 'none';
    }

    function closePopup() {
      popup.classList.remove('leds-wa-open');
    }

    toggle.addEventListener('click', function () {
      popup.classList.contains('leds-wa-open') ? closePopup() : openPopup();
    });

    close.addEventListener('click', closePopup);

    if (!sessionStorage.getItem('ledsWaShown')) {
      setTimeout(function () {
        openPopup();
        sessionStorage.setItem('ledsWaShown', '1');
      }, 6000);
    }
  })();
</script>
