<!-- Sitelinks Searchbox & Organization Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": "{{ shop.secure_url }}",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "{{ shop.secure_url }}/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
       "@type": ["Organization", "LocalBusiness"],
        "name": "LEDSone UK Ltd",
        "url": "{{ shop.url }}",
        "logo": "{{ settings.logo_image_desktop | image_url }}",
        "image": "{{ settings.logo_image_desktop | image_url }}",
        "description": {{ shop.description | json }},
        "telephone": "02477220687",
        "priceRange": "£",
        "foundingDate": "2015",
        "email": "sales@ledsone.co.uk",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Unit 3, Green Industrial Estate, Marshbrook Cl, Lythalls Ln",
          "addressLocality": "Coventry",
          "postalCode": "CV2 2NW",
          "addressCountry": "GB"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 52.4411116,
          "longitude": -1.4883333
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday"
            ],
            "opens": "08:00",
            "closes": "16:00"
          }
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "02477220687",
          "contactType": "customer service",
          "areaServed": "GB",
          "availableLanguage": "English"
        },
        "sameAs": [
          {{ settings.social_twitter_link | json }},
          {{ settings.social_facebook_link | json }},
          {{ settings.social_pinterest_link | json }},
          {{ settings.social_instagram_link | json }},
          {{ settings.social_tiktok_link | json }},
          {{ settings.social_tumblr_link | json }},
          {{ settings.social_snapchat_link | json }},
          {{ settings.social_youtube_link | json }},
          {{ settings.social_vimeo_link | json }}
        ]
      }
    </script>
