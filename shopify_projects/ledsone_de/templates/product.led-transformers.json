ue,"settings":{"field_type":"image","field_name":"Upload image"}},"f98b666a-7c37-41ed-be7b-4a28f4a1e8b4":{"type":"stock_countdown","disabled":true,"settings":{"message":"Hurry Up! Only [count] left in stock!","qty":100}},"7a9d9ec8-61e0-4f46-a64e-44ff2080906e":{"type":"product_group","settings":{}},"custom_html_hWL8LF":{"type":"custom_html","settings":{"content":"<style>\n\/* Buttons *\/\n.description-btn,\n.dropbtn {\n  color: #222;\n  background: linear-gradient(135deg, #d9f99d, #bef264);\n  border: none;\n  padding: 12px 18px;\n  font-size: 13px;\n  cursor: pointer;\n  border-radius: 8px;\n  font-weight: 600;\n  text-transform: uppercase;\n  transition: all 0.3s ease;\n  display: inline-block;\n  margin: 4px;\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);\n}\n\n.description-btn:hover,\n.dropbtn:hover {\n  background: linear-gradient(135deg, #bef264, #d9f99d);\n  color: #000;\n}\n\n\/* Dropdown container *\/\n.dropdown {\n  position: relative;\n  display: inline-block;\n}\n\n\/* Dropdown content *\/\n.dropdown-content {\n  position: absolute;\n  width: 220px;\n  z-index: 10;\n  top: 110%;\n  left: 0;\n  background: #fff;\n  border-radius: 10px;\n  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);\n  overflow: hidden;\n\n  opacity: 0;\n  transform: translateY(-12px);\n  visibility: hidden;\n  transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;\n}\n\n.dropdown.active .dropdown-content {\n  opacity: 1;\n  transform: translateY(0);\n  visibility: visible;\n}\n\n\/* Promo code items *\/\n.promo-code {\n  padding: 12px 14px;\n  background: #f8fafc;\n  color: #111;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  transition: background 0.3s ease, color 0.3s ease;\n}\n\n.promo-code:not(:last-child) {\n  border-bottom: 1px solid #e2e8f0;\n}\n\n.promo-code:hover {\n  background: #e0f2fe;\n  color: #0369a1;\n}\n\n\/* Promo check inside item *\/\n.promo-check {\n  background-color: rgba(0, 0, 0, 0.05);\n  padding: 4px 10px;\n  border-radius: 6px;\n  font-size: 11px;\n  color: #111;\n  font-weight: bold;\n  white-space: nowrap;\n}\n\n\/* Toast *\/\n#toast {\n  display: none;\n  background-color: #111827;\n  color: #fff;\n  padding: 14px;\n  position: fixed;\n  top: 20px;\n  left: 50%;\n  transform: translateX(-50%);\n  z-index: 1000;\n  border-radius: 8px;\n  width: 80%;\n  max-width: 300px;\n  text-align: center;\n  font-size: 13px;\n  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);\n}\n\n\/* Container for the two buttons *\/\n.button-container {\n  display: flex;\n  flex-wrap: wrap;\n  width: 100%;\n  gap: 2px;\n}\n<\/style>\n\n<div class=\"button-container\">\n  <div class=\"dropdown\" id=\"promoDropdown\">\n    <button class=\"dropbtn\" onclick=\"toggleDropdown()\">Angebote & Klick mit Kopie ▼<\/button>\n    <div class=\"dropdown-content\">\n      <div class=\"promo-code\" onclick=\"copyPromoCode('LIGHT10')\">10% RABATT, Kaufe 2 Pendelleuchten<\/div>\n      <div class=\"promo-code\" onclick=\"copyPromoCode('LAMPE10')\">10% RABATT, Kaufe 2 Lampenschirme<\/div>\n      <div class=\"promo-code\" onclick=\"copyPromoCode('B2B500')\">15% RABATT bei Bestellungen über 500€<\/div>\n    <\/div>\n  <\/div>\n  <a href=\"#proTabs5ff6a4f5-c591-4a3f-bb68-b1efa1c91ab5\">\n    <button class=\"description-btn\">Beschreibung anzeigen<\/button>\n  <\/a>\n<\/div>\n\n<div id=\"toast\">Promo code copied!<\/div>\n\n<script>\nfunction toggleDropdown() {\n  const dropdown = document.getElementById('promoDropdown');\n  dropdown.classList.toggle('active');\n}\n\ndocument.addEventListener('click', function (event) {\n  const dropdown = document.getElementById('promoDropdown');\n  if (!dropdown.contains(event.target)) {\n    dropdown.classList.remove('active');\n  }\n});\n\nfunction copyPromoCode(code) {\n  navigator.clipboard.writeText(code).then(function () {\n    showToast('Copied: ' + code);\n  }, function (err) {\n    console.error('Could not copy text: ', err);\n    showToast('Failed to copy');\n  });\n}\n\nfunction showToast(message) {\n  const toast = document.getElementById('toast');\n  toast.innerText = message;\n  toast.style.display = 'block';\n  setTimeout(function () {\n    toast.style.display = 'none';\n  }, 2000);\n}\n<\/script>"}},"37f20969-8bae-47ff-89e1-b0be3169e19a":{"type":"product_form","settings":{"button_animation":"flash-move","show_buy_now":true,"show_gift_card_recipient":false,"label_quantity_product_information":true}},"custom_text_4eQTYj":{"type":"custom_text","settings":{"content":"<h3><strong>100% Geld-zurück-Garantie<\/strong><\/h3>"}},"fb4d791a-e332-4dc8-b188-114a9e802869":{"type":"pickup_availability","settings":{}},"c772ce81-4aa5-415d-8939-631c6d4897ff":{"type":"delivery_return","settings":{"show_delivery":true,"delivery_text":"<p>Geschätzte Lieferzeiten: <strong>2-4 Tage<\/strong>(Lokale Lieferung), <strong>3–6 Tage<\/strong> (International)<\/p>","show_return":true,"return_text":"<p>Rückgabe innerhalb von 30 Tagen nach dem Kauf. Zölle und Steuern werden nicht erstattet.<\/p>"}},"84ae25d8-caaa-414c-b983-91812f8c5046":{"type":"product_meta","disabled":true,"settings":{"show_vendors":true,"show_available":true,"show_sku":true,"show_barcode":false,"show_type":true,"show_collection":true}},"e3c98e10-4e94-4a55-bf4e-364e68cbe829":{"type":"trust_badge","settings":{"heading":"<p>Guarantee safe checkout<\/p>","image_width":300,"position":"above"}}},"block_order":["4fb992c4-abd8-4a65-a790-09cd83721e45","82f7102f-e1b6-4eb3-89b7-ee189edc5f76","836d9723-358d-4023-88a8-2d3b5907093e","7d760b32-e8e4-42d9-8998-91d6fb23aaef","dbd063d5-9b87-45d4-9984-deb077fa0e85","66e6994c-2a75-4723-a6a4-d69ac368f716","39f14f5e-3cc5-4645-a921-f071b109d244","af29e4ac-1b8b-423e-afb3-744988c21a76","3870a5bb-fec0-4b82-9405-e324077ed947","062f7cd6-1265-4c29-a22c-e2bbebc5f2b6","4c574cf3-57bd-46ba-866c-1c9ffa41769f","e5cf937e-e30a-4b9a-93c1-f48c229054f3","b328bd75-b508-4fed-84c2-6727ff481d16","f98b666a-7c37-41ed-be7b-4a28f4a1e8b4","7a