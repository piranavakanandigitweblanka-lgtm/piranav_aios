 flex: 1;\n        align-items: stretch;\n        justify-content: flex-start;\n    }\n\n    .offer p,\n    .offer ul {\n        max-width: 360px;\n        margin: 0 auto 12px;\n        text-align: left;\n    }\n\n    .offer p {\n        font-size: 15px;\n        margin-bottom: 15px;\n        line-height: 1.6;\n        color: #555;\n    }\n\n    .offer ul {\n        list-style: none;\n        padding-left: 0;\n        margin-bottom: 20px;\n        font-size: 14px;\n        color: #777;\n    }\n\n    .offer ul li {\n        margin-bottom: 10px;\n        position: relative;\n        padding-left: 20px;\n    }\n\n    .offer ul li::before {\n        content: '✔';\n        position: absolute;\n        left: 0;\n        color: #27ae60;\n        font-size: 16px;\n    }\n\n    .btn {\n        background-color: #3498db;\n        color: white;\n        padding: 12px 30px;\n        border-radius: 30px;\n        text-decoration: none;\n        font-weight: bold;\n        text-transform: uppercase;\n        display: inline-block;\n        transition: all 0.3s ease;\n        margin-top: auto;\n        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);\n    }\n\n    .btn:hover {\n        background-color: #2980b9;\n        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);\n    }\n\n    \/* Steps Section *\/\n    .how-it-works {\n        background-color: #fff;\n        padding: 50px 20px;\n        text-align: center;\n    }\n\n    .how-it-works h2 {\n        font-size: 24px;\n        color: #333;\n        margin-bottom: 40px;\n    }\n\n    .steps-container {\n        display: flex;\n        justify-content: center;\n        flex-wrap: wrap;\n        gap: 48px;\n    }\n\n    .step {\n        background: #ffffff;\n        border-radius: 10px;\n        padding: 28px;\n        min-height: 200px;\n        width: 250px;\n        text-align: center;\n        transition: transform 0.24s ease, box-shadow 0.24s ease;\n        color: #222;\n        box-shadow: 0 6px 16px rgba(20, 20, 20, 0.06);\n        di