ckground-color 0.3s, box-shadow 0.3s;\n        white-space: nowrap;\n    }\n\n    .google-review-button img {\n        width: 24px;\n        height: 24px;\n        margin-right: 10px;\n        border-radius: 5px;\n    }\n\n    .google-review-button:hover {\n        background-color: white;\n        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);\n    }\n\n    .google-star {\n        width: 20px;\n        height: 20px;\n        margin-left: 5px;\n        fill: #FFC300;\n    }\n\n    .separator-line {\n        width: 1px;\n        height: 40px;\n        background-color: #ccc;\n    }\n\n    .trustpilot-widget {\n        min-width: 250px;\n        white-space: nowrap;\n    }\n  <\/style>\n\n  <div class=\"review-section\">\n    <!-- Google Review Button -->\n    <a href=\"https:\/\/www.google.com\/search?sca_esv=1be9f2246bcf563b&amp;rlz=1C1CHBF_en-GBLK1181LK1181&amp;sxsrf=AE3TifN58CZRtfKdtLrRrjgWJwWUJ03xXA:1758863102359&amp;si=AMgyJEtREmoPL4P1I5IDCfuA8gybfVI2d5Uj7QMwYCZHKDZ-E6u2-L1tM0rmwlkLtdoXa-nodVXTIjiBKVO5nkwNO7KGl5zb6KM6Ff3LhVcxyUNb-8s1l6sWfQDFMvyvkWx3syuxO8sS&amp;q=Ledsone+De+Reviews&amp;sa=X&amp;ved=2ahUKEwi2zbLT0_WPAxXfgv0HHYuXEtMQ0bkNegQIPRAE&amp;biw=1280&amp;bih=559&amp;dpr=1.5\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"google-review-button\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0250\/4094\/5248\/files\/google_logo.png?v=1732103956\" alt=\"Google G icon\">\n      Google Review\n      <svg class=\"google-star\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewbox=\"0 0 24 24\">\n        <path d=\"M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z\"><\/path>\n      <\/svg>\n    <\/a>\n\n<a href=\"https:\/\/de.trustpilot.com\/review\/ledsone.de\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"trustpilot-clean-button\">\n  Review us on \n  <svg class=\"trustpilot-star\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewbox=\"0 0 24 24\">\n    <path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.847 1.416 8.261L12 19.896l-7.416 3.96L6 15.595 0 9.748l8.332-1.73z\"><\/path>\n  <\/svg> \n  <strong>Trustpilot<\/strong>\n<\/a>\n\n<style>\n  .trustpilot-clean-button {\n    display: inline-flex;\n    align-items: center;\n    padding: 8px 16px;\n    border: 1px solid #00B67A;         \/* Fixed green border *\/\n    border-radius: 4px;                 \/* Slight rounded corners (not bent) *\/\n    background-color: #ffffff;          \/* White background *\/\n    color: black;                       \/* Black text *\/\n    font-size: 15px;\n    font-weight: 500;\n    text-decoration: none;\n    cursor: pointer;\n  }\n\n  .trustpilot-clean-button:hover {\n    background-color: #ffffff;          \/* No change on hover *\/\n    border-color: #00B67A;              \/* Keep the same green border *\/\n    color: black;                       \/* Text stays black *\/\n    box-shadow: none;                   \/* No shadow *\/\n  }\n\n  .trustpilot-clean-button .trustpilot-star {\n    width: 18px;\n    height: 18px;\n    fill: #00B67A;                      \/* Trustpilot green *\/\n    margin: 0 5px;\n  }\n<\/style>\n<\/div>\n<\/div>","padding_top":0,"padding_bottom":0,"reset_spacing":false}},"products_recently_viewed_zMUmDT":{"type":"products-recently-viewed","name":"t:sections.products-recently-viewed.name","settings":{"heading_logo_svg":"","subheading":"","heading":"Recently viewed products","description":"<p>The best quality products are waiting for you. Choose it now!<\/p>","text_alignment":"text-center","container":"container","color_scheme":"","limit_products":6,"item_desktop":4,"column_gap":30,"carousel_autoplay":false,"carousel_loop":false,"carousel_arrows":false,"carousel_pagination":"carousel_none","padding_top":0,"padding_bottom":0,"reset_spacing":false}}},"order":["main","page_heading_BWCyje","175911908974f481c7","subscribe_form_3Rd7pb","custom_html_A7XTxB","icon_box_DmMBNK","collection_list_VEwTCt","products_list_JgG8HL","products_carousel_YB6JyF","custom_html_pMwntP","produ