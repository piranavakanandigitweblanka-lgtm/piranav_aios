{"sections":{"main":{"type":"main-page","custom_css":["@media only screen and (max-width: 768px) {h1 {font-size: 24px; }}"],"settings":{}},"custom_liquid_CdRPcH":{"type":"custom-liquid","disabled":true,"name":"t:sections.custom-liquid.name","settings":{"heading_logo_svg":"","subheading":"","heading":"","description":"","text_alignment":"text-center","container":"container","color_scheme":"","content_liquid":"<!-- LEDSone FAQ Page — Accordion Dropdown | Paste into Shopify Page HTML editor -->\n\n<style>\n.faq-wrap { max-width: 1000px; margin: 0 auto; padding: 0 0 60px; font-family: -apple-system, 'Helvetica Neue', Arial, sans-serif; color: #111; line-height: 1.75; }\n\n\/* ── HEADER ── *\/\n.faq-header { padding: 40px 0 32px; border-bottom: 2px solid #111; margin-bottom: 36px; }\n.faq-header p { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #999; margin-bottom: 8px; }\n.faq-header h1 { font-size: clamp(24px, 4vw, 36px); font-weight: 700; letter-spacing: -0.02em; color: #111; margin-bottom: 8px; }\n.faq-header span { font-size: 14px; color: #888; }\n\n\/* ── ACCORDION ITEM ── *\/\n.faq-item {\n  border-bottom: 1px solid #e8e8e8;\n}\n.faq-item:first-of-type {\n  border-top: 1px solid #e8e8e8;\n}\n\n\/* ── TOGGLE BUTTON ── *\/\n.faq-toggle {\n  width: 100%;\n  background: none;\n  border: none;\n  padding: 20px 0;\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  cursor: pointer;\n  text-align: left;\n  transition: background 0.15s;\n}\n.faq-toggle:hover { background: #fafafa; padding-left: 8px; padding-right: 8px; margin-left: -8px; width: calc(100% + 16px); }\n\n.faq-num {\n  font-size: 11px;\n  font-weight: 800;\n  color: #fff;\n  background: #111;\n  width: 32px;\n  height: 32px;\n  min-width: 32px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.faq-q {\n  font-size: 15px;\n  font-weight: 700;\n  color: #000;\n  line-height: 1.4;\n  flex: 1;\n}\n\n.faq-icon {\n  width: 28px;\n  height: 28px;\n  min-width: 28px;\n  border: 1.5px solid #ccc;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  transition: all 0.25s;\n  font-size: 18px;\n  line-height: 1;\n  color: #555;\n}\n.faq-toggle.open .faq-icon {\n  background: #111;\n  border-color: #111;\n  color: #fff;\n  transform: rotate(45deg);\n}\n\n\/* ── ANSWER PANEL ── *\/\n.faq-panel {\n  display: none;\n  padding: 0 0 22px 48px;\n}\n.faq-panel.open { display: block; }\n\n.faq-a { font-size: 16px; color: #9B3A3A; line-height: 1.85; }\n.faq-a p { margin-bottom: 8px; }\n.faq-a p:last-child { margin-bottom: 0; }\n.faq-a a { color: #111; text-decoration: underline; text-underline-offset: 3px; }\n.faq-a a:hover { opacity: 0.6; }\n.faq-a strong { color: #111; }\n\n\/* ── BULLET LIST ── *\/\n.faq-list { list-style: none; padding: 0; margin: 8px 0; }\n.faq-list li { font-size: 16px; color: #9B3A3A; padding: 6px 0 6px 16px; position: relative; border-bottom: 1px solid #f5f5f5; }\n.faq-list li:last-child { border-bottom: none; }\n.faq-list li::before { content: '—'; position: absolute; left: 0; color: #bbb; }\n\n\/* ── TABLE ── *\/\n.faq-table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 15px; }\n.faq-table th { background: #111; color: #fff; text-align: left; padding: 8px 12px; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }\n.faq-table td { padding: 9px 12px; border-bottom: 1px solid #f0f0f0; color: #444; }\n.faq-table tr:last-child td { border-bottom: none; }\n.faq-table tr:nth-child(even) td { background: #fafafa; }\n\n\/* ── PAYMENT BADGES ── *\/\n.faq-pay { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }\n.faq-pay-badge { display: inline-block; border: 1px solid #e8e8e8; padding: 4px 10px; font-size: 12px; color: #444; font-weight: 500; background: #fafafa; }\n\n\/* ── CONTACT DETAILS ── *\/\n.faq-contact-details p { margin-bottom: 4px; font-size: 16px; color: #9B3A3A; }\n\n\/* ── NOTE ── *\/\n.faq-note { background: #f7f7f7; border-left: 3px solid #111; padding: 12px 16px; margin: 10px 0; font-size: 16px; color: #9B3A3A; }\n\n\/* ── ORDER TRACKER (working version) ── *\/\n.faq-tracker-wrap {\n  margin-top: 16px;\n}\n.shipment-tracking-section {\n  padding: 0;\n  background: #ffffff;\n}\n.tracking-container-wrap {\n  max-width: 100%;\n  margin: 0;\n  display: flex;\n  gap: 16px;\n  flex-wrap: wrap;\n  align-items: stretch;\n}\n.tracking-form-panel {\n  flex: 1;\n  min-width: 280px;\n  background: rgb(250, 250, 250);\n  padding: 16px;\n  border-radius: 10px;\n  text-align: center;\n  border: 1px solid #e8e8e8;\n}\n.tracking-form-panel h2 { margin: 0 0 4px; font-size: 18px; color: #111; }\n.tracking-form-panel p { margin-bottom: 10px; font-size: 13px; color: #555; }\n.tracking-form-panel form { display: flex; flex-direction: column; gap: 8px; }\n.tracking-form-panel input {\n  padding: 9px 12px;\n  border: 1px solid #ccc;\n  border-radius: 6px;\n  font-size: 14px;\n  outline: none;\n}\n.tracking-form-panel input:focus { border-color: #111; }\n.tracking-form-panel button {\n  padding: 9px;\n  background: rgb(0, 0, 0);\n  color: #fff;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 14px;\n  font-weight: 600;\n  transition: opacity 0.2s;\n}\n.tracking-form-panel button:hover { opacity: 0.75; }\n.tracking-form-panel small { display: block; margin-top: 6px; font-size: 11px; color: #777; }\n\n\/* ── FOOTER CONTACT ── *\/\n.faq-footer { margin-top: 40px; border-top: 2px solid #111; padding-top: 28px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }\n.faq-footer-text strong { font-size: 15px; font-weight: 700; color: #111; display: block; margin-bottom: 3px; }\n.faq-footer-text span { font-size: 13px; color: #999; }\n.faq-footer-btn { display: inline-block; background: #111; color: #fff !important; padding: 10px 24px; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none !important; transition: opacity 0.2s; white-space: nowrap; }\n.faq-footer-btn:hover { opacity: 0.7; }\n\n\/* ── RESPONSIVE ── *\/\n@media (max-width: 480px) {\n  .faq-num { width: 28px; height: 28px; min-width: 28px; font-size: 10px; }\n  .faq-q { font-size: 15px; }\n  .faq-panel { padding-left: 12px; }\n  .faq-footer { flex-direction: column; align-items: flex-start; }\n  .faq-table { font-size: 13px; }\n  .faq-table th, .faq-table td { padding: 7px 8px; }\n  .tracking-form-panel { min-width: 100%; }\n}\n<\/style>\n\n<div class=\"faq-wrap\">\n\n  <!-- HEADER -->\n  <div class=\"faq-header\">\n    <p>LEDSone DE Ltd &nbsp;·&nbsp; ledsone.de<\/p>\n    <h1>Häufig gestellte Fragen<\/h1>\n    <span>Hier finden Sie Antworten auf die häufigsten Fragen.<\/span>\n  <\/div>\n\n  <!-- Q1 -->\n  <div class=\"faq-item\">\n    <button class=\"faq-toggle\" onclick=\"faqToggle(this)\">\n      <span class=\"faq-num\">01<\/span>\n      <span class=\"faq-q\">Wie lange dauert die Lieferung meiner Bestellung?<\/span>\n      <span class=\"faq-icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-panel\">\n      <div class=\"faq-a\">\n        <p>Alle Bestellungen, die vor 12:00 Uhr (Montag–Freitag) eingehen, werden noch am selben Tag bearbeitet. Die Lieferzeiten sind wie folgt:<\/p>\n        <ul class=\"faq-list\">\n          <li>Deutschland: 2–3 Werktage<\/li>\n          <li>International: 3–5 Werktage<\/li>\n        <\/ul>\n        <p>Der Versand erfolgt über GLS oder DHL.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- Q2 -->\n  <div class=\"faq-item\">\n    <button class=\"faq-toggle\" onclick=\"faqToggle(this)\">\n      <span class=\"faq-num\">02<\/span>\n      <span class=\"faq-q\">Bieten Sie kostenlosen Versand an?<\/span>\n      <span class=\"faq-icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-panel\">\n      <div class=\"faq-a\">\n        <p>Ja! Wir bieten kostenlosen Versand innerhalb Deutschlands für alle Bestellungen über 30 € an. Alle Sendungen beinhalten eine Sendungsverfolgung, sodass Sie Ihre Bestellung jederzeit online nachverfolgen können.<\/p>\n        <table class=\"faq-table\">\n          <thead>\n            <tr><th>Service<\/th><th>Lieferzeit<\/th><th>Kosten<\/th><\/tr>\n          <\/thead>\n          <tbody>\n            <tr><td>Standardversand<\/td><td>2–3 Werktage<\/td><td>Kostenlos (ab 30 €)<\/td><\/tr>\n            <tr><td>Standardversand<\/td><td>2–3 Werktage<\/td><td>2,89 € (unter 30 €)<\/td><\/tr>\n            <tr><td>Internationaler Versand<\/td><td>3–5 Werktage<\/td><td>An der Kasse berechnet<\/td><\/tr>\n          <\/tbody>\n        <\/table>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- Q3 -->\n  <div class=\"faq-item\">\n    <button class=\"faq-toggle\" onclick=\"faqToggle(this)\">\n      <span class=\"faq-num\">03<\/span>\n      <span class=\"faq-q\">Kann ich meine Bestellung zurückgeben?<\/span>\n      <span class=\"faq-icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-panel\">\n      <div class=\"faq-a\">\n        <p>Ja. Sie können Artikel innerhalb von <strong>30 Tagen<\/strong> nach Erhalt zurücksenden oder umtauschen. Bitte beachten Sie unsere <a href=\"https:\/\/ledsone.de\/pages\/ruckgabe-erstattungsrichtlinie\">Rückgaberichtlinie<\/a>.<\/p>\n        <p>Die Produkte müssen sich im Originalzustand, mit Etiketten und ohne Gebrauchsspuren befinden.<\/p>\n        <div class=\"faq-note\">\n          <strong>Rücksendeadresse:<\/strong><br>\n          Ledsone LTD, Schmutter Str. 16, 78647 Trossingen, Deutschland\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- Q4 -->\n  <div class=\"faq-item\">\n    <button class=\"faq-toggle\" onclick=\"faqToggle(this)\">\n      <span class=\"faq-num\">04<\/span>\n      <span class=\"faq-q\">Wie funktioniert der Rückgabeprozess?<\/span>\n      <span class=\"faq-icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-panel\">\n      <div class=\"faq-a\">\n        <p>Um eine Rückgabe zu starten, kontaktieren Sie bitte unseren Kundenservice unter <a href=\"\/cdn-cgi\/l\/email-protection#b1d0d5dcd8df979287858addd4d5c2dedfd4979285878ad5d4\">admin&#64;ledsone&#46;de<\/a>. Wir senden Ihnen alle notwendigen Anweisungen und Informationen zur Rücksendung.<\/p>\n        <p>Die Versandkosten für die Rücksendung trägt der Kunde, es sei denn, das Produkt ist defekt oder wurde falsch geliefert.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- Q5 -->\n  <div class=\"faq-item\">\n    <button class=\"faq-toggle\" onclick=\"faqToggle(this)\">\n      <span class=\"faq-num\">05<\/span>\n      <span class=\"faq-q\">Wie kann ich Sie kontaktieren, wenn ich Fragen habe?<\/span>\n      <span class=\"faq-icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-panel\">\n      <div class=\"faq-a\">\n        <p>Sie können uns per E-Mail, Telefon oder über das Kontaktformular auf unserer Website erreichen. Unser Kundenservice ist erreichbar:<\/p>\n        <div class=\"faq-contact-details\">\n          <p><strong>Werktage:<\/strong> Montag – Freitag<\/p>\n          <p><strong>Arbeitszeiten:<\/strong> 09:00 – 16:00 Uhr<\/p>\n          <p><strong>E-Mail:<\/strong> <a href=\"\/cdn-cgi\/l\/email-protection#1372777e7a7d35302527287f7677607c7d7635302725287776\">admin&#64;ledsone&#46;de<\/a><\/p>\n          <p><strong>Telefon:<\/strong> <a href=\"tel:+4901782350248\">+49 0178 2350248<\/a><\/p>\n          <p><strong>Kontaktformular:<\/strong> <a href=\"https:\/\/ledsone.de\/pages\/kontaktiere-uns\">ledsone.de\/kontaktiere-uns<\/a><\/p>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- Q6 -->\n  <div class=\"faq-item\">\n    <button class=\"faq-toggle\" onclick=\"faqToggle(this)\">\n      <span class=\"faq-num\">06<\/span>\n      <span class=\"faq-q\">Wie kann ich bezahlen?<\/span>\n      <span class=\"faq-icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-panel\">\n      <div class=\"faq-a\">\n        <p>Sie können sicher und bequem mit folgenden Zahlungsmethoden bezahlen:<\/p>\n        <div class=\"faq-pay\">\n          <span class=\"faq-pay-badge\">PayPal<\/span>\n          <span class=\"faq-pay-badge\">Visa<\/span>\n          <span class=\"faq-pay-badge\">Mastercard<\/span>\n          <span class=\"faq-pay-badge\">AMEX<\/span>\n          <span class=\"faq-pay-badge\">Klarna<\/span>\n          <span class=\"faq-pay-badge\">iDEAL Wero<\/span>\n          <span class=\"faq-pay-badge\">Apple Pay<\/span>\n          <span class=\"faq-pay-badge\">Google Pay<\/span>\n        <\/div>\n        <p style=\"margin-top:10px;\">Alle Zahlungen erfolgen über eine sichere, verschlüsselte Verbindung.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- Q8 + ORDER TRACKER -->\n  <div class=\"faq-item\">\n    <button class=\"faq-toggle\" onclick=\"faqToggle(this)\">\n      <span class=\"faq-num\">08<\/span>\n      <span class=\"faq-q\">Wie kann ich meine Bestellung verfolgen?<\/span>\n      <span class=\"faq-icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-panel\">\n      <div class=\"faq-a\">\n        <p>Sobald Ihre Bestellung versendet wurde, erhalten Sie eine <strong>Sendungsverfolgungsnummer per E-Mail<\/strong>. Mit dieser Nummer können Sie Ihre Bestellung ganz einfach nachverfolgen und den aktuellen Status einsehen.<\/p>\n\n        <!-- WORKING ORDER TRACKER -->\n        <div class=\"faq-tracker-wrap\">\n          <section class=\"shipment-tracking-section\">\n            <div class=\"tracking-container-wrap\">\n              <div class=\"tracking-form-panel\">\n                <h2>Verfolgen Sie Ihre Bestellung<\/h2>\n                <p>Geben Sie Ihre Sendungsnummer ein<\/p>\n                <form onsubmit=\"return trackOrderSubmit(event)\">\n                  <input\n                    type=\"text\"\n                    id=\"orderNumberInput\"\n                    inputmode=\"numeric\"\n                    pattern=\"[0-9]+\"\n                    placeholder=\"Sendungsnummer eingeben\"\n                    required\n                  \/>\n                  <button type=\"submit\">Bestellung verfolgen<\/button>\n                <\/form>\n                <small>Tracking öffnet sich in einem neuen Tab<\/small>\n              <\/div>\n            <\/div>\n          <\/section>\n        <\/div>\n\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- Q9 -->\n  <div class=\"faq-item\">\n    <button class=\"faq-toggle\" onclick=\"faqToggle(this)\">\n      <span class=\"faq-num\">09<\/span>\n      <span class=\"faq-q\">Was soll ich tun, wenn meine Bestellung beschädigt oder unvollständig ankommt?<\/span>\n      <span class=\"faq-icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-panel\">\n      <div class=\"faq-a\">\n        <p>Bitte überprüfen Sie Ihre Bestellung sofort nach Erhalt. Wenn Artikel fehlen oder beschädigt sind, kontaktieren Sie uns bitte <strong>innerhalb von 48 Stunden<\/strong> unter <a href=\"\/cdn-cgi\/l\/email-protection#2b4a4f4642450d081d1f10474e4f5844454e0d081f1d104f4e\">admin&#64;ledsone&#46;de<\/a>.<\/p>\n        <p>Wir werden das Problem so schnell wie möglich für Sie lösen.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- Q10 -->\n  <div class=\"faq-item\">\n    <button class=\"faq-toggle\" onclick=\"faqToggle(this)\">\n      <span class=\"faq-num\">10<\/span>\n      <span class=\"faq-q\">Kann ich meine Bestellung stornieren, bevor sie versendet wird?<\/span>\n      <span class=\"faq-icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-panel\">\n      <div class=\"faq-a\">\n        <p>Ja, Sie können eine Stornierung beantragen, bevor Ihre Bestellung versendet wurde. Bitte kontaktieren Sie uns so schnell wie möglich per E-Mail an <a href=\"\/cdn-cgi\/l\/email-protection#7312171e1a1d55504547481f1617001c1d1655504745481716\">admin&#64;ledsone&#46;de<\/a> oder über unseren Live-Chat auf der Website.<\/p>\n        <p>Wir bestätigen Ihnen, ob die Stornierung möglich ist, und helfen Ihnen umgehend weiter.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- FOOTER -->\n  <div class=\"faq-footer\">\n    <div class=\"faq-footer-text\">\n      <strong>Haben Sie noch Fragen?<\/strong>\n      <span>Wir antworten innerhalb von 24 Stunden &nbsp;·&nbsp; Mo–Fr, 09:00–16:00 Uhr<\/span>\n    <\/div>\n    <a href=\"https:\/\/ledsone.de\/pages\/kontaktiere-uns\" class=\"faq-footer-btn\">Kontakt<\/a>\n  <\/div>\n\n<\/div>\n\n<script>\n\/* ── ACCORDION ── *\/\nfunction faqToggle(btn) {\n  var panel = btn.nextElementSibling;\n  var isOpen = panel.classList.contains('open');\n\n  document.querySelectorAll('.faq-panel.open').forEach(function(p) {\n    p.classList.remove('open');\n  });\n  document.querySelectorAll('.faq-toggle.open').forEach(function(b) {\n    b.classList.remove('open');\n  });\n\n  if (!isOpen) {\n    panel.classList.add('open');\n    btn.classList.add('open');\n  }\n}\n\n\/* ── ORDER TRACKER ── *\/\nfunction trackOrderSubmit(e) {\n  e.preventDefault();\n  var n = document.getElementById('orderNumberInput').value.trim();\n  if (!n) return false;\n  var url = n.length >= 20\n    ? \"https:\/\/www.dhl.de\/en\/privatkunden\/dhl-sendungsverfolgung.html?piececode=\" + encodeURIComponent(n)\n    : \"https:\/\/www.gls-pakete.de\/en\/reach-parcel-tracking?trackingNumber=\" + encodeURIComponent(n);\n  window.open(url, \"_blank\");\n  return false;\n}\n<\/script>","padding_top":0,"padding_bottom":0,"reset_spacing":false}}},"order":["main","custom_liquid_CdRPcH"]}