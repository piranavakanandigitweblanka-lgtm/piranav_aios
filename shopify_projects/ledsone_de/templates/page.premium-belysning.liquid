{%- layout none -%}<?xml version="1.0" encoding="UTF-8" ?>
<rss xmlns:g="http://base.google.com/ns/1.0" version="2.0">
<channel>

<title>{{shop.name | escape }} Products</title> <link>{{shop.url}}</link> {% assign target_collection = collections['premium-belysning'] %} {% paginate target_collection.products by 1000 %}
   {% for product in target_collection.products %}
    {% for variant in product.variants %}
        <item>
            <g:id>{{ variant.id }}</g:id>
            <g:title><![CDATA[{{ product.title | strip_html | strip_newlines | escape | replace: 'amp;', 'and' | replace: '&#38;', 'and' | replace: "Ã©", "e" | replace: "Ã ", "a" }} {% unless variant.title == 'Default Title' %}- {{ variant.title | escape }}{% endunless %}]]></g:title>
            <g:brand>{{ product.vendor | escape }}</g:brand>
            <g:product_type>{{ product.type | escape }}</g:product_type>
            <g:condition>New</g:condition>
            <g:description><![CDATA[{{ product.description | strip_html | strip_newlines | replace: 'amp;', 'and' | replace: '&#38;', 'and' | replace: "..", ". " | replace: " ", " " | replace: "â€˜", "&#39;" | replace: "â€™", "&#39;" | replace: "&#8216;", "&#39;" | replace: "&#8217;", "&#39;" | replace: "&#8217;", "&#39;" | replace: "Ã¢â‚¬â„¢", "&#39;" | replace: "Ã¢â‚¬Å“", "&#39;" | replace: "Ã¢â‚¬Ëœ", "&#39;" | replace: "Ã‚Â´", "&#39;" | replace: "â€œ", "&#34;" | replace: "â€", "&#34;" | replace: "&#8211;", "-" | replace: "Ã¢â‚¬â€œ", "-" | replace: "Ã¢â‚¬â€", "-" | replace: "â€“", "&mdash;" | replace: "â€”", "&mdash;" | replace: "%", "&#37;" | replace: "Ã‚Â©", "&copy;" | replace: "Ã‚Â®", "&reg;" | replace: "Ã¢â€žÂ¢", "&trade;" | replace: "Ã‚Â£", "&pound;" | replace: "Ã¯Â¿Â", "&#42;" | replace: "Ã¢â‚¬Â¢", "&#42;" | replace: "Ã¢â‚¬Â", "&#39;" | replace: "&#233;", "e" | replace: "Ã©", "e" | replace: "Ã ", "a" | replace: "Ã³", "o" | replace: "Ãª", "e" | replace: "ÃƒËœ", "O" | replace: "&#8482;", "" | replace: "&#174;", "" }}]]></g:description>


            <g:image_link>
                {% if variant.image %}
                    https:{{ variant.image | product_img_url: 'grande' }}
                {% else %}
                    https:{{ product.featured_image | product_img_url: 'grande' }}
                {% endif %}
            </g:image_link>
            <g:link>{{ shop.url }}{{ variant.url }}</g:link>
            
            {% comment %} Convert price from EUR to DKK (Danish Krone) {% endcomment %}
            {% assign eur_price = variant.price %}
            {% assign exchange_rate = 7.44 %} {% comment %} EUR to DKK exchange rate - adjust as needed {% endcomment %}
            {% assign dkk_price = eur_price | times: exchange_rate | divided_by: 100.0 %}
            
            <g:price>{{ dkk_price | round: 2 }} DKK</g:price>
            <g:availability>{% if variant.available %}in_stock{%- else -%}out_of_stock{%- endif %}</g:availability>
            <g:gtin>{{ variant.barcode }}</g:gtin>
            <g:currency>DKK</g:currency>
        </item>
    {% endfor %}
{% endfor %}
{% endpaginate %}
</channel> </rss> 