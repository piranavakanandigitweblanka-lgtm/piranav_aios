    <!-- Kuberan added - Shopify Inbox delay for LCP fix 23-06-2026 -->
  <style id="chat-hide-style">#shopify-chat { visibility: hidden; }</style>
  <script>
    (function() {
      var done = false;
      function showChat() {
        if (done) return;
        done = true;
        var style = document.getElementById('chat-hide-style');
        if (style) style.remove();
        ['scroll','mousemove','touchstart','keydown'].forEach(function(ev) {
          document.removeEventListener(ev, showChat);
        });
      }
      ['scroll','mousemove','touchstart','keydown'].forEach(function(ev) {
        document.addEventListener(ev, showChat, { passive: true, once: true });
      });
      setTimeout(showChat, 5000);
    })();
  </script>
  <!-- End Shopify Inbox delay -->  


