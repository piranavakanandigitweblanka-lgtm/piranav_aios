<script>
// Show popup only if on homepage
if (window.location.pathname === '/' || window.location.pathname === '/index') {

  // Prevent showing again if closed earlier in this session
  if (!sessionStorage.getItem('popupClosed')) {

    // Function to show popup
    function showPopup() {
      document.getElementById('offer-popup').style.display = 'flex';

      // Auto close after 20 seconds
      setTimeout(function() {
        document.getElementById('offer-popup').style.display = 'none';
      }, 20000);
    }

    // Show popup after 3 seconds
    setTimeout(function() {
      showPopup();
    }, 3000);
  }
}

// Close function
function closePopup() {
  document.getElementById('offer-popup').style.display = 'none';

// Save that user closed it — do NOT show again this session
  sessionStorage.setItem('popupClosed', 'true');
}
</script>


<script>
  if (window.location.pathname === '/account') {
    var redirect = localStorage.getItem('redirect_after_register');
    if (redirect) {
      localStorage.removeItem('redirect_after_register');
      window.location.href = redirect;
    }
  }
</script>


