{%- liquid
  assign section_collection = collections[section.settings.collection]
  assign products_limit     = section.settings.products_to_show
  assign columns            = section.settings.columns_desktop
  assign show_vendor        = section.settings.show_vendor
  assign show_rating        = section.settings.show_rating
  assign show_badge         = section.settings.show_sale_badge
  assign heading            = section.settings.heading
  assign subheading         = section.settings.subheading
  assign btn_label          = section.settings.button_label
  assign btn_link           = section.settings.button_link
  assign auto_scroll        = section.settings.auto_scroll
  assign scroll_speed       = section.settings.scroll_speed

  assign product_in_collection = false
  for col in product.collections
    if col.handle == section_collection.handle
      assign product_in_collection = true
      break
    endif
  endfor
-%}

{%- unless section_collection == blank or section_collection.products_count == 0 or product_in_collection == false -%}

<section
  id="section-{{ section.id }}"
  class="leds-collection-products color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding"
  aria-label="{{ heading | escape }}"
>
  <div class="leds-collection-products__inner page-width">

    {%- if heading != blank or subheading != blank -%}
      <div class="leds-collection-products__header">
        {%- if subheading != blank -%}
          <p class="leds-collection-products__subheading caption-with-letter-spacing">{{ subheading | escape }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="leds-collection-products__title {{ section.settings.heading_size }}">
            {{- heading | escape -}}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign sorted_products = section_collection.products | sort: 'created_at' | reverse -%}

    <div class="leds-carousel-wrapper" id="leds-carousel-{{ section.id }}">

      <!-- Prev / Next arrow buttons -->


      <ul
        class="leds-collection-products__grid leds-carousel__track"
        role="list"
        id="leds-track-{{ section.id }}"
        data-auto-scroll="{{ auto_scroll }}"
        data-scroll-speed="{{ scroll_speed }}"
        data-col-count="{{ columns }}"
      >
        {%- for product in sorted_products limit: products_limit -%}
  {%- unless product.available -%}{%- continue -%}{%- endunless -%}

          {%- liquid
            assign display_variant = nil
            for v in product.variants
              if v.available and display_variant == nil
                assign display_variant = v
              endif
            endfor
            if display_variant == nil
              assign display_variant = product.variants.first
            endif

            assign current_price = display_variant.price
            assign compare_at    = display_variant.compare_at_price

            assign on_sale = false
            if compare_at != blank and compare_at > current_price
              assign on_sale = true
            endif

            assign sold_out = false
            unless product.available
              assign sold_out = true
            endunless

            assign discount = 0
            if on_sale and compare_at > 0
              assign discount = compare_at | minus: current_price | times: 100 | divided_by: compare_at
            endif
          -%}

          <li class="leds-collection-products__item leds-carousel__slide">
            <div class="leds-product-card">

              <div class="leds-product-card__media">
                <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                  {%- if product.featured_image -%}
                    {%- assign col_width = 100 | divided_by: columns -%}
                    {%- assign img_sizes = "(min-width: 1200px) calc(" | append: col_width | append: "vw - 40px), (min-width: 768px) calc(50vw - 30px), calc(100vw - 30px)" -%}
                    {{
                      product.featured_image
                      | image_url: width: 600
                      | image_tag:
                        loading: "lazy",
                        widths: "300, 400, 500, 600",
                        sizes: img_sizes,
                        class: "leds-product-card__image",
                        alt: product.featured_image.alt | default: product.title
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'leds-product-card__image leds-product-card__image--placeholder' }}
                  {%- endif -%}
                </a>

                {%- if show_badge -%}
                  <div class="leds-product-card__badges">
                    {%- if sold_out -%}
                      <span class="leds-badge leds-badge--sold-out">
                        {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
                      </span>
                    {%- elsif on_sale and discount > 0 -%}
                      <span class="leds-badge leds-badge--sale">
                        <svg class="leds-badge__icon" viewBox="0 0 12 12" aria-hidden="true">
                          <path d="M1 1h4.586L10.95 6.364a1 1 0 0 1 0 1.414l-3.172 3.172a1 1 0 0 1-1.414 0L1 5.586V1zm2.5 2a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z"/>
                        </svg>
                        -{{ discount }}%
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

              <div class="leds-product-card__info">

                {%- if show_vendor and product.vendor != blank -%}
                  <p class="leds-product-card__vendor caption-with-letter-spacing">{{ product.vendor }}</p>
                {%- endif -%}

                <h3 class="leds-product-card__title">
                  <a href="{{ product.url }}" class="leds-product-card__title-link full-unstyled-link">
                    {{- product.title | escape -}}
                  </a>
                </h3>

                {%- if show_rating and product.metafields.reviews.rating.value != blank -%}
                  <div class="leds-product-card__rating" aria-label="Rating">
                    {%- assign rating_val = product.metafields.reviews.rating.value | times: 1.0 -%}
                    {%- for i in (1..5) -%}
                      {%- if i <= rating_val -%}
                        <span class="leds-star leds-star--full" aria-hidden="true">★</span>
                      {%- else -%}
                        <span class="leds-star leds-star--empty" aria-hidden="true">☆</span>
                      {%- endif -%}
                    {%- endfor -%}
                    <span class="leds-product-card__rating-count visually-hidden">({{ product.metafields.reviews.rating_count }})</span>
                  </div>
                {%- endif -%}

                <div class="leds-product-card__price">
                  {%- if on_sale -%}
                    <span class="leds-product-card__price--sale">{{ current_price | money }}</span>
                    <s class="leds-product-card__price--compare">{{ compare_at | money }}</s>
                    {%- if discount > 0 -%}
                      <span class="leds-product-card__price--savings">Speichern {{ discount }}%</span>
                    {%- endif -%}
                  {%- else -%}
                    <span class="leds-product-card__price--regular">{{ current_price | money }}</span>
                  {%- endif -%}
                </div>

              </div>

            </div>
          </li>

        {%- endfor -%}
      </ul>

    </div>

    {%- if btn_label != blank -%}
      <div class="leds-collection-products__cta center">
        <a href="{{ btn_link | default: section_collection.url }}" class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}">{{- btn_label | escape -}}</a>
      </div>
    {%- endif -%}

  </div>
</section>

{%- endunless -%}


{% comment %} ═══════════════════════════════════════════════
  STYLES
═══════════════════════════════════════════════ {% endcomment %}

<style>

  .leds-collection-products__inner {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
  }

  .section-{{ section.id }}-padding {
    padding-top:    {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top:    {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .leds-collection-products__header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 2.4rem;
  }
  .leds-collection-products__subheading {
    letter-spacing: .12em;
    text-transform: uppercase;
    font-size: 1.2rem;
    margin-bottom: .6rem;
    color: rgba(var(--color-foreground), .65);
  }
  .leds-collection-products__title {
    margin: 0;
  }

  /* ── Carousel wrapper ── */
  .leds-carousel-wrapper {
    position: relative;
  }

  /* ── Track: horizontal scroll container ── */
  .leds-collection-products__grid {
    list-style: none;
    margin: 0;
    padding: 0 2px; /* tiny side room so card shadow is not clipped */
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;   /* Firefox */
  }
  .leds-collection-products__grid::-webkit-scrollbar {
    display: none;           /* Chrome / Safari */
  }

  /* ── Each slide: fixed width based on desktop column count ── */
  .leds-carousel__slide {
    flex: 0 0 calc((100% - ({{ columns }} - 1) * {{ section.settings.card_gap }}px) / {{ columns }});
    min-width: 0;
  }


  @media screen and (max-width: 749px) {
  .leds-carousel__slide {
    flex: 0 0 calc((100% - 1 * {{ section.settings.card_gap }}px) / {{ section.settings.columns_mobile }});
  }
  #section-{{ section.id }} {
    padding-left: 16px;
    padding-right: 16px;
  }
}
  
  }



  /* ── Product card ── */
  .leds-product-card {
    position: relative;
    background: rgb(var(--color-background));
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    transition: box-shadow .25s ease, transform .25s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .leds-product-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgb(var(--color-background));
  }
  .leds-product-card__image--placeholder {
    padding: 20px;
    background: rgba(var(--color-foreground), .04);
  }

  .leds-product-card__badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    z-index: 2;
  }
  .leds-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: .03em;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0,0,0,.18);
  }
  .leds-badge--sale      { background: #e02020; color: #fff; }
  .leds-badge--sold-out  { background: rgba(20,20,20,.82); color: #fff; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
  .leds-badge__icon      { width: 11px; height: 11px; fill: rgba(255,255,255,.85); flex-shrink: 0; }

.leds-product-card__info {
  padding: 1.2rem 1.4rem 1.6rem;
  display: flex;
  flex-direction: column;
  gap: .1rem;   /* reduced from .5rem */
  flex: 1;
}
  .leds-product-card__vendor {
    font-size: 1.1rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), .6);
    margin: 0;
  }
.leds-product-card__title {
  margin: 0;
  font-size: 1.4rem;
  font-weight: 600;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
  .leds-product-card__title-link { color: inherit; text-decoration: none; }
  .leds-product-card__title-link:hover { text-decoration: none; }

  .leds-product-card__rating { display: flex; gap: 1px; }
  .leds-star                  { font-size: 1.3rem; }
  .leds-star--full            { color: #f0a500; }
  .leds-star--empty           { color: rgba(var(--color-foreground), .25); }

  .leds-product-card__price {
    display: flex;
    align-items: baseline;
    gap: .6rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: .4rem;
  }
  .leds-product-card__price--sale    { font-weight: 700; color: #e02020; font-size: 1.5rem; }
  .leds-product-card__price--compare { font-size: 1.2rem; color: rgba(var(--color-foreground), .45); text-decoration: line-through; }
  .leds-product-card__price--regular { font-weight: 600; }
  .leds-product-card__price--savings {
    display: inline-block;
    background: #fff0f0;
    color: #c41a1a;
    border: 1px solid #f5c0c0;
    border-radius: 20px;
    font-size: 1.05rem;
    font-weight: 700;
    padding: 1px 8px;
    letter-spacing: .02em;
  }

  .leds-collection-products__cta { margin-top: 3.6rem; text-align: center; }

</style>


{% comment %} ═══════════════════════════════════════════════
  JAVASCRIPT – carousel + auto-scroll
═══════════════════════════════════════════════ {% endcomment %}

<script>
(function () {
  const SECTION_ID   = {{ section.id | json }};
  const track        = document.getElementById('leds-track-' + SECTION_ID);
  if (!track) return;

  const autoScroll   = track.dataset.autoScroll === 'true';
  const speedSec     = parseFloat(track.dataset.scrollSpeed) || 3;
  const speedMs      = speedSec * 1000;

  /* ── helpers ── */
  function getSlideWidth() {
    const slide = track.querySelector('.leds-carousel__slide');
    if (!slide) return 0;
    const gap = parseFloat(getComputedStyle(track).gap) || 0;
    return slide.offsetWidth + gap;
  }

  function scrollBySlide(dir) {
    track.scrollBy({ left: dir * getSlideWidth(), behavior: 'smooth' });
  }


  /* ── auto-scroll ── */
  if (!autoScroll) return;

  let timer = null;

  function step() {
    /* If we've reached (or passed) the end, jump back to start */
    const maxScroll = track.scrollWidth - track.clientWidth;
    if (track.scrollLeft >= maxScroll - 2) {
      track.scrollTo({ left: 0, behavior: 'smooth' });
    } else {
      scrollBySlide(1);
    }
  }

  function startTimer() {
    timer = setInterval(step, speedMs);
  }

  function resetTimer() {
    clearInterval(timer);
    startTimer();
  }

  /* pause on hover / touch */
  track.addEventListener('mouseenter', function () { clearInterval(timer); });
  track.addEventListener('mouseleave', startTimer);
  track.addEventListener('touchstart',  function () { clearInterval(timer); }, { passive: true });
  track.addEventListener('touchend',   startTimer,  { passive: true });

  startTimer();
})();
</script>


