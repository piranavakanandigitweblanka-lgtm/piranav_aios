{% schema %}
{
  "name": "Weekend Deals",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Weekend Deals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    /* COUNTDOWN TIMER SETTINGS */
    {
      "type": "text",
      "id": "end_date",
      "label": "Timer End Date (DD/MM/YYYY)",
      "info": "Enter date in DD/MM/YYYY format. Timer counts down to 23:59 on this date."
    },
    {
      "type": "color",
      "id": "timer_bg_color",
      "label": "Timer Background Color",
      "default": "#1a1a1a"
    },

    /* AUTOPLAY SETTINGS */
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoscroll Speed (seconds)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    },

    /* NEW BADGE TEXT SETTING */
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "BLACK DEAL"
    },

    /* BADGE COLOR SETTINGS */
    {
      "type": "color",
      "id": "badge_color_1",
      "label": "Badge Color 1",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "badge_color_2",
      "label": "Badge Color 2",
      "default": "#c08402"
    },

    /* VIEW COLLECTION BUTTON SETTINGS */
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View Collection"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show View Collection Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Weekend Deals"
    }
  ]
}
{% endschema %}

<div class="hvc-wrapper">

  <div class="hvc-header-row">
    {% if section.settings.section_heading != blank %}
      <div class="hvc-section-heading">
        <h2>{{ section.settings.section_heading }}</h2>
      </div>
    {% endif %}

    <div class="hvc-countdown-timer" style="background: {{ section.settings.timer_bg_color }};">
      <div class="timer-box">
        <span class="timer-value" id="days">00</span>
      </div>
      <div class="timer-separator">:</div>
      <div class="timer-box">
        <span class="timer-value" id="hours">00</span>
      </div>
      <div class="timer-separator">:</div>
      <div class="timer-box">
        <span class="timer-value" id="minutes">00</span>
      </div>
      <div class="timer-separator">:</div>
      <div class="timer-box">
        <span class="timer-value" id="seconds">00</span>
      </div>
    </div>
  </div>

  <div class="hvc-frame">
    <div class="hvc-container">

      {% assign coll = collections[section.settings.collection] %}

      {% if coll != blank %}
        {% for product in coll.products %}

        <a href="{{ product.url }}" class="hvc-item">

          <!-- BADGE OUTSIDE IMAGE - TOP LEFT -->
          <div class="hvc-badge" style="background: linear-gradient(to right, {{ section.settings.badge_color_1 }} 42%, {{ section.settings.badge_color_2 }} 50%);">
            {{ section.settings.badge_text }}
          </div>

          <div class="hvc-image">
            <img src="{{ product.featured_image | img_url: '600x600' }}" class="main-img"/>

    
          </div>

          <div class="hvc-info">
            <div class="hvc-price">

              {% comment %} Always use the first variant for accurate price display {% endcomment %}
              {% assign first_variant = product.variants.first %}
              {% assign first_price = first_variant.price %}
              {% assign first_compare = first_variant.compare_at_price %}

              <span class="price">{{ first_price | money }}</span>

              {% if first_compare and first_compare > 0 and first_compare > first_price %}
                <span class="compare">{{ first_compare | money }}</span>

                {% assign diff = first_compare | minus: first_price %}
                {% assign percent = diff | times: 100.0 | divided_by: first_compare %}
                <span class="discount">-{{ percent | round }}%</span>
              {% endif %}

            </div>

            <div class="hvc-title">{{ product.title }}</div>
          </div>

        </a>

        {% endfor %}
      {% else %}
        <p>Select a collection in settings.</p>
      {% endif %}

    </div>
  </div>

  <!-- VIEW COLLECTION BUTTON -->
  {% if section.settings.show_button and coll != blank %}
    <div class="hvc-button-row">
      <a href="{{ coll.url }}" class="hvc-view-btn">
        {{ section.settings.button_text }}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  {% endif %}

</div>

<style>
.hvc-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 5px;
  margin-left: -30px;
  margin-top: -10px;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
}

.hvc-header-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 20px;
}

.hvc-section-heading {
  grid-column: 2;
  text-align: center;
}

.hvc-countdown-timer {
  grid-column: 3;
  justify-self: end;
}

.hvc-section-heading h2 {
  font-size: 25px;
  font-weight: 500;
  color: #333;
  margin: 0;
}

/* COUNTDOWN TIMER */
.hvc-countdown-timer {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 8px 16px;
  border-radius: 6px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  background: {{ section.settings.timer_bg_color }};
}

.timer-box {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 32px;
}

.timer-value {
  font-size: 18px;
  font-weight: 700;
  color: #fff;
  line-height: 1;
  font-family: 'Courier New', monospace;
}

.timer-label {
  font-size: 11px;
  color: #999;
  text-transform: uppercase;
  margin-top: 4px;
  font-weight: 500;
}

.timer-separator {
  font-size: 18px;
  font-weight: 700;
  color: #c08402;
  margin: 0 2px;
  line-height: 1;
}

.hvc-frame {
  width: 1330px;
  max-width: 100%;
  overflow-x: auto;
  scrollbar-width: none;
  display: flex;
  gap: 20px;
  margin: 0;
  padding: 0;
}

.hvc-frame::-webkit-scrollbar {
  display: none;
}

.hvc-container {
  display: flex;
  gap: 20px;
  width: max-content;
  padding: 0;
  margin: 0;
}

.hvc-item {
  width: 220px;
  text-decoration: none;
  color: inherit;
  position: relative;
}

/* BADGE OUTSIDE IMAGE */
.hvc-badge {
  position: absolute;
  top: -5px;
  left: -5px;
  color: #fff;
  padding: 3px 9px;
  font-size: 10px;
  font-weight: 650;
  border-radius: 4px;
  z-index: 50;
  letter-spacing: 0.8px;
}

.hvc-image {
  position: relative;
  overflow: hidden;
}

.hvc-image img.main-img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  transition: 0.2s ease;
}



.hvc-price {
  margin-top: 10px;
  font-size: 17px;
  font-weight: 600;
}

.compare {
  text-decoration: line-through;
  margin-left: 5px;
  color: #777;
}

.discount {
  background:rgb(192, 125, 0);
  padding: 2px 6px;
  font-size: 13px;
  margin-left: 5px;
  color: white;
  font-weight: 600;
  border-radius: 4px;
}

.hvc-title {
  margin-top: 6px;
  font-size: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* VIEW COLLECTION BUTTON */
.hvc-button-row {
  display: flex;
  justify-content: center;
  padding: 16px 20px 10px;
}

.hvc-view-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #fff;
  color: #111;
  text-decoration: none;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  padding: 7px 16px;
  border-radius: 4px;
  border: 1px solid #111;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
}

.hvc-view-btn:hover {
  background: #111;
  color: #fff;
}

.hvc-view-btn svg {
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.hvc-view-btn:hover svg {
  transform: translateX(3px);
  stroke: #fff;
}

@media only screen and (max-width: 768px) {
  .hvc-wrapper {
    padding-left: 20px;
    padding-right: 20px;
  }

  .hvc-header-row {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 15px 10px;
  }

  .hvc-section-heading h2 {
    font-size: 18px;
    max-width: 150px;
    line-height: 1.2;
  }

  .hvc-countdown-timer {
    padding: 6px 10px;
    gap: 2px;
  }

  .timer-box {
    min-width: 24px;
  }

  .timer-value {
    font-size: 14px;
  }

  .timer-separator {
    font-size: 14px;
    margin: 0 1px;
  }

  .hvc-view-btn {
    font-size: 11px;
    padding: 6px 13px;
  }
}
</style>

<script>
(function () {
  var endDateStr = {{ section.settings.end_date | json }};

  function berlinToUTCMs(str) {
    try {
      var parts = str.trim().split(/\s+/);
      var d = parts[0].split('/');
      var t = (parts[1] || '23:59').split(':');
      var iso = d[2] + '-' + d[1].padStart(2,'0') + '-' + d[0].padStart(2,'0') +
                'T' + t[0].padStart(2,'0') + ':' + t[1].padStart(2,'0') + ':00Z';
      var utcMs = new Date(iso).getTime();
      if (isNaN(utcMs)) return Infinity;
      var fmt = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Europe/Berlin', year:'numeric', month:'2-digit', day:'2-digit',
        hour:'2-digit', minute:'2-digit', second:'2-digit',
        hour12: false, hourCycle: 'h23'
      });
      var p = {};
      fmt.formatToParts(new Date(utcMs)).forEach(function (x) {
        if (x.type !== 'literal') p[x.type] = +x.value;
      });
      var bMs = Date.UTC(p.year, p.month - 1, p.day, p.hour, p.minute, p.second);
      return utcMs + (utcMs - bMs);
    } catch (e) { return Infinity; }
  }

  var endMs = endDateStr ? berlinToUTCMs(endDateStr + ' 23:59') : Infinity;

  function updateCountdown() {
    var diff = endMs - Date.now();
    var dEl = document.getElementById('days');
    var hEl = document.getElementById('hours');
    var mEl = document.getElementById('minutes');
    var sEl = document.getElementById('seconds');
    if (!dEl) return;
    if (diff <= 0) {
      dEl.textContent = hEl.textContent = mEl.textContent = sEl.textContent = '00';
      return;
    }
    dEl.textContent = String(Math.floor(diff / 86400000)).padStart(2, '0');
    hEl.textContent = String(Math.floor((diff % 86400000) / 3600000)).padStart(2, '0');
    mEl.textContent = String(Math.floor((diff % 3600000) / 60000)).padStart(2, '0');
    sEl.textContent = String(Math.floor((diff % 60000) / 1000)).padStart(2, '0');
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);

  var autoplay = {{ section.settings.autoplay | json }};
  var speed = {{ section.settings.autoplay_speed | json }} * 1000;
  if (autoplay) {
    var frame = document.querySelector('.hvc-frame');
    if (frame) {
      setInterval(function () {
        if (frame.scrollLeft + frame.clientWidth >= frame.scrollWidth - 5) {
          frame.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          frame.scrollBy({ left: 240, behavior: 'smooth' });
        }
      }, speed);
    }
  }
})();
</script>
