{% comment %}
  Section: Code Copy Section
  7 vertical items with image, heading, code, and copy button
{% endcomment %}

<div class="code-copy-section">
  <div class="code-copy-container">
    {% for block in section.blocks %}
      <div class="code-item" {{ block.shopify_attributes }}>
        <div class="code-item-inner">
          <!-- Left Side: Image -->
          {% if block.settings.image != blank %}
            <div class="code-image">
              <img src="{{ block.settings.image | img_url: '150x150' }}" 
                   alt="{{ block.settings.heading }}" 
                   loading="lazy">
            </div>
          {% endif %}
          
          <!-- Right Side: Content -->
          <div class="code-content">
            <!-- Heading -->
            {% if block.settings.heading != blank %}
              <h3 class="code-heading">{{ block.settings.heading }}</h3>
            {% endif %}
            
            <!-- Description -->
            {% if block.settings.description != blank %}
              <p class="code-description">{{ block.settings.description }}</p>
            {% endif %}
            
            <!-- Code Display -->
            {% if block.settings.code != blank %}
              <div class="code-box">
                <code id="code-{{ block.id }}">{{ block.settings.code }}</code>
              </div>
            {% endif %}
            
            <!-- Buttons -->
            <div class="button-group">
              <button class="copy-button" 
                      data-code-id="code-{{ block.id }}"
                      onclick="copyCode(this)">
                Copy Code
              </button>
              
              {% if block.settings.collection_url != blank %}
                <a href="{{ block.settings.collection_url }}" class="view-collection-button">
                  View Collection
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .code-copy-section {
    padding: 50px 20px;
    background: #fafafa;
  }
  
  .code-copy-container {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  
  .code-item {
    background: #ffffff;
    border-radius: 10px;
    padding: 28px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .code-item:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }
  
  .code-item-inner {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }
  
  .code-image {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .code-image img {
    width: 100%;
    max-width: 200px;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    border: 2px solid #f0f0f0;
  }
  
  .code-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .code-heading {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.3;
  }
  
  .code-description {
    margin: 0;
    font-size: 14px;
    color: #666;
    line-height: 1.6;
  }
  
  .code-box {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 6px;
    padding: 14px 16px;
    overflow-x: auto;
    width: fit-content;
    max-width: 100%;
    text-align: center;
  }
  
  .code-box code {
    font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
    font-size: 13px;
    font-weight: 700;
    color: #e83e8c;
    word-break: break-all;
    white-space: pre-wrap;
  }
  
  .button-group {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  
  .copy-button {
    background:rgb(116, 0, 0);
    color: #ffffff;
    border: none;
    padding: 11px 24px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    min-width: 140px;
    text-align: center;
  }
  
  .copy-button:hover {
    background: #333333;
    transform: translateY(-1px);
  }
  
  .copy-button:active {
    transform: translateY(0);
  }
  
  .copy-button.copied {
    background: #28a745;
  }
  
  .view-collection-button {
    display: inline-block;
    background: #ffffff;
    color:rgb(100, 0, 0);
    border: 2px solid #000000;
    padding: 11px 24px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    min-width: 170px;
    text-align: center;
  }
  
  .view-collection-button:hover {
    background:rgb(2, 123, 0);
    color: #ffffff;
    transform: translateY(-1px);
  }
  
  .view-collection-button:active {
    transform: translateY(0);
  }
  
  @media (max-width: 768px) {
    .code-item-inner {
      flex-direction: column;
      gap: 16px;
    }
    
    .code-heading {
      font-size: 18px;
    }
    
    .button-group {
      flex-direction: column;
      width: 100%;
    }
    
    .copy-button,
    .view-collection-button {
      width: 100%;
    }
  }
</style>

<script>
  function copyCode(button) {
    const codeId = button.getAttribute('data-code-id');
    const codeElement = document.getElementById(codeId);
    const textToCopy = codeElement.textContent;
    
    // Copy to clipboard
    navigator.clipboard.writeText(textToCopy).then(() => {
      // Change button text and style
      const originalText = button.textContent;
      button.textContent = 'Code Copied!';
      button.classList.add('copied');
      
      // Reset after 2.5 seconds
      setTimeout(() => {
        button.textContent = originalText;
        button.classList.remove('copied');
      }, 2500);
    }).catch(err => {
      console.error('Failed to copy code:', err);
      alert('Failed to copy code. Please try again.');
    });
  }
</script>

