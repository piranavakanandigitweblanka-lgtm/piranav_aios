{% comment %} Kuberan make changes for add b2b support page redirect and gmail icon & redirect {% endcomment %} 
{%- liquid
  assign container = section.settings.container
  assign show_topbar = section.settings.show_topbar
  assign bg_topbar = section.settings.background_color
  assign color_topbar = section.settings.text_color
  assign color_hover_topbar = section.settings.text_hover_color
  assign show_mobile = section.settings.show_mobile
  assign show_phone_number = section.settings.show_phone_number
  assign show_email = section.settings.show_email
  assign show_social = section.settings.show_social
  assign show_store_page = section.settings.show_store_page
  assign show_language = section.settings.show_language
  assign show_country = section.settings.show_country
  assign message = section.settings.message
  assign show_message = section.settings.show_message
  assign show_custom_link = section.settings.show_custom_link
  assign custom_link_text = section.settings.custom_link_text
  assign custom_link_url = section.settings.custom_link_url
  assign show_b2b_email_icon = section.settings.show_b2b_email_icon
  assign gmail_icon_link = section.settings.gmail_icon_link
  assign show_extra_link = section.settings.show_extra_link
  assign extra_link_url = section.settings.extra_link_url
  assign extra_link_text = section.settings.extra_link_text
  assign box_alignment = 'justify-content-center'
  if show_phone_number == blank and show_email == blank and show_social == blank
    assign box_alignment = 'justify-content-start'
  elsif show_store_page == blank and show_language == blank and show_country == blank
    assign box_alignment = 'justify-content-end'
  endif
-%}

<style>
  @media (max-width: 768px) {
    .topbar .hide-mobile {
      display: none !important;
    }
    .topbar .col-center {
      display: none !important;
    }
    .topbar .col-right {
      display: none !important;
    }
  }

  .topbar-compact {
    gap: 0;
  }

  .topbar-compact .items-contact {
    margin-right: 0;
  }

  .custom-link-icon {
    width: 14px;
    height: 14px;
    margin-right: 5px;
    transition: transform 0.3s ease;
  }

  .custom-topbar-link:hover .custom-link-icon {
    transform: scale(1.1);
  }

  .topbar-icon-link {
    display: inline-flex;
    align-items: center;
    margin-left: 6px;
    text-decoration: none;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .topbar-icon-link:hover {
    transform: scale(1.15);
    opacity: 0.8;
  }

  .topbar-social-icon {
    width: 18px;
    height: 18px;
  }

  .gmail-icon {
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.1));
  }

  .topbar-separator {
    display: inline-flex;
    align-items: center;
    padding: 0 3px;
    color: inherit;
    opacity: 0.5;
  }

  .custom-topbar-link {
    transition: all 0.3s ease;
    position: relative;
  }

  .custom-topbar-link:hover {
    opacity: 0.7;
    transform: translateY(-1px);
  }

  .custom-topbar-link span {
    transition: color 0.3s ease;
  }

  .custom-topbar-link:hover span {
    color: #00B67A;
  }

  .rating-badge {
    display: inline-flex;
    align-items: center;
    font-family: Arial, sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #333;
  }

  .rating-value {
    font-size: 20px;
    font-weight: bold;
    margin-right: 2px;
  }

  .rating-outof {
    font-size: 14px;
    margin-right: 5px;
    color: #666;
  }

  .rating-star {
    width: 20px;
    height: 20px;
    fill: url(#trustpilot-gradient);
    transition: transform 0.2s;
  }

  .rating-star:hover {
    transform: scale(1.1);
  }

  .rating-badge a {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .col-t.col-left {
  flex-wrap: nowrap !important;
  white-space: nowrap;
}

</style>

{%- if show_topbar -%}
  <div class="topbar border-bottom color-{{ section.settings.color_scheme }} gradient {% if show_phone_number or show_email or show_social or show_store_page or show_language or show_country or show_message %} {% endif %} {% if show_mobile == blank %}d-none-mb{% endif %}">
    <div class="topbar__section">
      <div class="{{ container }} section-full d-flex flex-wrap justify-content-between align-items-center topbar__section-inner">

        {%- if show_phone_number or show_email or show_social or show_custom_link or show_extra_link -%}
          <div class="col-t col-left d-flex flex-wrap align-items-center topbar-compact">

            {%- if show_email -%}
              <a href="mailto:{{ settings.store_email }}" class="items-contact d-flex align-items-center py-5 hide-mobile">
                <span>{{ settings.store_email }}</span>
              </a>
            {%- endif -%}

            {%- if show_email and show_phone_number -%}
              <span class="topbar-separator py-5 hide-mobile">|</span>
            {%- endif -%}

            {%- if show_phone_number -%}
              <a href="tel:{{ settings.store_phone }}" class="items-contact d-flex align-items-center py-5 hide-mobile">
                <span>{{ settings.store_phone }}</span>
              </a>
            {%- endif -%}

            {%- if show_custom_link and custom_link_text != blank and custom_link_url != blank -%}
              {%- if show_phone_number or show_email -%}
                <span class="topbar-separator py-5 hide-mobile">|</span>
              {%- endif -%}
              <div class="d-flex align-items-center py-5">
                <a href="{{ custom_link_url }}" class="items-contact custom-topbar-link d-flex align-items-center">
                  <svg class="custom-link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
                  </svg>
                  <span>{{ custom_link_text }}</span>
                </a>

                {%- if show_b2b_email_icon and gmail_icon_link != blank -%}
                  <a href="{{ gmail_icon_link }}" class="topbar-icon-link" target="_blank" rel="noopener" aria-label="Gmail Link">
                    <svg class="topbar-social-icon gmail-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path fill="#EA4335" d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-.363.12-.7.326-.969l.005-.006C.653 4.126 1.116 3.91 1.636 3.91h.005L12 10.545 22.359 3.91h.005c.52 0 .983.216 1.305.572l.005.006c.206.269.326.606.326.969z"/>
                      <path fill="#34A853" d="M0 19.366V5.457c0-.363.12-.7.331-.975L6.545 9.82v11.184H1.636A1.636 1.636 0 0 1 0 19.366z"/>
                      <path fill="#4285F4" d="M18.545 21.004h3.819c.904 0 1.636-.732 1.636-1.636V5.457c0-.363-.12-.7-.331-.975L18.545 9.82z"/>
                      <path fill="#FBBC04" d="M6.545 9.82l-6.214-5.338.001-.006C.654 4.126 1.117 3.91 1.637 3.91h.005L12 10.545z"/>
                      <path fill="#C5221F" d="M18.545 9.82l6.124-5.338-.001-.006A1.63 1.63 0 0 0 23.363 3.91h-.005L12 10.545z"/>
                    </svg>
                  </a>
                {%- endif -%}

              </div>
            {%- endif -%}

            {%- if show_social -%}
              <div class="py-5 hide-mobile">
                {%- render 'social-media-links' -%}
              </div>
            {%- endif -%}

          </div>
        {%- endif -%}

        {%- if show_message -%}
          <div class="py-5 col-center col-t d-flex align-items-center {{ box_alignment }} {% if show_message and show_phone_number == blank and show_email == blank and show_social == blank and show_store_page == blank and show_language == blank and show_country == blank %}message-center{% endif %}">
            <div class="topbar-message px-6 align-items-center">{{ message }}</div>
          </div>
        {%- endif -%}

        {%- if show_store_page or show_language or show_country -%}
          <div class="col-t col-right d-flex align-items-center justify-content-end">
            {%- if show_store_page and settings.link_store_page and settings.label_location -%}
              
                href="{{ pages[settings.link_store_page].url | default: '#' }}"
                aria-label="Link detail"
                class="py-5"
              >
                {%- if settings.label_location != blank -%}
                  <span>{{ settings.label_location }}</span>
                {%- else -%}
                  <span>{{ pages[settings.link_store_page].title }}</span>
                {%- endif -%}
              </a>
            {%- endif -%}

            {% comment %}review {% endcomment %}
            <div style="display: flex; align-items: center; gap: 10px;">
              <div class="rating-badge">
                <span class="rating-value">4.81</span>
                <span class="rating-outof">/5</span>
                <a href="https://judge.me/reviews/stores/ledsone.de" target="_blank" rel="noopener">
                  <svg class="rating-star" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <defs>
                      <linearGradient id="trustpilot-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" style="stop-color:#00B67A"/>
                        <stop offset="100%" style="stop-color:#007F5F"/>
                      </linearGradient>
                    </defs>
                    <path d="M12 .587l3.668 7.431L24 9.748l-6 5.847 1.416 8.261L12 19.896l-7.416 3.96L6 15.595 0 9.748l8.332-1.73z"/>
                  </svg>
                </a>
              </div>
            </div>

            {%- if show_country -%}
              {%- render 'country-switcher' -%}
            {%- endif -%}
            {%- if show_language -%}
              {%- render 'language-switcher' -%}
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.top-bar.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.top-bar.content"
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:sections.all.layout.label",
      "default": "container",
      "options": [
        { "value": "container", "label": "t:sections.all.layout.options__1.label" },
        { "value": "container-fluid", "label": "t:sections.all.layout.options__2.label" },
        { "value": "strecth-width", "label": "t:sections.all.layout.options__3.label" },
        { "value": "full-width", "label": "t:sections.all.layout.options__4.label" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_topbar",
      "label": "t:sections.top-bar.settings.show_topbar.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.top-bar.settings.color.label"
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "t:sections.top-bar.settings.show_mobile.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.top-bar.Addons"
    },
    {
      "type": "checkbox",
      "id": "show_phone_number",
      "label": "t:sections.top-bar.settings.show_phone_number.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "t:sections.top-bar.settings.show_email.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.top-bar.settings.show_social.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "t:sections.top-bar.settings.show_country.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "t:sections.top-bar.settings.show_language.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_store_page",
      "label": "t:sections.top-bar.settings.show_store_page.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_message",
      "label": "t:sections.top-bar.settings.show_message.label",
      "default": true
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "t:sections.top-bar.settings.message.label",
      "default": "<p></p>"
    },
    {
      "type": "header",
      "content": "Custom Link Settings"
    },
    {
      "type": "checkbox",
      "id": "show_custom_link",
      "label": "Show custom link",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_link_text",
      "label": "Custom link text",
      "default": "For B2B Support"
    },
    {
      "type": "url",
      "id": "custom_link_url",
      "label": "Custom link URL"
    },
    {
      "type": "header",
      "content": "B2B Email Icon Settings"
    },
    {
      "type": "checkbox",
      "id": "show_b2b_email_icon",
      "label": "Show B2B email icon",
      "info": "Display a Gmail icon next to the custom link",
      "default": false
    },
    {
      "type": "url",
      "id": "gmail_icon_link",
      "label": "Gmail icon link URL",
      "info": "URL where the Gmail icon will link to"
    }
  ]
}
{% endschema %}
