{% comment %}
  Section: Collection / Product Slider
  - Horizontal scrolling slider with dot pagination
  - NO arrows
  - Unlimited slides (no block limit)
  - Each slide: image + label, links to collection or product
{% endcomment %}

<section class="cls-section" id="cls-{{ section.id }}">
  <div class="cls-wrapper">

    {% if section.settings.title != blank %}
      <h2 class="cls-heading">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="cls-outer">
      <div class="cls-track-wrap">
        <div class="cls-track" id="cls-track-{{ section.id }}">
          {% for block in section.blocks %}
            <div class="cls-slide" {{ block.shopify_attributes }}>
              <a
                class="cls-slide-link"
                href="{{ block.settings.link_url | default: '#' }}"
                aria-label="{{ block.settings.label }}"
              >
                <div class="cls-img-box">
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | img_url: '600x' }}"
                      alt="{{ block.settings.image.alt | default: block.settings.label }}"
                      loading="lazy"
                      class="cls-img"
                    >
                  {% else %}
                    <div class="cls-placeholder">
                      {{ block.settings.label | default: 'Collection' }}
                    </div>
                  {% endif %}
                </div>
              </a>
              {% if block.settings.label != blank %}
                <span class="cls-label">{{ block.settings.label }}</span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Dot indicators -->
    <div class="cls-dots" id="cls-dots-{{ section.id }}"></div>

  </div>
</section>

<style>
  .cls-section {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
    font-family: {{ section.settings.font_family }};
  }

  .cls-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .cls-heading {
    text-align: center;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin-bottom: 24px;
    letter-spacing: -0.01em;
  }

  .cls-outer {
    width: 100%;
  }

  .cls-track-wrap {
    width: 100%;
    overflow: hidden;
  }

  .cls-track {
    display: flex;
    gap: {{ section.settings.gap }}px;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }

  .cls-slide {
    flex: 0 0 calc((100% - ({{ section.settings.visible_slides | minus: 1 }} * {{ section.settings.gap }}px)) / {{ section.settings.visible_slides }});
    display: flex;
    flex-direction: column;
  }

  .cls-slide-link {
    display: block;
    text-decoration: none;
  }

  .cls-img-box {
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
    background: #eee;
    position: relative;
  }

  .cls-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cls-slide-link:hover .cls-img {
    transform: scale(1.04);
  }

  .cls-img-box::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0);
    transition: background 0.3s ease;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
  }

  .cls-slide-link:hover .cls-img-box::before {
    background: rgba(0,0,0,0.06);
  }

  .cls-label {
    display: block;
    text-align: center;
    margin-top: 10px;
    font-size: {{ section.settings.label_size }}px;
    color: {{ section.settings.label_color }};
    font-weight: {{ section.settings.label_weight }};
    letter-spacing: 0.01em;
  }

  .cls-placeholder {
    width: 100%;
    height: 100%;
    min-height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e5e0d8;
    color: #999;
    font-size: 13px;
  }

  .cls-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .cls-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: {{ section.settings.dot_color_inactive }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }

  .cls-dot.active {
    background: {{ section.settings.dot_color_active }};
    transform: scale(1.2);
  }

  @media (max-width: 900px) {
    .cls-slide {
      flex: 0 0 calc((100% - ({{ section.settings.visible_slides_tablet | minus: 1 }} * {{ section.settings.gap }}px)) / {{ section.settings.visible_slides_tablet }});
    }
  }

  @media (max-width: 560px) {
    .cls-slide {
      flex: 0 0 calc((100% - ({{ section.settings.visible_slides_mobile | minus: 1 }} * {{ section.settings.gap }}px)) / {{ section.settings.visible_slides_mobile }});
    }
  }
</style>

<script>
(function() {
  var sliders = window.__clsSliders = window.__clsSliders || {};

  function init(id) {
    var track = document.getElementById('cls-track-' + id);
    var dotsContainer = document.getElementById('cls-dots-' + id);
    if (!track) return;

    var slides = track.querySelectorAll('.cls-slide');
    var totalSlides = slides.length;
    if (totalSlides === 0) return;

    function getVisible() {
      var w = window.innerWidth;
      if (w <= 560) return parseInt('{{ section.settings.visible_slides_mobile }}') || 2;
      if (w <= 900) return parseInt('{{ section.settings.visible_slides_tablet }}') || 3;
      return parseInt('{{ section.settings.visible_slides }}') || 5;
    }

    var state = { index: 0 };
    sliders[id] = state;

    function totalPages() {
      return Math.ceil(totalSlides / getVisible());
    }

    function clamp(val) {
      return Math.max(0, Math.min(val, totalPages() - 1));
    }

    function getSlideWidth() {
      if (!slides[0]) return 0;
      return slides[0].getBoundingClientRect().width;
    }

    function getGap() {
      return parseInt('{{ section.settings.gap }}') || 16;
    }

    function goTo(page) {
      state.index = clamp(page);
      var visible = getVisible();
      var slideW = getSlideWidth();
      var gap = getGap();
      var offset = state.index * visible * (slideW + gap);
      var maxOffset = (totalSlides - visible) * (slideW + gap);
      if (maxOffset < 0) maxOffset = 0;
      offset = Math.min(offset, maxOffset);
      track.style.transform = 'translateX(-' + offset + 'px)';
      renderDots();
    }

    function renderDots() {
      dotsContainer.innerHTML = '';
      var pages = totalPages();
      if (pages <= 1) return;
      for (var i = 0; i < pages; i++) {
        var dot = document.createElement('button');
        dot.className = 'cls-dot' + (i === state.index ? ' active' : '');
        dot.setAttribute('aria-label', 'Go to page ' + (i + 1));
        dot.setAttribute('data-page', i);
        dot.addEventListener('click', function() {
          goTo(parseInt(this.getAttribute('data-page')));
        });
        dotsContainer.appendChild(dot);
      }
    }

    state.goTo = goTo;
    renderDots();

    /* ✅ TOUCH SWIPE */
    var touchStartX = 0;
    var touchEndX = 0;
    var isDragging = false;

    track.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].clientX;
      isDragging = true;
    }, { passive: true });

    track.addEventListener('touchmove', function(e) {
      if (!isDragging) return;
      touchEndX = e.changedTouches[0].clientX;
    }, { passive: true });

    track.addEventListener('touchend', function() {
      if (!isDragging) return;
      isDragging = false;
      var diff = touchStartX - touchEndX;
      if (Math.abs(diff) < 30) return; // ignore tiny taps
      if (diff > 0) {
        goTo(state.index + 1); // swipe left → next
      } else {
        goTo(state.index - 1); // swipe right → prev
      }
    }, { passive: true });

    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() { goTo(0); }, 200);
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    init('{{ section.id }}');
  });

  document.addEventListener('shopify:section:load', function(e) {
    if (e.detail && e.detail.sectionId === '{{ section.id }}') {
      init('{{ section.id }}');
    }
  });
})();
</script>

{% schema %}
{
  "name": "Collection Slider",
  "tag": "section",
  "class": "collection-slider-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Outdoor Lighting Ideas"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size (px)",
      "min": 16,
      "max": 48,
      "step": 1,
      "default": 26
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label Font Size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label Font Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "text",
      "id": "font_family",
      "label": "Font Family",
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width (px)",
      "min": 800,
      "max": 1800,
      "step": 20,
      "default": 1400
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between slides (px)",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Image Border Radius (px)",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "default": "1/1",
      "info": "e.g. 1/1, 4/3, 3/4, 16/9"
    },
    {
      "type": "range",
      "id": "visible_slides",
      "label": "Visible slides (desktop)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "visible_slides_tablet",
      "label": "Visible slides (tablet)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "visible_slides_mobile",
      "label": "Visible slides (mobile)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "header",
      "content": "Dot Styles"
    },
    {
      "type": "color",
      "id": "dot_color_active",
      "label": "Active Dot Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "dot_color_inactive",
      "label": "Inactive Dot Color",
      "default": "#cccccc"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Collection Name"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL",
          "info": "Link to a collection or product page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Slider",
      "blocks": [
        { "type": "slide", "settings": { "label": "Outdoor Wall Lights" } },
        { "type": "slide", "settings": { "label": "Portable Lamps" } },
        { "type": "slide", "settings": { "label": "Lights with Sensor" } },
        { "type": "slide", "settings": { "label": "Outdoor Spotlights" } },
        { "type": "slide", "settings": { "label": "Solar Lights" } },
        { "type": "slide", "settings": { "label": "String Lights" } },
        { "type": "slide", "settings": { "label": "Garden Lights" } },
        { "type": "slide", "settings": { "label": "Flood Lights" } }
      ]
    }
  ]
}


{% endschema %}
