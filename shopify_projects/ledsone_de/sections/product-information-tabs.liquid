{% # theme-check-disable ContentForHeaderModification %}
{%- capture contentForQuerystring -%}
  {{ content_for_header }}
{%- endcapture -%}
{% # theme-check-enable ContentForHeaderModification %}
{%- assign pageUrl = contentForQuerystring
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | split: request.host
  | last
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
-%}
{%- assign pageQuerystring = pageUrl | split: '?' | last -%}
{%- liquid
  assign st = section.settings
  assign design = st.design
  assign bg_color = st.bg_color
  assign custom_class = st.custom_class
  if pageQuerystring contains 'tab_info='
    assign tab = pageQuerystring | split: 'tab_info=' | last | split: '&' | first
    if tab == 'tab' or tab == 'accordition' or tab == 'show_all'
      assign design = tab
    endif
  endif
  assign position = st.position
  if pageQuerystring contains 'position_tab='
    assign position_tab = pageQuerystring | split: 'position_tab=' | last | split: '&' | first
    if position_tab == 'default'
      assign position = '1'
    elsif position_tab == 'accordions-inner'
      assign position = '2'
    endif
  endif

  assign infomation_meta = product.metafields.bls.information_product_tab

  assign reset_spacing = ''
  if st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
-%}
{%- if section.blocks.size > 0 -%}
  <div
    id="{{ section.id }}"
    class="bls__section color-{{ section.settings.color_scheme }} gradient {{ reset_spacing }} {{ custom_class }} bls__product-tabs design-{{design}}{% if design == 'accordition' and position == '2' %} inside-product-main-infomation d-none{% endif %} {% if design == 'show_all' and st.show_two_column %}show-two-column{% endif %}"
    data-section-type="tabs"
    data-section-id="{{ section.id }}"
  >
    <div class="{{ st.container }} section-full">
      <div class="product info detailed">
        <div class="product data items">
          {%- if design == 'tab' or design == 'accordition' -%}
            {%- if design == 'tab' -%}
              <ul class="nav nav-tabs list-none text-center pl-0 flex flex-wrap justify-content-center mb-40 mt-0">
                {%- for block in section.blocks %}
                  {%- assign bk_st = block.settings -%}
                  {%- assign bk_id = block.id -%}
                  {%- if block.type == 'faq' and product.metafields.custom.faq_schema == blank -%}
                    {%- continue -%}
                  {%- endif -%}
                  <li class="data item{% if forloop.first %} active{% endif %}">
                    <a
                      class="is-nav-tabs heading-weight relative heading-color px-30 py-10 inline-block"
                      href="#{{ block.id }}"
                      data-block-id="proTabs{{ block.id }}"
                      {%- if block.type == 'review' -%}tab-review{%- endif -%}
                      {%- if block.type == '@app' -%}tab-review-app{%- endif -%}
                    >
                      {{- bk_st.title -}}
                      {%- if block.type == '@app' -%}{{ 'products.product.review_app' | t }}{%- endif -%}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <div class="tab-content">
              {%- for block in section.blocks %}
                {%- assign bk_st = block.settings -%}
                {%- assign bk_id = block.id -%}
                {%- if block.type == 'faq' and product.metafields.custom.faq_schema == blank -%}
                  {%- continue -%}
                {%- endif -%}
                <div
                  id="proTabs{{ block.id }}"
                  class="tab-item{% if forloop.first and design == 'accordition' and st.open_first_tab %} active{% endif %}{% if forloop.first and design == 'tab' %} active{% endif %}"
                >
                  <div class="data item title" id="tab-label-{{ bk_id }}">
                    <a
                      class="data accordition relative flex align-items-center"
                      href="javascript:;"
                      data-block-id="proTabs{{ block.id }}"
                      aria-label="Toogle"
                      {%- if block.type == 'review' -%}tab-review{%- endif -%}
                      {%- if block.type == '@app' -%}tab-review-app{%- endif -%}
                    >
                      <span class="txt_h_tab d-blokc w-full heading-color heading-weight">
                        {{- bk_st.title -}}
                        {%- if block.type == '@app' -%}{{ 'products.product.review_app' | t }}{%- endif -%}
                      </span>
                      <span class="open-children-toggle"></span>
                    </a>
                  </div>
                  <div
                    class="tab-panel"
                    {% if forloop.first and design == 'accordition' and st.open_first_tab %}style="display: block;"{% endif %}
                    {% if forloop.first and design == 'tab' %}style="display: block;"{% endif %}
                  >
                    {%- case block.type -%}
                      {%- when '@app' -%}
                        {% render block %}
                      {%- when 'description' -%}
                        {{ product.description }}
                      {%- when 'review' -%}
                        <div id="shopify-product-reviews" data-id="{{ product.id }}">
                          {{ product.metafields.spr.reviews }}
                        </div>
                      {%- when 'custom_tab' -%}
                        {%- assign tab_content = bk_st.tab_content -%}
                        {%- case tab_content -%}
                          {%- when 'content' -%}
                            {{ bk_st.content }}
                          {%- when 'content_page' -%}
                            {%- if bk_st.page != blank -%}{{ pages[bk_st.page].content }}{%- endif -%}
                          {%- when 'content_custom' -%}
                            {%- if infomation_meta.value.information_text != blank -%}
                              {{ infomation_meta.value.information_text }}
                            {%- elsif infomation_meta.value.information_in_page != blank -%}
                              {{ pages[infomation_meta.value.information_in_page].content }}
                            {%- else -%}
                              {%- if bk_st.page != blank -%}{{ pages[bk_st.page].content }}{%- endif -%}
                            {%- endif -%}
                        {%- endcase -%}
                      {%- when 'faq' -%}
                        {% comment %} {{ product.metafields.custom.faq_schema }} {% endcomment %}
                        <div
                          id="faq-ui-{{ block.id }}"
                          class="product-faq-wrapper"
                          data-faq-block="{{ block.id }}"
                          {%- if bk_st.faq_sub_heading != blank %}data-faq-heading="{{ bk_st.faq_sub_heading | escape }}"{%- endif %}
                        ></div>
                    {%- endcase -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>

          {%- else -%}
            {%- for block in section.blocks %}
              {%- assign bk_st = block.settings -%}
              {%- assign bk_id = block.id -%}
              {%- if block.type == 'faq' and product.metafields.custom.faq_schema == blank -%}
                {%- continue -%}
              {%- endif -%}
              <div
                class="tab-content-all"
                {%- if block.type == 'review' -%}tab-review{%- endif -%}
                {%- if block.type == '@app' -%}tab-review-app{%- endif -%}
              >
                <div class="data item title" id="tab-label-{{ bk_id }}">
                  <h4 id="tab-label-{{ bk_id }}-title">
                    {{ bk_st.title }}
                    {%- if block.type == '@app' -%}{{ 'products.product.review_app' | t }}{%- endif -%}
                  </h4>
                </div>
                <div class="tab-panel">
                  {%- case block.type -%}
                    {%- when 'description' -%}
                      {{ product.description }}
                    {%- when 'review' -%}
                      <div id="shopify-product-reviews" data-id="{{ product.id }}">
                        {{ product.metafields.spr.reviews }}
                      </div>
                    {%- when '@app' -%}
                      {% render block %}
                    {%- when 'custom_tab' -%}
                      {%- assign tab_content = bk_st.tab_content -%}
                      {%- case tab_content -%}
                        {%- when 'content' -%}
                          {{ bk_st.content }}
                        {%- when 'content_page' -%}
                          {%- if bk_st.page != blank -%}{{ pages[bk_st.page].content }}{%- endif -%}
                      {%- endcase -%}
                    {%- when 'faq' -%}
                      {% comment %} {{ product.metafields.custom.faq_schema }} {% endcomment %}
                      <div
                        id="faq-ui-{{ block.id }}"
                        class="product-faq-wrapper"
                        data-faq-block="{{ block.id }}"
                        {%- if bk_st.faq_sub_heading != blank %}data-faq-heading="{{ bk_st.faq_sub_heading | escape }}"{%- endif %}
                      ></div>
                  {%- endcase -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

<style>
  /* ── FAQ accordion ── */
  .product-faq-wrapper {
    margin-top: 24px;
    padding: 0 2px;
  }

  .faq-sub-heading {
    font-size: 22px !important;
    font-weight: 700 !important;
    margin: 0 0 20px 0 !important;
    line-height: 1.3 !important;
    color: inherit;
  }

  /*
   * Div-based accordion — avoids <details> being overridden by theme CSS/JS.
   * Opened state is controlled by the .faq-is-open class toggled in JS.
   */
  .faq-item {
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    margin-bottom: 10px;
    overflow: hidden;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
    background: transparent;
  }

  .faq-item.faq-is-open {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.09);
    border-color: #999;
  }

  /* Trigger button row */
  .faq-item__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 18px 22px;
    gap: 16px;
    cursor: pointer;
    background: transparent;
    border: none;
    outline: none;
    text-align: left;
    color: inherit;
    font-family: inherit;
    -webkit-appearance: none;
    appearance: none;
  }

.faq-item__trigger:hover {
  background: transparent;
  color: inherit !important;
}

  .faq-item__trigger:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  .faq-item__trigger-text {
    flex: 1;
    font-size: 16px !important;
    font-weight: 700 !important;
    line-height: 1.45 !important;
    color: inherit !important; 
    color: inherit;
    font-family: inherit;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Circle + icon, rotates 45deg to × when open */
  .faq-toggle-icon {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease, opacity 0.2s ease;
    opacity: 0.55;
    pointer-events: none;
  }

  .faq-item.faq-is-open .faq-toggle-icon {
    transform: rotate(45deg);
    opacity: 1;
  }

  .faq-toggle-icon svg {
    width: 14px;
    height: 14px;
    display: block;
    stroke: currentColor;
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  /* Answer — hidden by default, .faq-is-open on parent reveals it */
  .faq-item__body {
    display: none;
    padding: 4px 22px 22px 22px;
    font-size: 15px !important;
    line-height: 1.8 !important;
    color: inherit;
    font-family: inherit;
    opacity: 0.85;
  }

  .faq-item.faq-is-open .faq-item__body {
    display: block;
  }
</style>

<script>
  (function () {
    'use strict';

    /* Tag every FAQPage JSON-LD script with its parsed data */
    function parseFaqScripts() {
      document.querySelectorAll('script[type="application/ld+json"]').forEach(function (el) {
        if (el._faqParsed) return;
        try {
          var data = JSON.parse(el.textContent);
          if (data && data['@type'] === 'FAQPage' && Array.isArray(data.mainEntity)) {
            el._faqParsed = data.mainEntity;
          }
        } catch (_) {}
      });
    }

    /* Build the accordion inside one container div */
    function buildFaqUI(container) {
      if (container.innerHTML.trim() !== '') return; // already built

      /* Find the JSON-LD script that Liquid rendered directly before this div */
      var faqList = null;
      var sibling = container.previousElementSibling;
      while (sibling) {
        if (
          sibling.tagName === 'SCRIPT' &&
          sibling.getAttribute('type') === 'application/ld+json' &&
          sibling._faqParsed
        ) {
          faqList = sibling._faqParsed;
          break;
        }
        sibling = sibling.previousElementSibling;
      }

      /* Fallback: grab the first FAQPage script anywhere on the page */
      if (!faqList) {
        var any = document.querySelector('script[type="application/ld+json"]');
        if (any && any._faqParsed) faqList = any._faqParsed;
      }

      if (!faqList || !faqList.length) return;

      /* Build HTML */
      var html = '';
      var headingText = container.getAttribute('data-faq-heading');
      if (headingText) {
        html += '<p class="faq-sub-heading">' + headingText + '</p>';
      }

      faqList.forEach(function (item, idx) {
       if (item['@type'] !== 'Question' || !item.acceptedAnswer || !item.name || !item.name.trim()) return;
        var bodyId = container.id + '-body-' + idx;
        html +=
          '<div class="faq-item">' +
            '<button type="button" class="faq-item__trigger" aria-expanded="false" aria-controls="' + bodyId + '">' +
              '<span class="faq-item__trigger-text">' + item.name + '</span>' +
              '<span class="faq-toggle-icon" aria-hidden="true">' +
                '<svg viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">' +
                  '<line x1="7" y1="1" x2="7" y2="13"/>' +
                  '<line x1="1" y1="7" x2="13" y2="7"/>' +
                '</svg>' +
              '</span>' +
            '</button>' +
            '<div class="faq-item__body" id="' + bodyId + '">' +
              item.acceptedAnswer.text +
            '</div>' +
          '</div>';
      });

      container.innerHTML = html;

      /* Attach click handlers */
      container.querySelectorAll('.faq-item__trigger').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var item = btn.closest('.faq-item');
          var opening = !item.classList.contains('faq-is-open');
          item.classList.toggle('faq-is-open', opening);
          btn.setAttribute('aria-expanded', String(opening));
        });
      });
    }

    function buildAll() {
      parseFaqScripts();
      document.querySelectorAll('[data-faq-block]').forEach(buildFaqUI);
    }

    /* Run on load */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', buildAll);
    } else {
      buildAll();
    }

    /* Re-run when Shopify theme editor reloads the section or a tab is revealed */
    document.addEventListener('shopify:section:load', buildAll);
    document.addEventListener('tab:shown', buildAll);
  })();
</script>

{% schema %}
{
  "name": "t:sections.product-information-tabs.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "t:sections.all.layout.label",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "t:sections.all.layout.options__1.label"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.all.layout.options__2.label"
        },
        {
          "value": "strecth-width",
          "label": "t:sections.all.layout.options__3.label"
        },
        {
          "value": "full-width",
          "label": "t:sections.all.layout.options__4.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.product-information-tabs.settings.color_scheme.label"
    },
    {
      "type": "select",
      "id": "design",
      "label": "t:sections.product-information-tabs.settings.design.label",
      "default": "tab",
      "options": [
        {
          "value": "tab",
          "label": "t:sections.product-information-tabs.settings.design.options__1.label"
        },
        {
          "value": "accordition",
          "label": "t:sections.product-information-tabs.settings.design.options__2.label"
        },
        {
          "value": "show_all",
          "label": "t:sections.product-information-tabs.settings.design.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:sections.product-information-tabs.settings.position.label",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "t:sections.product-information-tabs.settings.position.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.product-information-tabs.settings.position.options__2.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "open_first_tab",
      "label": "t:sections.product-information-tabs.settings.open_first_tab.label",
      "info": "t:sections.product-information-tabs.settings.open_first_tab.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_two_column",
      "label": "t:sections.product-information-tabs.settings.show_two_column.label",
      "info": "t:sections.product-information-tabs.settings.show_two_column.info",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.product-information-tabs.settings.custom_class.label"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "t:sections.product-information-tabs.settings.reset_spacing.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "description",
      "name": "t:sections.all.section_header.description",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.product-information-tabs.blocks.description.settings.title.label",
          "default": "Description"
        }
      ]
    },
    {
      "type": "review",
      "name": "t:sections.product-information-tabs.blocks.review.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.product-information-tabs.blocks.review.settings.title.label",
          "default": "Review"
        }
      ]
    },
    {
      "type": "custom_tab",
      "name": "t:sections.product-information-tabs.blocks.custom_tab.name",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.title.label",
          "default": "Custom Tab"
        },
        {
          "type": "select",
          "id": "tab_content",
          "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.tab_content.label",
          "default": "content",
          "options": [
            {
              "value": "content",
              "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.tab_content.options__1.label"
            },
            {
              "value": "content_page",
              "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.tab_content.options__2.label"
            },
            {
              "value": "content_custom",
              "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.tab_content.options__3.label"
            }
          ]
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.content.label",
          "default": "<p></p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.page.label"
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQs",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab label",
          "default": "FAQs",
          "info": "Text shown on the tab or accordion header."
        },
        {
          "type": "text",
          "id": "faq_sub_heading",
          "label": "Sub-section heading",
          "default": "Frequently Asked Questions",
          "info": "Optional heading shown above the FAQ list. Leave blank to hide."
        }
      ]
    }
  ]
}
{% endschema %}
