<!--  SORT + FILTER TOOLBAR -->
<div class="ccp-toolbar-wrapper">
  <div class="ccp-toolbar">

    <!-- FILTER BUTTON LEFT -->
    <button id="ccp-filter-open" class="ccp-filter-btn">
      <svg width="18" height="18" fill="currentColor">
        <path d="M3 5h12v2H3zm4 4h4v2H7zm2 4h0v2h0z"/>
      </svg>
      Filter
    </button>

    <!-- SORT BY DROPDOWN RIGHT -->
    <form id="ccp-sortby-form" class="ccp-sortby">
      <label for="ccp-sort">Sortieren nach:</label>
      <select id="ccp-sort" name="sort_by">
        {% for option in collection.sort_options %}
          <option value="{{ option.value }}"
            {% if option.value == collection.sort_by %}selected{% endif %}>
            {{ option.name }}
          </option>
        {% endfor %}
      </select>
    </form>

  </div>
</div>

<!--  ACTIVE FILTER TAGS  -->
{% if collection.filters.size > 0 %}
<div class="ccp-active-filters">
  {% for filter in collection.filters %}
    {% for active in filter.active_values %}
      <a href="{{ active.url_to_remove }}" class="ccp-tag">{{ active.label }} ✕</a>
    {% endfor %}
  {% endfor %}

  {% if collection.url_to_remove_all_filters %}
    <a href="{{ collection.url_to_remove_all_filters }}" class="ccp-clear">Clear all</a>
  {% endif %}
</div>
{% endif %}

<!-- FILTER DRAWER -->
<div id="ccp-filter-drawer" class="ccp-drawer">
  <div class="ccp-drawer-header">
    <h3>Filter</h3>
    <button id="ccp-filter-close" class="ccp-close">✕</button>
  </div>

  <div class="ccp-drawer-body">
    {% for filter in collection.filters %}
      <div class="ccp-filter-block">
        <h4>{{ filter.label }}</h4>

        {% case filter.type %}

        {% when 'list' %}
          {% for value in filter.values %}
            <label class="ccp-filter-option">
              <input type="checkbox" data-url="{{ value.url_to_add }}" {% if value.active %}checked{% endif %}>
              {{ value.label }} ({{ value.count }})
            </label>
          {% endfor %}

        {% when 'price_range' %}
          <form action="{{ filter.url_to_add }}" class="ccp-price-form">
            <input type="number" name="{{ filter.min_value.param_name }}" placeholder="Min" value="{{ filter.min_value.value | money_without_currency }}">
            <input type="number" name="{{ filter.max_value.param_name }}" placeholder="Max" value="{{ filter.max_value.value | money_without_currency }}">
            <button type="submit">Apply</button>
          </form>

        {% endcase %}
      </div>
    {% endfor %}
  </div>
</div>

<!-- DARK OVERLAY  -->
<div id="ccp-filter-overlay" class="ccp-overlay"></div>


{% assign selected_collection = collection %}

{% comment %}
  Read colour filter from section settings.
  In Theme Editor → go to this section → type the colour keyword e.g. "Grün" or "Rot" or "Blue".
  Leave it empty to show ALL products (no colour filter).
  You can type multiple colours separated by comma e.g. "grün,green,vert"
{% endcomment %}
{% assign raw_color_setting = section.settings.variant_color | downcase | strip %}
{% assign color_keywords = raw_color_setting | split: ',' %}

<div class="custom-collection-wrapper">

  {% if selected_collection %}

    {% paginate selected_collection.products by 250 %}

    <div class="product-grid" id="ccp-product-grid">
      {% for product in selected_collection.products %}

        {% comment %} — Match variant against colour keywords set in Theme Editor — {% endcomment %}
        {% assign has_match = false %}
        {% assign selected_variant = product.selected_or_first_available_variant %}

        {% if raw_color_setting == blank %}

          {% comment %} No colour set in settings → show all products {% endcomment %}
          {% assign has_match = true %}

        {% else %}

          {% for variant in product.variants %}
            {% assign v_title = variant.title | downcase %}
            {% for keyword in color_keywords %}
              {% assign kw = keyword | strip %}
              {% if v_title contains kw %}
                {% assign selected_variant = variant %}
                {% assign has_match = true %}
                {% break %}
              {% endif %}
            {% endfor %}
            {% if has_match %}{% break %}{% endif %}
          {% endfor %}

        {% endif %}

        {% if has_match %}
          <div class="product-card" style="display:none;">

            {% assign published_time = product.published_at | default: product.created_at | date: '%s' %}
            {% assign now_time = 'now' | date: '%s' %}
            {% assign days_since_published = now_time | minus: published_time | divided_by: 86400 %}

            {% if days_since_published <= 7 %}
              <span class="new-badge">Neu</span>
            {% endif %}

            {% if selected_variant.compare_at_price > selected_variant.price %}
              {% assign discount = selected_variant.compare_at_price | minus: selected_variant.price %}
              {% assign percent = discount | times: 100.0 | divided_by: selected_variant.compare_at_price %}
              <span class="offer-badge">{{ percent | floor }}% OFF</span>
            {% endif %}

            {% if section.settings.show_badge and days_since_published > 7 %}
              <span class="deal-badge">{{ section.settings.badge_text }}</span>
            {% endif %}

            <div class="product-image-wrapper">
              <a href="{{ product.url }}?variant={{ selected_variant.id }}">
                {% assign display_image = product.featured_image %}
                {% if selected_variant.featured_image %}
                  {% assign display_image = selected_variant.featured_image %}
                {% endif %}
                <img class="main-image" src="{{ display_image | img_url: '500x' }}" alt="{{ product.title }}">
              </a>
            </div>

            <div class="product-info">
              <a href="{{ product.url }}?variant={{ selected_variant.id }}" class="product-title-link">
                <h3 class="product-title">{{ product.title }}</h3>
              </a>

              <div class="jdgm-widget jdgm-preview-badge" data-id='{{ product.id }}' data-auto-install='false'>
                {{ product.metafields.judgeme.badge }}
              </div>

              <div class="price-wrapper">
                {% if selected_variant.compare_at_price > selected_variant.price %}
                  <span class="sale-price">{{ selected_variant.price | money }}</span>
                  <span class="compare-price">{{ selected_variant.compare_at_price | money }}</span>
                {% else %}
                  <span class="regular-price">{{ selected_variant.price | money }}</span>
                {% endif %}

                {% if selected_variant.available %}
                  <span class="stock-status in-stock">✓ auf Lager</span>
                {% else %}
                  <span class="stock-status out-of-stock">Ausverkauft</span>
                {% endif %}
              </div>
            </div>

          </div>
        {% endif %}

      {% endfor %}
    </div>

    <!-- PAGINATION BUILT BY JS BASED ON REAL MATCHED PRODUCT COUNT -->
    <div class="custom-pagination-wrapper" id="ccp-pagination"></div>

    {% endpaginate %}

  {% else %}
    <p>No collection found.</p>
  {% endif %}
</div>

<style>
.ccp-toolbar-wrapper {
  max-width: 1220px;
  margin: 0 auto;
  padding: 0 15px;
}

.ccp-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 25px 0 20px;
}

.ccp-filter-btn {
  padding: 7px 14px;
  background: #000;
  color: #fff;
  border: none;
  border-radius: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  cursor: pointer;
}

.ccp-sortby select {
  font-size: 14px;
  padding: 7px 10px;
  border-radius: 5px;
  border: 1px #fff;
}

.ccp-active-filters {
  max-width: 1220px;
  margin: 10px auto 20px;
  padding-left: 10px;
  padding-right: 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.ccp-tag {
  padding: 6px 10px;
  background: #eee;
  border-radius: 4px;
  font-size: 13px;
}

.ccp-clear {
  color: red;
  font-weight: 600;
}

.ccp-drawer {
  position: fixed;
  top: 0;
  right: -350px;
  width: 320px;
  height: 100%;
  background: #fff;
  z-index: 99999;
  transition: 0.35s ease;
  box-shadow: -2px 0 8px rgba(0,0,0,0.16);
  padding: 20px;
  overflow-y: auto;
}

.ccp-drawer.active { right: 0; }

.ccp-drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ccp-close {
  background: transparent;
  border: none;
  font-size: 22px;
}

.ccp-filter-block { margin-top: 20px; }

.ccp-filter-option {
  display: flex;
  gap: 10px;
  margin: 8px 0;
  font-size: 14px;
}

.ccp-overlay {
  display: none;
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.45);
  z-index: 9999;
}

.ccp-overlay.active { display: block; }

.ccp-price-form { margin-top: 30px; }
.ccp-price-form input { margin-bottom: 8px; }

.custom-collection-wrapper {
  max-width: 1200px;
  margin: auto;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.product-card {
  position: relative;
  border: 1px solid #ececec;
  padding: 12px;
  background: #ffffff;
  border-radius: 6px;
  transition: 0.2s ease;
  overflow: hidden;
}

.product-card:hover { border-color: rgb(255, 173, 173); }

.product-image-wrapper { position: relative; }

.main-image {
  width: 100%;
  aspect-ratio: 1/1;
  object-fit: contain;
  transition: 0.3s ease;
}

.product-title-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.product-title-link:hover .product-title { color: #4A90E2; }

.product-title {
  font-size: 14px;
  line-height: 1.3;
  height: 36px;
  overflow: hidden;
  margin-bottom: 6px;
  transition: color 0.2s ease;
}

.price-wrapper {
  display: flex;
  gap: 6px;
  align-items: center;
  flex-wrap: wrap;
}

.sale-price    { color: #b3001b; font-weight: 700; }
.compare-price { text-decoration: line-through; color: #888; }

.stock-status              { font-size: 12px; font-weight: 600; margin-left: 4px; }
.stock-status.in-stock     { color: #00a651; }
.stock-status.out-of-stock { color: #d32f2f; }

.offer-badge,
.deal-badge {
  position: absolute;
  top: 0;
  font-size: 12px;
  padding: 5px 10px;
  color: #fff;
  z-index: 10;
}

.new-badge {
  position: absolute;
  top: 0;
  left: 0;
  background: rgb(0, 92, 69);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 5px 6px;
  z-index: 12;
  text-transform: uppercase;
}

.offer-badge { right: 0; background: #008f07; }
.deal-badge  { left: 0;  background: #a80019; }

.custom-pagination-wrapper {
  text-align: center;
  margin: 40px 0 20px;
}

.custom-pagination {
  list-style: none;
  display: inline-flex;
  gap: 16px;
  padding: 0;
  margin: 0;
}

.custom-pagination .circle {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 1.4px solid #ddd;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #111;
  background: #fff;
  font-size: 16px;
  text-decoration: none;
  cursor: pointer;
}

.custom-pagination .circle:hover { border-color: #999; }
.custom-pagination .active { border-color: #000; font-weight: 600; }

@media(max-width:768px){
  .product-grid {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 14px;
  }
}
</style>

<script>
/* ── SORT ── */
document.getElementById('ccp-sort')?.addEventListener('change', function () {
  const url = new URL(window.location.href);
  url.searchParams.set('sort_by', this.value);
  url.searchParams.delete('ccp-page');
  window.location.href = url.toString();
});

/* ── FILTER DRAWER ── */
const drawer  = document.getElementById('ccp-filter-drawer');
const overlay = document.getElementById('ccp-filter-overlay');

document.getElementById('ccp-filter-open')?.addEventListener('click', () => {
  drawer.classList.add('active');
  overlay.classList.add('active');
});

document.getElementById('ccp-filter-close')?.addEventListener('click', () => {
  drawer.classList.remove('active');
  overlay.classList.remove('active');
});

overlay?.addEventListener('click', () => {
  drawer.classList.remove('active');
  overlay.classList.remove('active');
});

document.querySelectorAll('.ccp-filter-option input').forEach(item => {
  item.addEventListener('change', () => {
    window.location.href = item.dataset.url;
  });
});

/* ── JS PAGINATION based on real matched product count ── */
(function () {
  const PER_PAGE = 20;

  const allCards = Array.from(document.querySelectorAll('#ccp-product-grid .product-card'));
  const total    = allCards.length;

  if (total === 0) return;

  const totalPages = Math.ceil(total / PER_PAGE);

  function getCurrentPage() {
    const p = parseInt(new URL(window.location.href).searchParams.get('ccp-page')) || 1;
    return Math.min(Math.max(p, 1), totalPages);
  }

  function showPage(page) {
    const start = (page - 1) * PER_PAGE;
    const end   = start + PER_PAGE;
    allCards.forEach((card, i) => {
      card.style.display = (i >= start && i < end) ? '' : 'none';
    });
    renderPagination(page);
  }

  function renderPagination(current) {
    if (totalPages <= 1) return;
    const wrapper = document.getElementById('ccp-pagination');

    function pageUrl(n) {
      const u = new URL(window.location.href);
      u.searchParams.set('ccp-page', n);
      return u.toString();
    }

    let html = '<ul class="custom-pagination">';

    if (current > 1) {
      html += `<li><a href="${pageUrl(current - 1)}" class="circle">&laquo;</a></li>`;
    }

    for (let i = 1; i <= totalPages; i++) {
      if (i === current) {
        html += `<li><span class="circle active">${i}</span></li>`;
      } else {
        html += `<li><a href="${pageUrl(i)}" class="circle">${i}</a></li>`;
      }
    }

    if (current < totalPages) {
      html += `<li><a href="${pageUrl(current + 1)}" class="circle">&raquo;</a></li>`;
    }

    html += '</ul>';
    wrapper.innerHTML = html;
  }

  showPage(getCurrentPage());
})();
</script>

{% schema %}
{
  "name": "Custom Colour Collection",
  "settings": [
    {
      "type": "text",
      "id": "variant_color",
      "label": "Variant Colour Filter",
      "placeholder": "e.g. grün  or  rot,red,rouge",
      "info": "Type the colour keyword to show only products with that variant. Separate multiple keywords with a comma (e.g. grün,green). Leave empty to show ALL products."
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Deal Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Christmas Deal"
    }
  ],
  "presets": [
    { "name": "Custom Colour Collection" }
  ]
}
{% endschema %}
