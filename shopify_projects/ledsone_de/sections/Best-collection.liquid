{% schema %}
{
  "name": "Best Collections Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The best Collections"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "High quality and efficient luminaires from leading brands in professional and decorative lighting."
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "collection_image",
          "label": "Collection Image"
        },
        {
          "type": "text",
          "id": "collection_name",
          "label": "Collection Name"
        },
        {
          "type": "url",
          "id": "collection_link",
          "label": "Collection Link"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Best Collections Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="collections-wrapper">
  <div class="collections-header">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>

  <div class="collections-grid">
    {% for block in section.blocks %}
      <a class="collection-card" href="{{ block.settings.collection_link }}" {{ block.shopify_attributes }}>

        <!-- Collection Image -->
        <div class="collection-image">
          {% if block.settings.collection_image != blank %}
            <img src="{{ block.settings.collection_image | img_url: '600x' }}" alt="{{ block.settings.collection_name }}">
          {% else %}
            <div class="collection-image-placeholder"></div>
          {% endif %}
        </div>

        <!-- Name -->
        <div class="collection-name">
          {{ block.settings.collection_name }}
        </div>

      </a>
    {% endfor %}
  </div>
</div>

<style>

/* ── WRAPPER ── */
.collections-wrapper {
  margin: 0 auto 30px;
  max-width: 1200px;
  width: 100%;
  text-align: center;
}

/* ── HEADER ── */
.collections-header h2 {
  font-size: 25px;
  margin-bottom: 5px;
}

.collections-header p {
  color: #555;
  margin-bottom: 25px;
}

/* ── GRID — 6 cards per row on desktop ── */
.collections-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 20px;
  padding-bottom: 10px;
}

/* ── CARD ── */
.collection-card {
  border-radius: 10px;
  overflow: hidden;
  background: #fff;
  text-decoration: none;
  color: inherit;
  box-shadow: 0 3px 8px rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.2s, transform 0.2s;
}

.collection-card:hover {
  box-shadow: 0 6px 18px rgba(0,0,0,0.14);
  transform: translateY(-2px);
}

/* ── IMAGE ── */
.collection-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
}

.collection-image img,
.collection-image-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.collection-image-placeholder {
  background: #f0f0f0;
}

/* ── NAME ── */
.collection-name {
  padding: 12px 10px;
  font-size: 14px;
  font-weight: 600;
  text-align: center;
  line-height: 1.3;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── MOBILE — horizontal scroll, 2 cards visible ── */
@media screen and (max-width: 768px) {
  .collections-wrapper {
    overflow: hidden;
    padding: 0 20px;
  }

  .collections-grid {
    display: flex;
    overflow-x: scroll;
    gap: 16px;
    padding: 0 0 10px;
    scroll-snap-type: x mandatory;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .collections-grid::-webkit-scrollbar {
    display: none;
  }

  .collection-card {
    flex: 0 0 calc(50% - 8px);
    scroll-snap-align: start;
  }

  .collection-name {
    font-size: 13px;
    padding: 10px 8px;
  }

  .collections-header p {
    padding: 0 20px;
  }
}

</style>
