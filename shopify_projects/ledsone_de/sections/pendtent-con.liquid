          {% if shade_product_5 != blank and s5_has_stock %}<div class="pc-inline-panel" id="ddPanelS5" tabindex="-1"><p class="pc-panel-name">{{ shade_product_5.title }}</p><div class="pc-btns pc-btns-4col pc-multi" data-opt="cable" data-category="Shade">{% for v in shade_product_5.variants %}{% unless v.available %}{% continue %}{% endunless %}<div class="pc-card" data-id="{{ v.id }}" data-title="{{ shade_product_5.title | escape }} — {{ v.title | escape }}" data-price-cents="{{ v.price }}" data-img="{% if v.image %}{{ v.image | img_url: '600x600' }}{% else %}{{ shade_product_5.featured_image | img_url: '600x600' }}{% endif %}">{% if v.image %}<img src="{{ v.image | img_url: '80x80' }}" alt="{{ v.title | escape }}" class="pc-vimg pc-zoomable" data-full="{% if v.image %}{{ v.image | img_url: '800x800' }}{% else %}{{ shade_product_5.featured_image | img_url: '800x800' }}{% endif %}" data-caption="{{ shade_product_5.title | escape }} — {{ v.title | escape }}" loading="lazy">{% elsif shade_product_5.featured_image %}<img src="{{ shade_product_5.featured_image | img_url: '80x80' }}" alt="{{ v.title | escape }}" class="pc-vimg pc-zoomable" data-full="{{ shade_product_5.featured_image | img_url: '800x800' }}" data-caption="{{ shade_product_5.title | escape }} — {{ v.title | escape }}" loading="lazy">{% endif %}<span class="pc-vname">{{ v.title }}</span><span class="pc-vprice">{{ v.price | money }}</span><div class="pc-qty-wrap"><button type="button" class="pc-qty-btn pc-qty-minus">−</button><span class="pc-qty-val">0</span><button type="button" class="pc-qty-btn pc-qty-plus">+</button></div></div>{% endfor %}</div><button type="button" class="pc-dd-close"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg> Schließen</button></div>{% endif %}
        </div>
        <p class="pc-dd-sel-hint" id="hintS"></p>

        <!-- ATC CODE REMINDER -->
        <div class="pc-atc-code-reminder" id="atcCodeReminder" style="display:none">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          <span class="pc-acr-text">Code <strong id="acrCode">{{ section.settings.discount_code_15 | default: 'BUNDLE15' }}</strong> beim Checkout eingeben und 15&nbsp;% sparen!</span>
          <button type="button" class="pc-acr-copy" id="acrCopyBtn" onclick="pcCopyReminderCode(event)" title="Code kopieren">
            <svg id="acrCopyIcon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg id="acrCheckIcon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
        </div>

        <button type="submit" class="pc-atc" id="atcBtn" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          In den Warenkorb — <span id="atcPrice">€0,00</span>
        </button>
        <p class="pc-atc-hint" id="atcHint">Bitte mindestens einen Artikel auswählen</p>

      </form>
    </div><!-- /pc-options -->

  </div><!-- /pc-grid -->
</div><!-- /pc-wrap -->

<!-- ══ FEEDBACK MODAL ══ -->
<div id="pcFeedbackModal" class="pc-fb-modal">
  <div class="pc-fb-modal-content">
    <span class="pc-fb-close" id="pcFbClose">&times;</span>
    <h3 class="pc-fb-title">Warum haben Sie sich dagegen entschieden?</h3>

    <!-- EMAIL STEP -->
    <div class="pc-fb-email-step" id="pcFbEmailStep">
      <p>Bitte geben Sie Ihre E-Mail-Adresse ein, um fortzufahren.</p>
      <input type="email" id="pcFbEmail" placeholder="Ihre E-Mail-Adresse">
      <button class="pc-fb-next-btn" id="pcFbNextBtn">Weiter</button>
    </div>

    <!-- FEEDBACK TEXT STEP -->
    <div class="pc-fb-text-step" id="pcFbTextStep">
      <textarea id="pcFbText" class="pc-fb-textarea" placeholder="Teilen Sie uns Ihre Gedanken mit…"></textarea>
      <button class="pc-fb-submit-btn" id="pcFbSubmitBtn">Absenden</button>
      <p class="pc-fb-thankyou" id="pcFbThankyou">✅ Vielen Dank für Ihr Feedback!</p>
    </div>
  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap');

.pc-mini-atc{background:#16a34a;color:#fff;border:none;padding:13px 16px;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;width:100%;white-space:nowrap;line-height:1.2;box-shadow:0 4px 14px rgba(22,163,74,.25);transition:background .2s,transform .2s,box-shadow .2s}
.pc-mini-atc:hover{background:#15803d;transform:translateY(-1px);box-shadow:0 8px 22px rgba(22,163,74,.38)}

.pc-wrap *{box-sizing:border-box}

/* ══ LIGHTBOX ══ */
.pc-lightbox{position:fixed;inset:0;z-index:999999;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease}
.pc-lightbox.open{opacity:1;pointer-events:all}
.pc-lb-backdrop{position:absolute;inset:0;background:rgba(20,12,6,.88);cursor:pointer}
.pc-lb-content{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:14px;max-width:min(90vw,580px);max-height:90vh;padding:14px}
.pc-lb-img{max-width:100%;max-height:calc(90vh - 80px);object-fit:contain;border-radius:10px;box-shadow:0 24px 64px rgba(0,0,0,.55);background:#fff;transform:scale(.88);transition:transform .28s cubic-bezier(.34,1.56,.64,1)}
.pc-lightbox.open .pc-lb-img{transform:scale(1)}
.pc-lb-caption{margin:0;color:rgba(255,255,255,.82);font-size:13px;font-family:'Jost',sans-serif;text-align:center}
.pc-lb-close{position:fixed;top:16px;right:16px;z-index:2;background:rgba(255,255,255,.14);border:1.5px solid rgba(255,255,255,.28);border-radius:50px;color:#fff;padding:8px 16px 8px 12px;display:flex;align-items:center;gap:7px;font-size:13px;font-weight:600;font-family:'Jost',sans-serif;cursor:pointer;transition:background .18s;backdrop-filter:blur(6px)}
.pc-lb-close:hover{background:rgba(255,255,255,.26)}
.pc-lb-close svg{stroke:#fff;flex-shrink:0}
.pc-vimg.pc-zoomable,.pc-tri-img{cursor:zoom-in}

/* ══ TOAST ══ */
.pc-toast{position:fixed;inset:0;background:rgba(0,0,0,0);display:flex;align-items:center;justify-content:center;z-index:99999;pointer-events:none;transition:background .25s}
.pc-toast.pc-toast-visible{background:rgba(0,0,0,.45);pointer-events:all}
.pc-toast-inner{background:#fff;border-radius:14px;padding:28px 36px;display:flex;flex-direction:column;align-items:center;gap:14px;box-shadow:0 20px 60px rgba(0,0,0,.22);font-family:'Jost',sans-serif;font-size:16px;font-weight:600;color:#3a2e26;transform:scale(.85);opacity:0;transition:transform .25s cubic-bezier(.34,1.56,.64,1),opacity .2s;min-width:200px;text-align:center}
.pc-toast.pc-toast-visible .pc-toast-inner{transform:scale(1);opacity:1}
.pc-toast-spinner{width:36px;height:36px;border:3px solid #e0d5ca;border-top-color:#5c3d2e;border-radius:50%;animation:pcSpin .7s linear infinite}
@keyframes pcSpin{to{transform:rotate(360deg)}}
.pc-toast-check{width:36px;height:36px;background:#16a34a;border-radius:50%;display:flex;align-items:center;justify-content:center;animation:pcPop .35s cubic-bezier(.34,1.56,.64,1)}
@keyframes pcPop{from{transform:scale(0)}to{transform:scale(1)}}
.pc-toast-check svg{stroke:#fff}

/* ══ LAYOUT ══ */
.pc-wrap{max-width:1380px;margin:36px auto;padding:0 18px;font-family:'Jost',sans-serif}
.pc-grid{display:grid;grid-template-columns:1fr 1fr;gap:36px;background:#fdfaf7;border-radius:14px;box-shadow:0 6px 36px rgba(80,60,40,.09);padding:36px;border:1px solid #ede6dc}
.pc-preview{position:sticky;top:18px;height:fit-content;display:flex;flex-direction:column;gap:16px}
.pc-preview-title{font-size:20px;font-weight:600;color:#3a2e26;margin:0;letter-spacing:.4px}

/* ══ CANVAS (thumbnails) ══ */
.pc-canvas{background:linear-gradient(155deg,#f9f4ed,#ece4d8);border-radius:12px;padding:18px 14px 14px;display:flex;flex-direction:column;align-items:center;gap:14px;border:1px solid #ddd4c5}
.pc-pills{display:flex;align-items:center;gap:4px;flex-wrap:wrap;justify-content:center}
.pc-pill{background:#e8ddd0;color:#9e8a78;font-size:10px;padding:3px 9px;border-radius:20px;border:1px solid #d5c9bc;transition:all .3s;white-space:nowrap}
.pc-pill.active{background:#16a34a;color:#fff;border-color:#16a34a}
.pc-pill.done{background:#15803d;color:#fff;border-color:#15803d}
.pc-arrow{color:#c9b8a8;font-size:11px}
.pc-trio-preview{display:flex;align-items:flex-start;justify-content:center;gap:4px;width:100%}
.pc-trio-col{display:flex;flex-direction:column;align-items:center;gap:6px;flex:1;min-width:0}
.pc-trio-label{font-size:8px;color:#9e8a78;text-transform:uppercase;letter-spacing:.4px;margin:0;font-weight:600;text-align:center}
.pc-tri-imgs{display:flex;flex-direction:column;gap:4px;align-items:center;width:100%}
.pc-tri-placeholder{width:52px;height:52px;opacity:.5;animation:pcPulse 2s ease-in-out infinite}
@keyframes pcPulse{0%,100%{opacity:.3}50%{opacity:.7}}
.pc-tri-img{width:50px;height:50px;object-fit:contain;border-radius:6px;border:2px solid #e0d5ca;background:#fff;filter:drop-shadow(0 2px 5px rgba(92,61,46,.12));animation:pcFadeIn .3s ease;cursor:zoom-in}
@keyframes pcFadeIn{from{opacity:0;transform:scale(.85)}to{opacity:1;transform:scale(1)}}
.pc-tri-img-label{font-size:8px;color:#9e8a78;text-align:center;max-width:52px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pc-trio-divider{color:#c9b8a8;font-size:12px;padding-top:22px;flex-shrink:0}

/* ══ COUPON WIDGET ══ */
.pc-coupon-wrap{background:#fff;border:1px solid #e8e0d8;border-radius:12px;padding:18px 18px 14px;display:flex;flex-direction:column;gap:14px}
.pc-coup-eyebrow{font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#b5a090;font-family:'Jost',sans-serif;margin:0}

/* Category dots grid */
.pc-coup-cats{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.pc-coup-cat{display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:8px;border:1.5px solid #e8ddd0;background:#fdf8f3;transition:border-color .25s,background .25s;cursor:pointer}
.pc-coup-cat:hover{border-color:#9e8a78;background:#f5ede3}
.pc-coup-cat[data-state="done"]{border-color:#16a34a;background:#f0fdf4}
.pc-coup-cat[data-state="empty"]{border-color:#e8ddd0;background:#fdf8f3}
.pc-coup-dot{width:18px;height:18px;min-width:18px;border-radius:50%;border:1.5px solid #d5c4b0;background:#fdf8f3;display:flex;align-items:center;justify-content:center;transition:background .25s,border-color .25s;flex-shrink:0}
.pc-coup-cat[data-state="done"] .pc-coup-dot{background:#16a34a;border-color:#16a34a}
.pc-coup-check{stroke:#fff;opacity:0;transition:opacity .2s}
.pc-coup-cat[data-state="done"] .pc-coup-check{opacity:1}
.pc-coup-cat span{font-size:13px;color:#5a5450;font-family:'Jost',sans-serif;font-weight:600;transition:color .25s}
.pc-coup-cat[data-state="done"] span{color:#166534;font-weight:600}

/* Simple progress bar + label */
.pc-coup-progress{display:flex;flex-direction:column;gap:6px}
.pc-tier-bar{height:5px;background:#f0e8e0;border-radius:99px;overflow:hidden;position:relative}
.pc-tier-bar-fill{height:100%;width:0%;border-radius:99px;transition:width .5s cubic-bezier(.4,0,.2,1);background:linear-gradient(90deg,#fbbf24,#16a34a)}
.pc-coup-progress-lbl{margin:0;font-size:11px;color:#9e8a78;font-family:'Jost',sans-serif;text-align:center;font-weight:600;letter-spacing:.2px}

/* Locked message */
.pc-coup-locked-msg{margin:0;font-size:13px;color:#5a5450;font-family:'Jost',sans-serif;text-align:center;font-weight:500;transition:opacity .3s}
.pc-coup-locked-msg strong{color:#3a2e26}

/* Dynamic selection hint */
.pc-coup-sel-hint{margin:0;font-size:12px;color:#92400e;font-family:'Jost',sans-serif;text-align:center;font-weight:600;background:#fffbeb;border:1px solid #fde68a;border-radius:7px;padding:8px 12px;line-height:1.5;display:none}

/* Per-dropdown selection hint */
.pc-dd-sel-hint{margin:4px 0 0;font-size:12px;font-weight:600;color:#92400e;font-family:'Jost',sans-serif;background:#fffbeb;border:1px solid #fde68a;border-radius:7px;padding:7px 12px;line-height:1.5;display:none;animation:pcFadeIn .25s ease}

/* ══ UNLOCKING ANIMATION ══ */
.pc-coup-unlocking{display:flex;align-items:center;justify-content:center;gap:10px;padding:16px 12px;background:linear-gradient(135deg,#fffbeb,#fef3c7);border:1.5px solid #fde68a;border-radius:10px;animation:pcUnlockFadeIn .3s ease}
@keyframes pcUnlockFadeIn{from{opacity:0;transform:scale(.95)}to{opacity:1;transform:scale(1)}}
.pc-unlock-spinner{width:20px;height:20px;min-width:20px;border:2.5px solid #fde68a;border-top-color:#d97706;border-radius:50%;animation:pcSpin .65s linear infinite;flex-shrink:0}
.pc-unlock-text{font-size:14px;font-weight:700;color:#92400e;font-family:'Jost',sans-serif;letter-spacing:.3px}

/* Code reveal area */
.pc-coup-code-area{display:flex;flex-direction:column;gap:10px;animation:pcCodeIn .4s cubic-bezier(.34,1.56,.64,1)}
@keyframes pcCodeIn{from{opacity:0;transform:translateY(6px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.pc-coup-code-header{display:flex;align-items:center;gap:8px}
.pc-coup-pct-pill{background:#7c3aed;color:#fff;font-size:13px;font-weight:800;letter-spacing:1px;padding:6px 14px;border-radius:6px;font-family:'Jost',sans-serif;text-transform:uppercase;white-space:nowrap}
.pc-coup-code-label-sm{font-size:10px;color:#9e8a78;font-family:'Jost',sans-serif}
.pc-cu-code-row{display:flex;align-items:center;gap:8px;border:1.5px solid #d5c4b0;border-radius:8px;padding:4px 4px 4px 14px;background:#fdf8f3;min-height:44px}
.pc-cu-code{flex:1;font-size:14px;font-weight:800;letter-spacing:3px;color:#3a2e26;font-family:'Jost',sans-serif;display:flex;align-items:center;user-select:all;min-width:0}
.pc-cu-copy{flex-shrink:0;background:#7c3aed;color:#fff;border:none;border-radius:6px;width:36px;height:36px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .15s,transform .1s;padding:0}
.pc-cu-copy:hover{background:#6d28d9;transform:scale(1.05)}
.pc-cu-copy svg{stroke:#fff}
.pc-cu-copy.copied{background:#15803d}

/* ══ VALIDATION ══ */
.pc-validation{background:#fff8f0;border:1px solid #f5c98a;border-radius:8px;padding:10px 14px}
.pc-valid-row{margin:0;padding:3px 0;font-size:12px;color:#856404;display:flex;align-items:center;gap:6px}
.pc-valid-row.hidden{display:none}

/* ══ PRICE BOX ══ */
.pc-price-box{background:#fff;border-radius:9px;padding:14px 16px;border:1px solid #e0d5ca}
.pc-price-row{display:flex;justify-content:space-between;padding:6px 0;font-size:13px;color:#6b5a4e;border-bottom:1px solid #e8ddd0}
.pc-price-row:last-child{border-bottom:none}
.pc-subtotal-row{border-bottom:1px solid #d5c4b0!important}
.pc-discount-row{background:rgba(124,58,237,.05);margin:0 -16px;padding:6px 16px;color:#5b21b6;font-weight:600;border-bottom:1px solid #ddd6fe!important}
.pc-discount-amt{color:#7c3aed;font-weight:700}
.pc-total{border-top:2px solid #c9b8a8;margin-top:5px;padding-top:10px;font-size:17px;font-weight:700;color:#2e2018}

/* ══ RIGHT SIDE ══ */
.pc-options{}
.pc-title{font-size:20px;font-weight:700;color:#2e2018;margin:0 0 24px}
form#pcForm{display:flex;flex-direction:column;gap:16px}
.pc-group{display:flex;flex-direction:column;gap:8px;margin-bottom:0}
.pc-label{font-size:14px;font-weight:600;color:#3a2e26;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.pc-req{color:#c0392b}
.pc-missing-badge{background:#fee2e2;color:#dc2626;border:1px solid #fca5a5;border-radius:12px;font-size:10px;font-weight:600;padding:2px 8px;font-family:'Jost',sans-serif}
.pc-missing-badge.hidden{display:none}
.pc-dd-sublabel{margin:-6px 0 0;font-size:11px;color:#9e8a78;font-style:italic;font-family:'Jost',sans-serif}
