{% comment %}
  PENDANT CONFIGURATOR
  Save as: sections/pendant-configurator.liquid
{% endcomment %}

{% assign shape_product_1 = all_products[section.settings.roselet_product_1] %}
{% assign shape_product_2 = all_products[section.settings.roselet_product_2] %}
{% assign shape_product_3 = all_products[section.settings.roselet_product_3] %}
{% assign shape_product_4 = all_products[section.settings.roselet_product_4] %}
{% assign shape_product_5 = all_products[section.settings.roselet_product_5] %}
{% assign cable_product_1 = all_products[section.settings.cable_product_1] %}
{% assign cable_product_2 = all_products[section.settings.cable_product_2] %}
{% assign cable_product_3 = all_products[section.settings.cable_product_3] %}
{% assign cable_product_4 = all_products[section.settings.cable_product_4] %}
{% assign cable_product_5 = all_products[section.settings.cable_product_5] %}
{% assign holder_product_1 = all_products[section.settings.holder_product_1] %}
{% assign holder_product_2 = all_products[section.settings.holder_product_2] %}
{% assign holder_product_3 = all_products[section.settings.holder_product_3] %}
{% assign holder_product_4 = all_products[section.settings.holder_product_4] %}
{% assign holder_product_5 = all_products[section.settings.holder_product_5] %}
{% assign shade_product_1 = all_products[section.settings.shade_product_1] %}
{% assign shade_product_2 = all_products[section.settings.shade_product_2] %}
{% assign shade_product_3 = all_products[section.settings.shade_product_3] %}
{% assign shade_product_4 = all_products[section.settings.shade_product_4] %}
{% assign shade_product_5 = all_products[section.settings.shade_product_5] %}

<!-- ══ BILD-LIGHTBOX ══ -->
<div id="pcLightbox" class="pc-lightbox" role="dialog" aria-modal="true" aria-label="Bildvorschau">
  <button class="pc-lb-close" id="pcLbClose" aria-label="Bild schließen">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    <span>Schließen</span>
  </button>
  <div class="pc-lb-backdrop" id="pcLbBackdrop"></div>
  <div class="pc-lb-content">
    <img id="pcLbImg" src="" alt="" class="pc-lb-img">
    <p id="pcLbCaption" class="pc-lb-caption"></p>
  </div>
</div>

<!-- BENACHRICHTIGUNG -->
<div id="pcToast" class="pc-toast" aria-live="polite" aria-atomic="true">
  <div class="pc-toast-inner" id="pcToastInner">
    <div class="pc-toast-spinner"></div>
    <span id="pcToastMsg">Wird zum Warenkorb hinzugefügt…</span>
  </div>
</div>

<div class="pc-wrap" data-section-id="{{ section.id }}">
  <div class="pc-grid">

    <!-- ══ LEFT: Preview + Coupon ══ -->
    <div class="pc-preview">
      <h2 class="pc-preview-title">Ihr individueller Anhänger</h2>

      <!-- LIVE PREVIEW THUMBNAILS -->
      <div class="pc-canvas">

        <div class="pc-trio-preview">
          <div class="pc-trio-col">
            <p class="pc-trio-label">{{ section.settings.roselet_label | default: 'Roselet' }}</p>
            <div class="pc-tri-imgs" id="trioImgsR"><div class="pc-tri-placeholder"><svg viewBox="0 0 80 80" fill="none"><circle cx="40" cy="40" r="34" stroke="#c9b8a8" stroke-width="1.5" stroke-dasharray="5 3"/><text x="40" y="44" text-anchor="middle" fill="#c9b8a8" font-size="8" font-family="serif">Roselet</text></svg></div></div>
          </div>
          <div class="pc-trio-divider">→</div>
          <div class="pc-trio-col">
            <p class="pc-trio-label">{{ section.settings.cable_label | default: 'Kabel' }}</p>
            <div class="pc-tri-imgs" id="trioImgsC"><div class="pc-tri-placeholder"><svg viewBox="0 0 80 80" fill="none"><circle cx="40" cy="40" r="34" stroke="#c9b8a8" stroke-width="1.5" stroke-dasharray="5 3"/><text x="40" y="44" text-anchor="middle" fill="#c9b8a8" font-size="8" font-family="serif">Kabel</text></svg></div></div>
          </div>
          <div class="pc-trio-divider">→</div>
          <div class="pc-trio-col">
            <p class="pc-trio-label">{{ section.settings.holder_label | default: 'Halter' }}</p>
            <div class="pc-tri-imgs" id="trioImgsH"><div class="pc-tri-placeholder"><svg viewBox="0 0 80 80" fill="none"><circle cx="40" cy="40" r="34" stroke="#c9b8a8" stroke-width="1.5" stroke-dasharray="5 3"/><text x="40" y="44" text-anchor="middle" fill="#c9b8a8" font-size="8" font-family="serif">Halter</text></svg></div></div>
          </div>
          <div class="pc-trio-divider">→</div>
          <div class="pc-trio-col">
            <p class="pc-trio-label">{{ section.settings.shade_label | default: 'Schirm' }}</p>
            <div class="pc-tri-imgs" id="trioImgsS"><div class="pc-tri-placeholder"><svg viewBox="0 0 80 80" fill="none"><circle cx="40" cy="40" r="34" stroke="#c9b8a8" stroke-width="1.5" stroke-dasharray="5 3"/><text x="40" y="44" text-anchor="middle" fill="#c9b8a8" font-size="8" font-family="serif">Schirm</text></svg></div></div>
          </div>
        </div>
      </div><!-- /pc-canvas -->

      <!-- ══ COUPON WIDGET (only 15% — all 4 categories) ══ -->
      <div class="pc-coupon-wrap" id="pcCouponWrap"
        data-code15="{{ section.settings.discount_code_15 | default: 'BUNDLE15' }}">

        <div class="pc-coup-eyebrow">Bundle-Rabatt</div>

        <!-- 4 category status dots -->
        <div class="pc-coup-cats">
          <div class="pc-coup-cat" id="catItemR" data-state="empty">
            <div class="pc-coup-dot">
              <svg class="pc-coup-check" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span>{{ section.settings.roselet_label | default: 'Roselet' }}</span>
          </div>
          <div class="pc-coup-cat" id="catItemC" data-state="empty">
            <div class="pc-coup-dot">
              <svg class="pc-coup-check" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span>{{ section.settings.cable_label | default: 'Kabel' }}</span>
          </div>
          <div class="pc-coup-cat" id="catItemH" data-state="empty">
            <div class="pc-coup-dot">
              <svg class="pc-coup-check" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span>{{ section.settings.holder_label | default: 'Halter' }}</span>
          </div>
          <div class="pc-coup-cat" id="catItemS" data-state="empty">
            <div class="pc-coup-dot">
              <svg class="pc-coup-check" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span>{{ section.settings.shade_label | default: 'Schirm' }}</span>
          </div>
        </div>

        <!-- Simple progress bar (fills 25% per category selected) -->
        <div class="pc-coup-progress">
          <div class="pc-tier-bar"><div class="pc-tier-bar-fill" id="tierBarFill"></div></div>
          <p class="pc-coup-progress-lbl" id="couponProgressText">0 von 4 Kategorien ausgewählt</p>
        </div>

        <!-- Locked state message -->
        <p class="pc-coup-locked-msg" id="couponLockedMsg">Wählen Sie alle 4 Kategorien für <strong>15&nbsp;% Rabatt</strong></p>

        <!-- Unlocking animation (briefly shown when all 4 are selected) -->
        <div class="pc-coup-unlocking" id="couponUnlocking" style="display:none" aria-live="polite">
          <div class="pc-unlock-spinner"></div>
          <span class="pc-unlock-text">🔓 Wird entsperrt&nbsp;…</span>
        </div>

        <!-- Code reveal (shown after unlock animation) -->
        <div class="pc-coup-code-area" id="couponCodeArea" style="display:none">
          <div class="pc-coup-code-header">
            <div class="pc-coup-pct-pill">15% RABATT</div>
            <span class="pc-coup-code-label-sm">Ihr exklusiver Code</span>
          </div>
          <div class="pc-cu-code-row">
            <div class="pc-cu-code" id="couponCodeDisplay">{{ section.settings.discount_code_15 | default: 'BUNDLE15' }}</div>
            <button type="button" class="pc-cu-copy" id="couponCopyBtn" onclick="pcCopyCode(event)" title="Code kopieren">
              <svg id="copyIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <svg id="checkIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
          </div>
        </div>

      </div><!-- /pc-coupon-wrap -->
      
      <!-- ══ MINI ATC UNDER COUPON ══ -->
      <div id="miniAtcWrap" style="display:none">
        <button type="button" class="pc-mini-atc" id="miniAtcBtn" onclick="document.getElementById('pcForm').dispatchEvent(new Event('submit',{bubbles:true,cancelable:true}))">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          In den Warenkorb — <span id="miniAtcPrice">€0,00</span>
        </button>
      </div>

      <!-- VALIDATION HINTS -->
      <div class="pc-validation" id="pcValidation" style="display:none">
        <p id="validHintR" class="pc-valid-row hidden"><span class="pc-valid-icon">⚠️</span> Bitte mindestens einen <strong>{{ section.settings.roselet_label | default: 'Roselet' }}</strong> auswählen</p>
        <p id="validHintC" class="pc-valid-row hidden"><span class="pc-valid-icon">⚠️</span> Bitte mindestens ein <strong>{{ section.settings.cable_label | default: 'Kabel' }}</strong> auswählen</p>
        <p id="validHintH" class="pc-valid-row hidden"><span class="pc-valid-icon">⚠️</span> Bitte mindestens einen <strong>{{ section.settings.holder_label | default: 'Halter' }}</strong> auswählen</p>
        <p id="validHintS" class="pc-valid-row hidden"><span class="pc-valid-icon">⚠️</span> Bitte mindestens einen <strong>{{ section.settings.shade_label | default: 'Schirm' }}</strong> auswählen</p>
      </div>

      <!-- PRICE BOX -->
      <div class="pc-price-box">
        <div class="pc-price-row"><span>{{ section.settings.roselet_label | default: 'Roselet' }}:</span><span id="priceR">€0,00</span></div>
        <div class="pc-price-row"><span>{{ section.settings.cable_label | default: 'Kabel' }}:</span><span id="priceC">€0,00</span></div>
        <div class="pc-price-row"><span>{{ section.settings.holder_label | default: 'Halter' }}:</span><span id="priceH">€0,00</span></div>
        <div class="pc-price-row"><span>{{ section.settings.shade_label | default: 'Schirm' }}:</span><span id="priceS">€0,00</span></div>
        <div class="pc-price-row pc-subtotal-row"><span>Zwischensumme:</span><span id="priceSubtotal">€0,00</span></div>
        <div class="pc-price-row pc-discount-row" id="discountRow" style="display:none">
          <span>🏷️ Bundle-Rabatt (15%):</span>
          <span id="priceDiscount" class="pc-discount-amt">−€0,00</span>
        </div>
        <div class="pc-price-row pc-total"><span>Gesamt:</span><span id="priceTotal">€0,00</span></div>
      </div>

    </div><!-- /pc-preview -->

    <!-- ══ RIGHT: Configuration Form ══ -->
    <div class="pc-options">
      <div class="pc-title-row">
        <h1 class="pc-title">Ihren Anhänger gestalten</h1>
        <button type="button" class="pc-feedback-btn" id="pcOpenFeedback">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span>Kein Interesse? Feedback geben</span>
        </button>
      </div>
      <form id="pcForm">

        <!-- ══ 1. ROSELET ══ -->
        <div class="pc-group" id="groupShape">
          <label class="pc-label">
            {{ section.settings.roselet_label | default: 'Roselet' }}
            <span class="pc-req">*</span>
            <span class="pc-missing-badge hidden" id="badgeR">Mindestens 1 auswählen</span>
          </label>
        </div>
        <p class="pc-dd-sublabel">Wählen Sie einen {{ section.settings.roselet_label | default: 'Roselet' }}-Stil</p>
        <div class="pc-multitab-row" id="roseletDds">
          {% if shape_product_1 != blank %}{% assign r1_has_stock = false %}{% for v in shape_product_1.variants %}{% if v.available %}{% assign r1_has_stock = true %}{% break %}{% endif %}{% endfor %}{% if r1_has_stock %}<div class="pc-multitab-wrap"><button type="button" class="pc-tab-btn" id="ddBtnR1" data-panel="ddPanelR1"><span>{{ section.settings.roselet_tab_1 | default: shape_product_1.title }}</span><svg class="pc-dd-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button></div>{% endif %}{% endif %}
          {% if shape_product_2 != blank %}{% assign r2_has_stock = false %}{% for v in shape_product_2.variants %}{% if v.available %}{% assign r2_has_stock = true %}{% break %}{% endif %}{% endfor %}{% if r2_has_stock %}<div class="pc-multitab-wrap"><button type="button" class="pc-tab-btn" id="ddBtnR2" data-panel="ddPanelR2"><span>{{ section.settings.roselet_tab_2 | default: shape_product_2.title }}</span><svg class="pc-dd-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button></div>{% endif %}{% endif %}
          {% if shape_product_3 != blank %}{% assign r3_has_stock = false %}{% for v in shape_product_3.variants %}{% if v.available %}{% assign r3_has_stock = true %}{% break %}{% endif %}{% endfor %}{% if r3_has_stock %}<div class="pc-multitab-wrap"><button type="button" class="pc-tab-btn" id="ddBtnR3" data-panel="ddPanelR3"><span>{{ section.settings.roselet_tab_3 | default: shape_product_3.title }}</span><svg class="pc-dd-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button></div>{% endif %}{% endif %}
          {% if shape_product_4 != blank %}{% assign r4_has_stock = false %}{% for v in shape_product_4.variants %}{% if v.available %}{% assign r4_has_stock = true %}{% break %}{% endif %}{% endfor %}{% if r4_has_stock %}<div class="pc-multitab-wrap"><button type="button" class="pc-tab-btn" id="ddBtnR4" data-panel="ddPanelR4"><span>{{ section.settings.roselet_tab_4 | default: shape_product_4.title }}</span><svg class="pc-dd-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button></div>{% endif %}{% endif %}
          {% if shape_product_5 != blank %}{% assign r5_has_stock = false %}{% for v in shape_product_5.variants %}{% if v.available %}{% assign r5_has_stock = true %}{% break %}{% endif %}{% endfor %}{% if r5_has_stock %}<div class="pc-multitab-wrap"><button type="button" class="pc-tab-btn" id="ddBtnR5" data-panel="ddPanelR5"><span>{{ section.settings.roselet_tab_5 | default: shape_product_5.title }}</span><svg class="pc-dd-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button></div>{% endif %}{% endif %}
          {% if shape_product_1 != blank and r1_has_stock %}<div class="pc-inline-panel pc-roselet-panel" id="ddPanelR1" tabindex="-1"><p class="pc-panel-name">{{ shape_product_1.title }}</p><div class="pc-roselet-scroll"><div class="pc-btns pc-btns-4col pc-multi" data-opt="shape" data-category="Roselet">{% for v in shape_product_1.variants %}{% unless v.available %}{% continue %}{% endunless %}<div class="pc-card" data-id="{{ v.id }}" data-title="{{ shape_product_1.title | escape }} — {{ v.title | escape }}" data-price-cents="{{ v.price }}" data-img="{% if v.image %}{{ v.image | img_url: '600x600' }}{% else %}{{ shape_product_1.featured_image | img_url: '600x600' }}{% endif %}">{% if v.image %}<img src="{{ v.image | img_url: '80x80' }}" alt="{{ v.title | escape }}" class="pc-vimg pc-zoomable" data-full="{% if v.image %}{{ v.image | img_url: '800x800' }}{% else %}{{ shape_product_1.featured_image | img_url: '800x800' }}{% endif %}" data-caption="{{ shape_product_1.title | escape }} — {{ v.title | escape }}" loading="lazy">{% elsif shape_product_1.featured_image %}<img src="{{ shape_product_1.featured_image | img_url: '80x80' }}" alt="{{ v.title | escape }}" class="pc-vimg pc-zoomable" data-full="{{ shape_product_1.featured_image | img_url: '800x800' }}" data-caption="{{ shape_product_1.title | escape }} — {{ v.title | escape }}" loading="lazy">{% endif %}<span class="pc-vname">{{ v.title }}</span><span class="pc-vprice">{{ v.price | money }}</span><div class="pc-qty-wrap"><button type="button" class="pc-qty-btn pc-qty-minus">−</button><span class="pc-qty-val">0</span><button type="button" class="pc-qty-btn pc-qty-plus">+</button></div></div>{% endfor %}</div></div><button type="button" class="pc-dd-close"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg> Schließen</button></div>{% endif %}
