  .pc-lb-close{top:10px;right:10px;padding:7px 12px 7px 10px;font-size:12px}
  .pc-roselet-scroll{max-height:220px}
  .pc-atc{font-size:12px;padding:13px 10px;gap:6px}
  .pc-coup-cats{grid-template-columns:1fr 1fr}
  .pc-trio-divider{font-size:10px;padding-top:18px}
}
</style>

<script>
(function(){
'use strict';

/* ══ ONLY 15% TIER — triggered when all 4 categories are selected ══ */
var DISCOUNT_PCT = 0.15;
var wrap = document.querySelector('[data-code15]');
var CODE15 = wrap ? wrap.dataset.code15 : 'BUNDLE15';

/* Track whether we've already played the unlock animation for the current selection */
var unlockAnimShown = false;

var state={shape:{},material:{},holder:{},cable:{},submitAttempted:false};
function g(id){return document.getElementById(id)}

var el={
  pill1:g('pill1'),pill2:g('pill2'),pill3:g('pill3'),pill4:g('pill4'),
  trioImgsR:g('trioImgsR'),trioImgsC:g('trioImgsC'),trioImgsH:g('trioImgsH'),trioImgsS:g('trioImgsS'),
  priceR:g('priceR'),priceC:g('priceC'),priceH:g('priceH'),priceS:g('priceS'),
  priceSubtotal:g('priceSubtotal'),priceDiscount:g('priceDiscount'),discountRow:g('discountRow'),
  priceTotal:g('priceTotal'),atcPrice:g('atcPrice'),atcBtn:g('atcBtn'),atcHint:g('atcHint'),
  pcValidation:g('pcValidation'),
  validHintR:g('validHintR'),validHintC:g('validHintC'),validHintH:g('validHintH'),validHintS:g('validHintS'),
  badgeR:g('badgeR'),badgeC:g('badgeC'),badgeH:g('badgeH'),badgeS:g('badgeS'),
  groupShape:g('groupShape'),groupMaterial:g('groupMaterial'),groupHolder:g('groupHolder'),groupCable:g('groupCable'),
  toast:g('pcToast'),toastMsg:g('pcToastMsg'),toastInner:g('pcToastInner'),
  /* coupon elements */
  catItemR:g('catItemR'),catItemC:g('catItemC'),catItemH:g('catItemH'),catItemS:g('catItemS'),
  tierBarFill:g('tierBarFill'),
  couponProgressText:g('couponProgressText'),
  couponLockedMsg:g('couponLockedMsg'),
  couponUnlocking:g('couponUnlocking'),
  couponCodeArea:g('couponCodeArea'),
  couponCodeDisplay:g('couponCodeDisplay'),
  /* atc reminder */
  atcCodeReminder:g('atcCodeReminder'),
  acrCode:g('acrCode'),
  /* lightbox */
  lightbox:g('pcLightbox'),lbImg:g('pcLbImg'),lbCaption:g('pcLbCaption'),
  lbClose:g('pcLbClose'),lbBackdrop:g('pcLbBackdrop')
};

/* ══ COUPON UPDATER — only 15% when all 4 selected ══ */
function updateCoupon(hR, hC, hH, hS) {
  var done = [hR, hC, hH, hS].filter(Boolean).length;

  /* Update category dot states */
  function setCat(el, isDone) { if (el) el.setAttribute('data-state', isDone ? 'done' : 'empty'); }
  setCat(el.catItemR, hR);
  setCat(el.catItemC, hC);
  setCat(el.catItemH, hH);
  setCat(el.catItemS, hS);

  /* Progress bar fills 25% per category (0 → 100% when all 4 done) */
  if (el.tierBarFill) el.tierBarFill.style.width = Math.round(done / 4 * 100) + '%';

  /* Progress label */
  if (el.couponProgressText) {
    el.couponProgressText.textContent = done + ' von 4 Kategorien ausgewählt';
  }

  /* ── Per-dropdown hints ── */
  var labelR = '{{ section.settings.roselet_label | default: "Roselet" }}';
  var labelC = '{{ section.settings.cable_label   | default: "Kabel"   }}';
  var labelH = '{{ section.settings.holder_label  | default: "Halter"  }}';
  var labelS = '{{ section.settings.shade_label   | default: "Schirm"  }}';

  /* For each category: if selected AND not all 4 done, show what's still missing */
  function setHint(el, isSelected, missingLabels) {
    if (!el) return;
    if (!isSelected || done === 4) { el.style.display = 'none'; el.textContent = ''; return; }
    var left = missingLabels.length;
    var str = missingLabels.join(', ');
    var msg = '';
    if (left === 3) msg = '🏷️ ' + str + ' hinzufügen und 15 % sparen!';
    else if (left === 2) msg = '🏷️ Noch ' + str + ' wählen — 15 % Rabatt warten!';
    else if (left === 1) msg = '🔥 Fast da! Noch ' + str + ' wählen für 15 % Rabatt.';
    el.textContent = msg;
    el.style.display = msg ? 'block' : 'none';
  }

  var hintR = g('hintR'), hintC = g('hintC'), hintH = g('hintH'), hintS = g('hintS');

  var missingR = []; if (!hC) missingR.push(labelC); if (!hH) missingR.push(labelH); if (!hS) missingR.push(labelS);
  var missingC = []; if (!hR) missingC.push(labelR); if (!hH) missingC.push(labelH); if (!hS) missingC.push(labelS);
  var missingH = []; if (!hR) missingH.push(labelR); if (!hC) missingH.push(labelC); if (!hS) missingH.push(labelS);
  var missingS = []; if (!hR) missingS.push(labelR); if (!hC) missingS.push(labelC); if (!hH) missingS.push(labelH);

  setHint(hintR, hR, missingR);
  setHint(hintC, hC, missingC);
  setHint(hintH, hH, missingH);
  setHint(hintS, hS, missingS);

  if (done < 4) {
    /* Reset unlock animation flag so it plays again next time all 4 are selected */
    unlockAnimShown = false;

    /* Show locked message, hide everything else */
    if (el.couponLockedMsg)  el.couponLockedMsg.style.display  = '';
    if (el.couponUnlocking)  el.couponUnlocking.style.display  = 'none';
    if (el.couponCodeArea)   el.couponCodeArea.style.display   = 'none';
    return;
  }

  /* ── All 4 selected ── */
  if (el.couponLockedMsg) el.couponLockedMsg.style.display = 'none';
  if (el.couponCodeDisplay) el.couponCodeDisplay.textContent = CODE15;

  if (!unlockAnimShown) {
    unlockAnimShown = true;

    /* 1. Show "Wird entsperrt…" spinner */
    if (el.couponCodeArea)  el.couponCodeArea.style.display  = 'none';
    if (el.couponUnlocking) el.couponUnlocking.style.display = 'flex';

    /* 2. After 1.5 s — hide spinner, reveal code with animation */
    setTimeout(function() {
      if (el.couponUnlocking) el.couponUnlocking.style.display = 'none';
      if (el.couponCodeArea)  el.couponCodeArea.style.display  = 'flex';
    }, 1500);

  } else {
    /* Animation already played this session — show code directly */
    if (el.couponUnlocking) el.couponUnlocking.style.display = 'none';
    if (el.couponCodeArea)  el.couponCodeArea.style.display  = 'flex';
  }
}

/* ══ LIGHTBOX ══ */
function openLightbox(src,caption){
  if(!el.lightbox||!src)return;
  el.lbImg.src=src;el.lbCaption.textContent=caption||'';
  el.lightbox.classList.add('open');document.body.style.overflow='hidden';
}
function closeLightbox(){
  if(!el.lightbox)return;
  el.lightbox.classList.remove('open');document.body.style.overflow='';
  setTimeout(function(){el.lbImg.src=''},300);
}
function initLightbox(){
  if(el.lbClose)el.lbClose.addEventListener('click',function(e){e.stopPropagation();closeLightbox()});
  if(el.lbBackdrop)el.lbBackdrop.addEventListener('click',closeLightbox);
  document.addEventListener('keydown',function(e){if(e.key==='Escape')closeLightbox()});
  document.addEventListener('click',function(e){
    var img=e.target.closest('.pc-zoomable');if(!img)return;
    e.stopPropagation();openLightbox(img.dataset.full||img.src,img.dataset.caption||img.alt||'');
  });
  document.addEventListener('click',function(e){
    var img=e.target.closest('.pc-tri-img');if(!img)return;
    e.stopPropagation();openLightbox(img.src.replace(/\/\d+x\d+\//,'/800x800/'),img.alt||'');
  });
}

/* ══ COPY REMINDER CODE ══ */
window.pcCopyReminderCode=function(e){
  if(e){e.preventDefault();e.stopPropagation();}
  var codeEl=g('acrCode'),btn=g('acrCopyBtn'),ci=g('acrCopyIcon'),ck=g('acrCheckIcon');
  if(!codeEl)return;var code=codeEl.textContent.trim();
  function done(){btn.classList.add('copied');ci.style.display='none';ck.style.display='';setTimeout(function(){btn.classList.remove('copied');ci.style.display='';ck.style.display='none'},2500)}
  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(code).then(done).catch(function(){fb(code);done()})}else{fb(code);done()}
};

/* ══ COPY CODE FROM WIDGET ══ */
window.pcCopyCode=function(e){
  if(e){e.preventDefault();e.stopPropagation();}
  var codeEl=g('couponCodeDisplay'),btn=g('couponCopyBtn'),ci=g('copyIcon'),ck=g('checkIcon');
  if(!codeEl)return;var code=codeEl.textContent.trim();
  function done(){btn.classList.add('copied');ci.style.display='none';ck.style.display='';setTimeout(function(){btn.classList.remove('copied');ci.style.display='';ck.style.display='none'},2500)}
  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(code).then(done).catch(function(){fb(code);done()})}else{fb(code);done()}
};
function fb(t){var a=document.createElement('textarea');a.value=t;a.style.cssText='position:fixed;opacity:0';document.body.appendChild(a);a.select();try{document.execCommand('copy')}catch(e){}document.body.removeChild(a)}

/* ══ TOAST ══ */
var toastTimer=null;
function showToast(type,msg){
  clearTimeout(toastTimer);el.toastMsg.textContent=msg;
  var sp=el.toastInner.querySelector('.pc-toast-spinner'),ch=el.toastInner.querySelector('.pc-toast-check');
  if(type==='loading'){
    if(ch)ch.remove();
    if(!sp){var s=document.createElement('div');s.className='pc-toast-spinner';el.toastInner.insertBefore(s,el.toastInner.firstChild)}
  }else{
    if(sp)sp.remove();
    if(!ch){var c=document.createElement('div');c.className='pc-toast-check';c.innerHTML='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';el.toastInner.insertBefore(c,el.toastInner.firstChild)}
  }
  el.toast.classList.add('pc-toast-visible');
}
function hideToast(d){toastTimer=setTimeout(function(){el.toast.classList.remove('pc-toast-visible')},d||0)}

/* ══ HELPERS ══ */
function cf(card){return parseInt(card.dataset.priceCents||'0',10)/100}
function ov(o){return Object.keys(o).map(function(k){return o[k]})}
function fmt(n){return new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'}).format(n)}
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
function sumP(map){return ov(map).reduce(function(a,b){return a+(b.price||0)*(b.qty||0)},0)}
function hasI(map){return ov(map).some(function(v){return v.qty>0})}
function actI(map){return ov(map).filter(function(v){return v.qty>0})}

/* ══ PANELS ══ */
function closeAll(){
  document.querySelectorAll('.pc-tab-btn.open').forEach(function(b){b.classList.remove('open')});
  document.querySelectorAll('.pc-inline-panel.open').forEach(function(p){p.classList.remove('open')});
}
function openPanel(btn,panel){closeAll();btn.classList.add('open');panel.classList.add('open')}
function wireTab(btn,panel){
  if(!btn||!panel)return;
  btn.addEventListener('mousedown',function(e){e.preventDefault()});
  btn.addEventListener('click',function(e){
    e.stopPropagation();
    btn.classList.contains('open')?closeAll():openPanel(btn,panel);
  });
}
function initTabs(){
  document.querySelectorAll('.pc-tab-btn[data-panel]').forEach(function(btn){wireTab(btn,g(btn.dataset.panel))});
}
function initClose(){
  var wrap=document.querySelector('.pc-wrap');if(!wrap)return;
  wrap.addEventListener('mousedown',function(e){if(e.target.closest('.pc-dd-close'))e.preventDefault()});
  wrap.addEventListener('click',function(e){if(e.target.closest('.pc-dd-close')){e.stopPropagation();closeAll()}});
}

var PAIRS=[
  {btn:'ddBtnR1',panel:'ddPanelR1'},{btn:'ddBtnR2',panel:'ddPanelR2'},{btn:'ddBtnR3',panel:'ddPanelR3'},{btn:'ddBtnR4',panel:'ddPanelR4'},{btn:'ddBtnR5',panel:'ddPanelR5'},
  {btn:'ddBtnK1',panel:'ddPanelK1'},{btn:'ddBtnK2',panel:'ddPanelK2'},{btn:'ddBtnK3',panel:'ddPanelK3'},{btn:'ddBtnK4',panel:'ddPanelK4'},{btn:'ddBtnK5',panel:'ddPanelK5'},
  {btn:'ddBtnH1',panel:'ddPanelH1'},{btn:'ddBtnH2',panel:'ddPanelH2'},{btn:'ddBtnH3',panel:'ddPanelH3'},{btn:'ddBtnH4',panel:'ddPanelH4'},{btn:'ddBtnH5',panel:'ddPanelH5'},
  {btn:'ddBtnS1',panel:'ddPanelS1'},{btn:'ddBtnS2',panel:'ddPanelS2'},{btn:'ddBtnS3',panel:'ddPanelS3'},{btn:'ddBtnS4',panel:'ddPanelS4'},{btn:'ddBtnS5',panel:'ddPanelS5'}
];
function refreshPick(){
  PAIRS.forEach(function(p){var b=g(p.btn),pn=g(p.panel);if(b&&pn)b.classList.toggle('has-pick',!!pn.querySelector('.pc-card.active'))});
}

function stepPill(elem,st){if(!elem)return;elem.classList.remove('active','done');if(st)elem.classList.add(st)}
function renderCol(container,map){
  if(!container)return;
  var items=actI(map);
  if(!items.length){container.innerHTML='<div class="pc-tri-placeholder"><svg viewBox="0 0 80 80" fill="none"><circle cx="40" cy="40" r="34" stroke="#c9b8a8" stroke-width="1.5" stroke-dasharray="5 3"/></svg></div>';return}
  container.innerHTML=items.map(function(it){return'<div style="display:flex;flex-direction:column;align-items:center;gap:2px"><img class="pc-tri-img" src="'+it.img+'" alt="'+esc(it.title)+'"><span class="pc-tri-img-label">'+esc(it.title)+(it.qty>1?' ×'+it.qty:'')+'</span></div>'}).join('');
}

function updateValidation(show){
  var hR=hasI(state.shape),hC=hasI(state.material),hH=hasI(state.holder),hS=hasI(state.cable),ok=hR&&hC&&hH&&hS;
  function se(badge,group,miss){var s=show&&miss;if(badge)badge.classList.toggle('hidden',!s);if(group)group.classList.toggle('pc-error',s)}
  se(el.badgeR,el.groupShape,!hR);se(el.badgeC,el.groupMaterial,!hC);se(el.badgeH,el.groupHolder,!hH);se(el.badgeS,el.groupCable,!hS);
  if(el.pcValidation){
    el.pcValidation.style.display=(show&&!ok)?'':'none';
    if(el.validHintR)el.validHintR.classList.toggle('hidden',hR);
    if(el.validHintC)el.validHintC.classList.toggle('hidden',hC);
    if(el.validHintH)el.validHintH.classList.toggle('hidden',hH);
    if(el.validHintS)el.validHintS.classList.toggle('hidden',hS);
  }
  return ok;
}

function updateAll(){
  var hR=hasI(state.shape),hC=hasI(state.material),hH=hasI(state.holder),hS=hasI(state.cable);
  var ok=hR&&hC&&hH&&hS;

  /* Pills */
  stepPill(el.pill1,hR?(hC&&hH&&hS?'done':'active'):'');
  stepPill(el.pill2,hC?(hR&&hH&&hS?'done':'active'):'');
  stepPill(el.pill3,hH?(hR&&hC&&hS?'done':'active'):'');
  stepPill(el.pill4,hS?(hR&&hC&&hH?'done':'active'):'');

  /* Preview thumbnails */
  renderCol(el.trioImgsR,state.shape);
  renderCol(el.trioImgsC,state.material);
  renderCol(el.trioImgsH,state.holder);
  renderCol(el.trioImgsS,state.cable);

  /* Prices — 15% discount only when all 4 categories selected */
  var sp=sumP(state.shape),cp=sumP(state.material),hp=sumP(state.holder),sh=sumP(state.cable);
  var sub=sp+cp+hp+sh;
  var disc = ok ? sub * DISCOUNT_PCT : 0;
  var tot  = sub - disc;

  el.priceR.textContent=fmt(sp);
  el.priceC.textContent=fmt(cp);
  el.priceH.textContent=fmt(hp);
  el.priceS.textContent=fmt(sh);
  el.priceSubtotal.textContent=fmt(sub);
  el.priceDiscount.textContent='−'+fmt(disc);
  el.priceTotal.textContent=fmt(tot);
  el.atcPrice.textContent=fmt(tot);

  /* Show discount row only when all 4 selected and sub > 0 */
  var showDiscount = ok && sub > 0;
  if(el.discountRow) el.discountRow.style.display = showDiscount ? '' : 'none';

  /* ATC reminder bar */
  if(el.atcCodeReminder){
    el.atcCodeReminder.style.display = showDiscount ? 'flex' : 'none';
    if(el.acrCode) el.acrCode.textContent = CODE15;
  }

  el.atcBtn.disabled = (sub === 0);
  var miniWrap=g('miniAtcWrap'),miniPrice=g('miniAtcPrice');
  if(miniWrap) miniWrap.style.display = (sub > 0) ? 'block' : 'none';
  if(miniPrice) miniPrice.textContent = fmt(tot);
  if(el.atcHint) el.atcHint.classList.toggle('hidden', sub > 0);

  refreshPick();
  updateCoupon(hR, hC, hH, hS);
  if(state.submitAttempted) updateValidation(true);
}

/* ══ QTY ══ */
function setQty(card,opt,delta){
  var id=card.dataset.id,qEl=card.querySelector('.pc-qty-val'),map=state[opt];
  if(!map[id])map[id]={id:id,title:card.dataset.title,price:cf(card),img:card.dataset.img||'',qty:0};
  var nq=Math.max(0,(map[id].qty||0)+delta);
  map[id].qty=nq;qEl.textContent=nq;card.classList.toggle('active',nq>0);
  if(nq===0)delete map[id];
  updateAll();
}
function initCards(){
  document.querySelectorAll('.pc-card').forEach(function(card){
    var cont=card.closest('.pc-btns'),opt=cont?cont.dataset.opt:null;
    if(!opt)return;
    card.querySelector('.pc-qty-plus').addEventListener('click',function(e){e.stopPropagation();setQty(card,opt,1)});
    card.querySelector('.pc-qty-minus').addEventListener('click',function(e){e.stopPropagation();setQty(card,opt,-1)});
    card.addEventListener('click',function(e){
      if(e.target.classList.contains('pc-qty-btn'))return;
      if(e.target.classList.contains('pc-zoomable'))return;
      var cur=(state[opt][card.dataset.id]&&state[opt][card.dataset.id].qty)||0;
      setQty(card,opt,cur>0?-cur:1);
    });
  });
}

function buildItems(){
  var items=[];
  function push(map,cat){actI(map).forEach(function(v){items.push({id:parseInt(v.id,10),quantity:v.qty,properties:{'_Category':cat,'_Item':v.title}})})}
  push(state.shape,'Roselet');
  push(state.material,'Cable');
  push(state.holder,'Holder');
  push(state.cable,'Shade');
  return items;
}

function openCartDrawer(){
  document.dispatchEvent(new CustomEvent('cart:open'));
  document.dispatchEvent(new CustomEvent('drawer:open',{detail:{drawer:'cart'}}));
  document.dispatchEvent(new CustomEvent('theme:cart:open'));
  var cd=document.querySelector('cart-drawer');
  if(cd){if(typeof cd.open==='function'){cd.open();return}cd.removeAttribute('hidden');cd.setAttribute('open','');cd.setAttribute('aria-hidden','false');cd.classList.add('active','animate','is-open');var ov=document.querySelector('.overlay,.drawer-overlay,.js-overlay');if(ov)ov.classList.add('active','is-visible');return}
  var sel=['#CartDrawer','#cart-drawer','#cart-sidebar','.cart-drawer','.drawer--cart','[data-cart-drawer]','[data-drawer="cart"]','#MiniCart','#mini-cart','.mini-cart'];
  for(var i=0;i<sel.length;i++){var d=document.querySelector(sel[i]);if(d){d.classList.add('active','is-open','open','drawer--open','is-visible');d.setAttribute('open','');d.setAttribute('aria-hidden','false');d.removeAttribute('hidden');var ov2=document.querySelector('.overlay,.drawer-overlay,.cart-drawer-overlay,.js-overlay');if(ov2)ov2.classList.add('active','is-visible');return}}
  var icon=document.querySelector('.header__icon--cart,[data-cart-toggle],[data-cart-icon],button[aria-label*="cart" i],a[href="/cart"]');
  if(icon)icon.click();
}

function onSubmit(e){
  e.preventDefault();state.submitAttempted=true;
  var items=buildItems();if(!items.length)return;
  showToast('loading','Wird zum Warenkorb hinzugefügt…');el.atcBtn.disabled=true;
  fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})})
  .then(function(r){if(!r.ok)return r.json().then(function(d){throw new Error(d.description||d.message||'Warenkorb-Fehler')});return r.json()})
  .then(function(){try{sessionStorage.setItem('pc_openCart','1')}catch(e){}showToast('success','Zum Warenkorb hinzugefügt!');window.location.reload()})
  .catch(function(err){console.error('PC:',err);hideToast(0);el.atcBtn.disabled=false;alert('Fehler: '+(err.message||'Bitte versuchen Sie es erneut.'))});
}

document.addEventListener('mousedown',function(e){
  if(e.target.closest('.pc-tab-btn')||e.target.closest('.pc-inline-panel')||e.target.closest('#atcBtn')||e.target.closest('#pcToast')||e.target.closest('.pc-cu-copy')||e.target.closest('#pcLightbox')||e.target.closest('.pc-coup-cat'))return;
  closeAll();
});

function initCouponCatClicks(){
  var map = {
    catItemR: { btnId: 'ddBtnR1', panelId: 'ddPanelR1', groupId: 'groupShape' },
    catItemC: { btnId: 'ddBtnK1', panelId: 'ddPanelK1', groupId: 'groupMaterial' },
    catItemH: { btnId: 'ddBtnH1', panelId: 'ddPanelH1', groupId: 'groupHolder' },
    catItemS: { btnId: 'ddBtnS1', panelId: 'ddPanelS1', groupId: 'groupCable' }
  };
  Object.keys(map).forEach(function(catId){
    var catEl = g(catId);
    if(!catEl) return;
    catEl.addEventListener('click', function(){
      var cfg = map[catId];
      var btn = g(cfg.btnId), panel = g(cfg.panelId), group = g(cfg.groupId);
      if(!btn || !panel) return;
      openPanel(btn, panel);
      var target = group || btn;
      setTimeout(function(){
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 80);
    });
  });
}


function checkReload(){
  try{if(sessionStorage.getItem('pc_openCart')==='1'){sessionStorage.removeItem('pc_openCart');setTimeout(openCartDrawer,400)}}catch(e){}
}
function init(){
  initTabs();initClose();initCards();initLightbox();initCouponCatClicks();
  var form=g('pcForm');if(form)form.addEventListener('submit',onSubmit);
  updateAll();checkReload();
  var firstBtn=g('ddBtnR1'),firstPanel=g('ddPanelR1');
  if(firstBtn&&firstPanel)openPanel(firstBtn,firstPanel);
}
document.readyState==='loading'?document.addEventListener('DOMContentLoaded',init):init();

/* ══ FEEDBACK MODAL JS ══ */
(function(){
  var fbModal=document.getElementById('pcFeedbackModal');
  var fbOpen=document.getElementById('pcOpenFeedback');
  var fbClose=document.getElementById('pcFbClose');
  var fbEmailStep=document.getElementById('pcFbEmailStep');
  var fbTextStep=document.getElementById('pcFbTextStep');
  var fbEmail=document.getElementById('pcFbEmail');
  var fbNextBtn=document.getElementById('pcFbNextBtn');
  var fbText=document.getElementById('pcFbText');
  var fbSubmitBtn=document.getElementById('pcFbSubmitBtn');
  var fbThankyou=document.getElementById('pcFbThankyou');
  var fbScrollPos=0;

  function openFb(){
    fbScrollPos=window.pageYOffset;
    fbModal.style.display='block';
    document.body.style.position='fixed';
    document.body.style.top='-'+fbScrollPos+'px';
  }
  function closeFb(){
    fbModal.style.display='none';
    document.body.style.position='';
    document.body.style.top='';
    window.scrollTo(0,fbScrollPos);
    fbEmail.value='';fbText.value='';
    fbThankyou.style.display='none';
    fbSubmitBtn.style.display='block';
    fbEmailStep.style.display='block';
    fbTextStep.style.display='none';
  }

  if(fbOpen)fbOpen.onclick=openFb;
  if(fbClose)fbClose.onclick=closeFb;
  window.addEventListener('click',function(e){if(e.target===fbModal)closeFb()});

  if(fbNextBtn)fbNextBtn.onclick=function(){
    var email=fbEmail.value.trim();
    if(!email.includes('@')||!email.includes('.')){alert('Bitte geben Sie eine gültige E-Mail-Adresse ein.');return;}
    fbEmailStep.style.display='none';
    fbTextStep.style.display='block';
  };

  if(fbSubmitBtn)fbSubmitBtn.onclick=function(){
    var payload={
      product_id:window.location.href,
      product_title:window.location.href,
      shop_domain:'{{ shop.domain }}',
      customer_email:fbEmail.value.trim(),
      reason:fbText.value.trim(),
      other_reason:'N/A',
      timestamp:new Date().toISOString()
    };
    fetch('https://listings.vintageinterior.co.uk/api/get-feedback-from-shopify',{
      method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)
    }).catch(function(){});
    fbThankyou.style.display='block';
    fbSubmitBtn.style.display='none';
    setTimeout(closeFb,2000);
  };
})();
})();
</script>

