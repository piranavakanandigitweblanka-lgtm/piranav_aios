<!-- HTML: Pop-up Modal -->
<div id="popup" class="popup">
    <div class="popup-content">
        <button id="closeButton" class="close-button">×</button>
        <h2>Ihre Meinung zählt</h2>
        <p>Jetzt anmelden und exklusiven Zugang erhalten</p>
        <p class="voucher-text"><strong>Genießen Sie ein 20%-Angebot</strong> *</p>
        <button id="saveButton">Zur Umfrage</button>
    </div>
</div>

<script>
window.onload = function() {

    function isCartOpen() {
        // THE REAL TRIGGER: bls__opend-popup-header class on header_minicart
        var header = document.querySelector('.header_minicart');
        if (header && header.classList.contains('bls__opend-popup-header')) {
            return true;
        }

        // Backup: sessionStorage check for after add-to-cart reload
        try {
            if (sessionStorage.getItem('pc_openCart') === '1') {
                return true;
            }
        } catch(e) {}

        return false;
    }

    // Show popup after 6.5s ONLY if cart is not open
    setTimeout(function() {
        if (!isCartOpen()) {
            document.getElementById("popup").style.display = "flex";
        }
    }, 6500);

    // Auto-hide after 14.5s
    setTimeout(function() {
        document.getElementById("popup").style.display = "none";
    }, 14500);

    // Watch for cart opening WHILE popup is visible → hide immediately
    var observer = new MutationObserver(function() {
        if (isCartOpen()) {
            document.getElementById("popup").style.display = "none";
        }
    });

    observer.observe(document.body, {
        attributes: true,
        subtree: true,
        attributeFilter: ['class']
    });

    // Click dark overlay → close
    document.getElementById("popup").addEventListener("click", function(event) {
        if (event.target == this) {
            this.style.display = "none";
        }
    });

    // Click X → close
    document.getElementById("closeButton").addEventListener("click", function() {
        document.getElementById("popup").style.display = "none";
    });

    // Click survey button → redirect
    document.getElementById("saveButton").addEventListener("click", function() {
        window.location.href = 'https://ledsone.de/pages/bewertung-erhalten';
    });

}
</script>

<!-- CSS: Style for the Popup -->
