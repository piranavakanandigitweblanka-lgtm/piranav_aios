  <!-- DELIVERY TIMER SCRIPT -->
  <script>
    (function () {
      const DELIVERY_DAYS_BEFORE_NOON = 2;
      const DELIVERY_DAYS_AFTER_NOON = 3;

      const container = document.querySelector('.estimated-delivery-snippet');
      if (!container) return;

      const localDateEl = container.querySelector('.local-delivery-date');
      const orderNowTimerEl = container.querySelector('.order-now-timer');

      if (!localDateEl || !orderNowTimerEl) return;

      function isWeekendHidden() {
        const now = getGermanTime();
        const day = now.getDay();
        const hour = now.getHours();
        if (day === 5 && hour >= 12) return true; // CHANGED Kuberan 29/06/2026: was hour >= 11 → now hour >= 12 (Friday hide starts at noon, not 11am)
        if (day === 6 && hour < 12) return true;  // CHANGED Kuberan 29/06/2026: was hour < 11 → now hour < 12 (Saturday restart at noon, not 11am)
        return false;
      }

      function getGermanTime() {
        const now = new Date();
        const germanTimeString = now.toLocaleString('en-US', {
          timeZone: 'Europe/Berlin',
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', second: '2-digit',
          hour12: false
        });
        return new Date(germanTimeString);
      }

      function getNextNoon() {
        const now = getGermanTime();
        const nextNoon = new Date(now);
        nextNoon.setHours(12, 0, 0, 0); // CHANGED Kuberan 29/06/2026: was setHours(11,0,0,0) → now 12 (countdown target is noon, not 11am)
        if (now.getHours() >= 12) nextNoon.setDate(nextNoon.getDate() + 1); // CHANGED Kuberan 29/06/2026: was >= 11 → now >= 12 (rollover to next day after noon)
        return nextNoon;
      }

      function formatTimer(ms) {
        if (ms <= 0) return 'Today';
        const totalSeconds = Math.floor(ms / 1000);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        return `${hours}h ${minutes}m ${seconds}s`;
      }

      function updateTimers() {
        if (isWeekendHidden()) {
          container.style.display = 'none';
          return;
        }

        const now = getGermanTime();
        const nowHour = now.getHours();

        // ADDED Kuberan 29/06/2026: hide widget during 11:00 AM–12:00 PM Europe/Berlin (daily restart/reset window — was not present before)
        if (nowHour >= 11 && nowHour < 12) {
          container.style.display = 'none';
          return;
        }

        container.style.display = 'inline-flex'; // CHANGED Kuberan 29/06/2026: moved here from inside else-branch of isWeekendHidden check (now set only after restart-window passes)

        const nextNoon = getNextNoon();
        const remainingTime = nextNoon - now;

        if (orderNowTimerEl) orderNowTimerEl.textContent = formatTimer(remainingTime);

        const deliveryDate = new Date(now);
        if (now.getHours() < 12) { // CHANGED Kuberan 29/06/2026: was < 11 → now < 12 (before noon = 2-day delivery; matches new 12pm cutoff)
          deliveryDate.setDate(deliveryDate.getDate() + DELIVERY_DAYS_BEFORE_NOON);
        } else {
          deliveryDate.setDate(deliveryDate.getDate() + DELIVERY_DAYS_AFTER_NOON);
        }

        const day = String(deliveryDate.getDate()).padStart(2, '0');
        const month = String(deliveryDate.getMonth() + 1).padStart(2, '0');
        const year = deliveryDate.getFullYear();
        localDateEl.textContent = `${day}/${month}/${year}`;
      }

      setInterval(updateTimers, 1000);
      updateTimers();
    })();
  </script>

  <!-- FREE SHIPPING BAR SCRIPT -->
  <script>
    (function () {
      const bar = document.getElementById('fs-shipping-bar');
      if (!bar) return;

      const fill = document.getElementById('fs-bar-fill');
      const text = document.getElementById('fs-bar-text');
      const threshold = parseInt(bar.dataset.threshold, 10);

      let currentCartTotal = 0;

      function formatMoney(cents) {
        return (cents / 100).toLocaleString('de-DE', {
          minimumFractionDigits: 2, maximumFractionDigits: 2
        }) + ' EUR';
      }

      function updateBar(total) {
        const remaining = threshold - total;
        const progress = Math.min((total / threshold) * 100, 100);
        fill.style.width = progress + '%';

        if (total >= threshold) {
          fill.classList.add('fs-complete');
          text.classList.add('fs-unlocked');
          bar.classList.add('fs-done');
          bar.querySelector('svg').style.stroke = '#2e7d32';
          text.innerHTML = 'Du genießt <strong>KOSTENLOSEN VERSAND!</strong><br>(In den Warenkorb legen, um kostenlosen Versand zu erhalten.)';
        } else {
          fill.classList.remove('fs-complete');
          text.classList.remove('fs-unlocked');
          bar.classList.remove('fs-done');
          bar.querySelector('svg').style.stroke = '#1a6fc4';
          text.innerHTML = `Ausgeben <strong>${formatMoney(remaining)}</strong> mehr zu genießen (Deutschland) <span class="fs-cart-bar__highlight">KOSTENLOSER VERSAND!</span>`;
        }
      }

      function getProductPrice() {
        try {
          const productJson = document.querySelector('[data-product-json]');
          if (productJson) {
            const product = JSON.parse(productJson.textContent);
            const variantInput = document.querySelector('input[name="id"]');
            if (variantInput) {
              const variantId = parseInt(variantInput.value, 10);
              const variant = product.variants.find(v => v.id === variantId);
              return variant ? variant.price : 0;
            }
            return product.variants[0].price;
          }
        } catch(e) {}
        return 0;
      }

      function getQuantity() {
        const qtyInput = document.querySelector('.quantity__input, input[name="quantity"]');
        return qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;
      }

      function recalcWithQty() {
        const productPrice = getProductPrice();
        const qty = getQuantity();
        const projected = currentCartTotal + (productPrice * qty);
        updateBar(projected);
      }

      function fetchCart() {
        fetch('/cart.js', { headers: { 'Content-Type': 'application/json' } })
          .then(r => r.json())
          .then(cart => { currentCartTotal = cart.total_price; recalcWithQty(); })
          .catch(err => console.warn('FS bar error:', err));
      }

      document.addEventListener('click', function (e) {
        const btn = e.target.closest('[name="minus"], [name="plus"], .quantity__button');
        if (btn) setTimeout(recalcWithQty, 100);
      });

      document.addEventListener('input', function (e) {
        if (e.target.matches('.quantity__input, input[name="quantity"]')) recalcWithQty();
      });

      document.addEventListener('change', function (e) {
        if (e.target.closest('variant-selects, .product-form')) setTimeout(recalcWithQty, 200);
      });

      const _fetch = window.fetch;
      window.fetch = function (...args) {
        const url = typeof args[0] === 'string' ? args[0] : (args[0]?.url || '');
        const isCartChange = /\/cart\/(add|change|update)/.test(url);
        return _fetch.apply(this, args).then(res => {
          if (isCartChange) setTimeout(fetchCart, 600);
          return res;
        });
      };

      document.addEventListener('cart:updated', fetchCart);
      document.addEventListener('cart:refresh', fetchCart);
      document.addEventListener('submit', function (e) {
        const form = e.target.closest('form[data-type="add-to-cart-form"]');
        if (form) setTimeout(fetchCart, 800);
      });

      fetchCart();
    })();
  </script>

</body>

