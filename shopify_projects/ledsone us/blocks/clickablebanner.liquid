{% doc %}
  @prompt
    IMAGE BANNER FOR ALL DEVICES MAIN dessktop(2000*400px) and mobile (800*250px) and banner link create this section?

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-banner-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .ai-image-banner-link-{{ ai_gen_id }}:hover {
    transform: scale({{ block.settings.hover_scale | divided_by: 100.0 }});
  }

  .ai-image-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-image-banner-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-image-banner-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-image-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 400px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-image-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 6px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
  }

  .ai-image-banner-content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: {{ block.settings.text_color }};
    z-index: 2;
    max-width: 90%;
  }

  .ai-image-banner-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .ai-image-banner-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
    opacity: 0.9;
    line-height: 1.4;
  }

  @media screen and (max-width: 768px) {
    .ai-image-banner-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-image-banner-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-image-banner-placeholder-{{ ai_gen_id }} {
      height: 250px;
    }

    .ai-image-banner-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-image-banner-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }
  }
{% endstyle %}<div class="ai-image-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.banner_link != blank %}
    <a href="{{ block.settings.banner_link }}" class="ai-image-banner-link-{{ ai_gen_id }}">
  {% endif %}

  {% if block.settings.desktop_image or block.settings.mobile_image %}
    {% if block.settings.desktop_image %}
      <img
        src="{{ block.settings.desktop_image | image_url: width: 2000, height: 400 }}"
        alt="{{ block.settings.desktop_image.alt | escape }}"
        width="2000"
        height="400"
        loading="lazy"
        class="ai-image-banner-image-{{ ai_gen_id }} ai-image-banner-desktop-{{ ai_gen_id }}"
      >
    {% endif %}

    {% if block.settings.mobile_image %}
      <img
        src="{{ block.settings.mobile_image | image_url: width: 770, height: 450 }}"
        alt="{{ block.settings.mobile_image.alt | escape }}"
        width="600"
        height="250"
        loading="lazy"
        class="ai-image-banner-image-{{ ai_gen_id }} ai-image-banner-mobile-{{ ai_gen_id }}"
      >
    {% elsif block.settings.desktop_image %}
      <img
        src="{{ block.settings.desktop_image | image_url: width: 800, height: 250 }}"
        alt="{{ block.settings.desktop_image.alt | escape }}"
        width="800"
        height="250"
        loading="lazy"
        class="ai-image-banner-image-{{ ai_gen_id }} ai-image-banner-mobile-{{ ai_gen_id }}"
      >
    {% endif %}

    {% if block.settings.overlay_opacity > 0 %}
      <div class="ai-image-banner-overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-image-banner-content-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-image-banner-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-image-banner-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}
  {% else %}
    <div class="ai-image-banner-placeholder-{{ ai_gen_id }}">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
      <div class="ai-image-banner-empty-state-{{ ai_gen_id }}">
        Add desktop and mobile banner images
      </div>
    </div>
  {% endif %}

  {% if block.settings.banner_link != blank %}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Image banner",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner link"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 36
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 20
    },
    {
      "type": "range",
      "id": "hover_scale",
      "min": 100,
      "max": 110,
      "step": 1,
      "unit": "%",
      "label": "Hover scale",
      "default": 102
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Image banner"
    }
  ],
  "tag": null
}
{% endschema %}