{"sections":{"page_heading_GMaNDE":{"type":"page-heading","blocks":{"1_e7Mz4t":{"type":"1","settings":{"page_title":"Refund policy","text_fs":36}}},"block_order":["1_e7Mz4t"],"disabled":true,"name":"t:sections.page-heading.name","settings":{"container":"container","color_scheme":"","show_banner":false,"min_height":200,"parallax":false,"show_overlay":false,"overlay":54,"design":"text-overlay-image","text_postion":"text-center"}},"main":{"type":"main-page","disabled":true,"custom_css":[".page-title {display: none;}"],"settings":{}},"custom_html_pFEFVc":{"type":"custom-html","name":"t:sections.custom-html.name","settings":{"heading_logo_svg":"","subheading":"","heading":"","description":"","text_alignment":"text-center","container":"container","color_scheme":"","content_html":"<p> <\/p>\n\n<style>\n \n  \/* Base \/ body *\/\n  html, body {\n    margin: 0;\n    padding: 0;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    font-family: \"Inter\", \"Poppins\", \"Segoe UI\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    background: #f8fafc; \/* soft slate background *\/\n    color: #0f172a; \/* deep slate for headings\/body *\/\n  }\n\n  \/* Keep your initial custom scrollbar idea, but modernized *\/\n  ::-webkit-scrollbar {\n    width: 8px;\n    height: 8px;\n  }\n  ::-webkit-scrollbar-track {\n    background: #f1f5f9; \/* slate-100 *\/\n    border-radius: 8px;\n  }\n  ::-webkit-scrollbar-thumb {\n    background: linear-gradient(180deg, #f59e0b, #fbbf24); \/* amber gradient *\/\n    border-radius: 8px;\n    border: 2px solid rgba(255,255,255,0.55);\n    background-clip: padding-box;\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background: linear-gradient(180deg, #fbbf24, #facc15);\n  }\n\n  \/* Container root *\/\n  .bg-white {\n    background: linear-gradient(180deg, #ffffff 0%, #fffefe 100%);\n  }\n  main {\n    -webkit-font-smoothing: antialiased;\n  }\n\n  \/* Headings *\/\n  h1 {\n    font-size: 2.25rem; \/* 36px *\/\n    line-height: 1.05;\n    font-weight: 800;\n    letter-spacing: -0.02em;\n    color: #0b1220;\n    margin: 0;\n  }\n  @media (min-width: 640px) {\n    h1 { font-size: 3.75rem; } \/* 60px on larger screens (matches sm:text-6xl) *\/\n  }\n  h1 span, .text-amber-500 {\n    color: transparent;\n    background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    font-weight: 800;\n  }\n\n  h2 {\n    font-size: 1.625rem; \/* 26px *\/\n    margin: 0 0 0.5rem 0;\n    color: #071127;\n  }\n  h3, h4 {\n    color: #071127;\n    margin: 0;\n  }\n\n  p {\n    margin-top: 0;\n    margin-bottom: 1rem;\n  }\n\n  \/* Page blocks and spacing *\/\n  .max-w-4xl { max-width: 64rem; }          \/* keep consistent with your classes *\/\n  .lg\\:max-w-6xl { max-width: 72rem; }\n  .xl\\:max-w-7xl { max-width: 80rem; }\n  .mx-auto { margin-left: auto; margin-right: auto; }\n  .px-6 { padding-left: 1.5rem; padding-right: 1.5rem; }\n  .py-12 { padding-top: 3rem; padding-bottom: 3rem; }\n  .sm\\:py-20 { padding-top: 5rem; padding-bottom: 5rem; }\n\n  header.text-center { text-align: center; }\n\n  \/* Intro paragraph with left border *\/\n  .border-l-4 {\n    border-left-width: 4px;\n    border-style: solid;\n    border-left-color: #f59e0b;\n  }\n  .pl-6 { padding-left: 1.5rem; }\n  .mb-16 { margin-bottom: 4rem; }\n  .text-xl { font-size: 1.125rem; line-height: 1.6; } \/* 18px *\/\n  .leading-relaxed { line-height: 1.8; }\n  .text-slate-800 { color: #1e293b; }\n  .text-slate-600 { color: #475569; }\n\n  \/* Section headers style enhancement *\/\n  section h2 {\n    display: inline-block;\n    padding-bottom: 0.5rem;\n    position: relative;\n  }\n  section h2::after {\n    content: \"\";\n    display: block;\n    height: 4px;\n    width: 72px;\n    border-radius: 999px;\n    background: linear-gradient(90deg,#f59e0b,#fbbf24);\n    margin-top: 0.65rem;\n  }\n\n  \/* Grid helpers (kept minimal to avoid conflicts with theme) *\/\n  .grid { display: grid; }\n  .grid-cols-1 { grid-template-columns: 1fr; }\n  @media (min-width: 768px) { .md\\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n  .gap-6 { gap: 1.5rem; }\n  .mt-8 { margin-top: 2rem; }\n\n  \/* Cards *\/\n  .bg-slate-100 {\n    background: linear-gradient(180deg, #f8fafc 0%, #fdfdfd 100%);\n    border: 1px solid rgba(15,23,42,0.04);\n  }\n  .p-6 { padding: 1.5rem; }\n  .rounded-lg {\n    border-radius: 12px;\n    overflow: hidden;\n  }\n  .shadow-lg {\n    box-shadow: 0 10px 30px rgba(2,6,23,0.06);\n  }\n\n  \/* card hover effect *\/\n  .hover\\:glow { transition: transform .28s ease, box-shadow .28s ease; }\n  .hover\\:glow:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(245,158,11,0.12), 0 6px 18px rgba(2,6,23,0.08); }\n\n  \/* Timelines: preserve your absolute markers, but improve visuals *\/\n  .relative { position: relative; }\n  .pl-10 { padding-left: 2.5rem; }\n  .absolute { position: absolute; }\n  .left-0 { left: 0; }\n  .top-0 { top: 0; }\n  .bottom-0 { bottom: 0; }\n  \/* Vertical accent line on timeline (thin) *\/\n  .relative.space-y-12 > .absolute.left-0 {\n    left: -1.25rem;\n    top: 0.75rem;\n    bottom: 0.5rem;\n    width: 3px;\n    background: linear-gradient(180deg,#f59e0b,#fbbf24);\n    border-radius: 8px;\n    opacity: 0.95;\n  }\n  .relative.pl-10 > .absolute.-left-2 {\n    left: -1.1rem;\n    top: 0.6rem;\n    height: 1rem;\n    width: 1rem;\n    border-radius: 999px;\n    background: linear-gradient(180deg,#fbbf24,#f59e0b);\n    border: 4px solid #ffffff;\n    box-shadow: 0 2px 10px rgba(245,158,11,0.12);\n  }\n\n  .text-amber-500 { color: #f59e0b; font-weight: 600; }\n\n  \/* Icons + list spacing *\/\n  .list-disc { list-style-type: disc; }\n  .list-inside { padding-left: 0; margin-left: 0; }\n  .space-y-2 > * + * { margin-top: 0.5rem; }\n  .space-y-6 > * + * { margin-top: 1.5rem; }\n\n  \/* Images: keep your sizes and interaction (preserve srcs) *\/\n  .group { position: relative; overflow: hidden; border-radius: 12px; }\n  .group img {\n    display: block;\n    width: 100%;\n    height: 16rem; \/* 64 *\/\n    object-fit: cover;\n    transition: transform .45s cubic-bezier(.22,.9,.22,1), filter .35s ease;\n  }\n  .group:hover img { transform: scale(1.05); filter: brightness(1.06); }\n  .group .absolute.inset-0 { transition: opacity .32s ease; opacity: 0; }\n  .group:hover .absolute.inset-0 { opacity: 1; }\n\n  \/* Quote *\/\n  blockquote {\n    border-left: 5px solid rgba(245,158,11,1);\n    padding: 1.25rem;\n    background: linear-gradient(180deg,#fffaf0,#fffdf7);\n    border-radius: 10px;\n    font-style: italic;\n    color: #92400e;\n    box-shadow: 0 8px 22px rgba(245,158,11,0.06);\n  }\n\n  \/* Values grid hover micro interactions *\/\n  .transform { transform: translateZ(0); }\n  .hover\\:-translate-y-2:hover { transform: translateY(-8px); transition: transform .28s ease; }\n\n  \/* Small helpers *\/\n  .text-slate-700 { color: #334155; }\n  .text-slate-500 { color: #6b7280; }\n  .font-bold { font-weight: 700; }\n  .font-extrabold { font-weight: 800; }\n\n  \/* Responsive tweaks *\/\n  @media (max-width: 640px) {\n    .px-6 { padding-left: 1rem; padding-right: 1rem; }\n    .group img { height: 12rem; }\n    h1 { font-size: 2rem; }\n  }\n\n  \/* Subtle page entrance animation for sections (non-invasive) *\/\n  [data-animate-section] { opacity: 0; transform: translateY(12px); transition: opacity .6s ease, transform .6s ease; }\n  [data-animate-section].visible { opacity: 1; transform: translateY(0); }\n\n<\/style>\n\n<div class=\"bg-white text-slate-700\">\n  <main class=\"max-w-4xl lg:max-w-6xl xl:max-w-7xl mx-auto px-6 py-12 sm:py-20\">\n\n    <header class=\"text-center mb-20\">\n      <h1 class=\"text-4xl sm:text-6xl font-extrabold text-slate-900 tracking-tighter leading-tight\">The <span class=\"text-amber-500\">Ledsone<\/span> Story<\/h1>\n      <p class=\"mt-4 text-xl sm:text-2xl text-slate-600\">Brightening Every Corner of Life<\/p>\n    <\/header>\n\n    <p class=\"text-xl text-slate-800 leading-relaxed border-l-4 border-amber-500 pl-6 mb-16\">At Ledsone, we believe that light is more than just illumination — it’s a symbol of progress, comfort, and inspiration. Our vision is clear: to create modern lighting solutions that are stylish, functional, sustainable, and affordable. We bring warmth, innovation, and eco-friendly brilliance into homes and businesses worldwide.<\/p>\n\n    <section class=\"py-12 sm:py-16\" data-animate-section=\"\">\n      <h2 class=\"text-3xl font-bold text-slate-900 mb-8 tracking-tight sm:text-4xl\">A Vision Born in the UK<\/h2>\n      <div class=\"space-y-6 text-slate-700 leading-relaxed text-lg\">\n        <p>The Ledsone journey began in April 2015 in Coventry, United Kingdom, with a simple mission: to deliver quality products at an affordable price. We started small on eBay, where customers quickly recognized our reliability. Encouraged by this, we expanded to Amazon, reaching a larger audience who shared our appreciation for dependable, energy-efficient lighting.<\/p>\n        <p>Within months, we launched our official website, creating a home for our brand and building an identity associated with trust, affordability, and long-lasting quality.<\/p>\n      <\/div>\n    <\/section>\n\n    <section class=\"py-12 sm:py-16\" data-animate-section=\"\">\n      <h2 class=\"text-3xl font-bold text-slate-900 mb-8 tracking-tight sm:text-4xl\">Growth Beyond Borders<\/h2>\n      <div class=\"relative space-y-12\">\n        <div class=\"absolute left-0 top-0 bottom-0 w-0.5 bg-slate-200\"><br><\/div>\n        <div class=\"relative pl-10\">\n          <div class=\"absolute -left-2 top-1 h-4 w-4 rounded-full bg-amber-400 border-4 border-white ring-2 ring-amber-400\"><br><\/div>\n          <p class=\"text-amber-500 font-semibold text-lg\">2021<\/p>\n          <h3 class=\"text-2xl font-bold text-slate-900 mt-1\">Germany<\/h3>\n          <p class=\"mt-2 text-slate-600\">We opened a warehouse in Germany to serve the European Union with faster delivery and localized service.<\/p>\n        <\/div>\n        <div class=\"relative pl-10\">\n          <div class=\"absolute -left-2 top-1 h-4 w-4 rounded-full bg-amber-400 border-4 border-white ring-2 ring-amber-400\"><br><\/div>\n          <p class=\"text-amber-500 font-semibold text-lg\">2022<\/p>\n          <h3 class=\"text-2xl font-bold text-slate-900 mt-1\">Canada<\/h3>\n          <p class=\"mt-2 text-slate-600\">We entered the Canadian market under the brand RelicElectrical.<\/p>\n        <\/div>\n        <div class=\"relative pl-10\">\n          <div class=\"absolute -left-2 top-1 h-4 w-4 rounded-full bg-amber-400 border-4 border-white ring-2 ring-amber-400\"><br><\/div>\n          <p class=\"text-amber-500 font-semibold text-lg\">2025<\/p>\n          <h3 class=\"text-2xl font-bold text-slate-900 mt-1\">USA<\/h3>\n          <p class=\"mt-2 text-slate-600\">We proudly launched in the United States, extending our reach to North America.<\/p>\n        <\/div>\n      <\/div>\n      <p class=\"mt-8 pt-8 border-t border-slate-200 text-lg\">Today, Ledsone serves customers across Europe, the USA, Canada, and Australia, earning the trust of more than <span class=\"font-bold text-amber-500\">1 million happy customers<\/span> worldwide.<\/p>\n    <\/section>\n\n    <section class=\"py-12 sm:py-16\" data-animate-section=\"\">\n      <h2 class=\"text-3xl font-bold text-slate-900 mb-8 tracking-tight sm:text-4xl\">Where You Can Find Us<\/h2>\n      <div class=\"space-y-6 text-slate-700 leading-relaxed text-lg\">\n        <p>To ensure accessibility and trust, Ledsone maintains a strong presence across online and offline retail channels:<\/p>\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 mt-8\">\n          <div class=\"bg-slate-100 p-6 rounded-lg\">\n            <h3 class=\"font-bold text-slate-900 text-lg mb-2\">Official Websites<\/h3>\n            <ul class=\"text-slate-600 space-y-1\">\n              <li>ledsone.co.uk, ledsone.de, ledsone.fr, ledsone.nl, ledsone.us<\/li>\n            <\/ul>\n          <\/div>\n          <div class=\"bg-slate-100 p-6 rounded-lg\">\n            <h3 class=\"font-bold text-slate-900 text-lg mb-2\">Marketplaces<\/h3>\n            <ul class=\"text-slate-600 space-y-1\">\n              <li>Amazon, eBay, and B&amp;Q<\/li>\n            <\/ul>\n          <\/div>\n          <div class=\"bg-slate-100 p-6 rounded-lg md:col-span-2\">\n            <h3 class=\"font-bold text-slate-900 text-lg mb-2\">Other Brands in Our Family<\/h3>\n            <ul class=\"text-slate-600 space-y-1 sm:flex sm:space-y-0 sm:space-x-4\">\n              <li>Electricalsone<\/li>\n              <li>DC Voltage<\/li>\n              <li>RelicElectrical<\/li>\n            <\/ul>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/section>\n\n    <section class=\"py-12 sm:py-16\" data-animate-section=\"\">\n      <h2 class=\"text-3xl font-bold text-slate-900 mb-8 tracking-tight sm:text-4xl\">Lighting Solutions for Every Space<\/h2>\n      <div class=\"space-y-6 text-slate-700 leading-relaxed text-lg\">\n        <p>Our story is not only about growth but also about the products that power it. Ledsone specializes in a wide range of LED lighting solutions designed for both practicality and creativity.<\/p>\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 mt-8\">\n          <div class=\"bg-slate-100 p-6 rounded-lg\">\n            <div class=\"flex items-center text-amber-500 mb-4\">\n<svg stroke-width=\"2\" stroke=\"currentColor\" viewbox=\"0 0 24 24\" fill=\"none\" class=\"w-8 h-8\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><\/path><\/svg>\n              <h4 class=\"text-xl font-semibold text-slate-900 ml-4\">LED Bulbs<\/h4>\n            <\/div>\n            <ul class=\"list-disc list-inside text-slate-600 space-y-2\">\n              <li>E27 bayonet &amp; screw<\/li>\n              <li>Filament &amp; dimmable<\/li>\n              <li>Smart bulbs<\/li>\n            <\/ul>\n          <\/div>\n          <div class=\"bg-slate-100 p-6 rounded-lg\">\n            <div class=\"flex items-center text-amber-500 mb-4\">\n<svg stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" fill=\"none\" class=\"w-8 h-8\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.83-5.83M11.42 15.17l-4.24-4.24a5.25 5.25 0 017.42-7.42L15.17 11.42M11.42 15.17l-4.24 4.24a5.25 5.25 0 01-7.42-7.42l4.24-4.24\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><\/path><\/svg>\n              <h4 class=\"text-xl font-semibold text-slate-900 ml-4\">Fixtures &amp; Fittings<\/h4>\n            <\/div>\n            <ul class=\"list-disc list-inside text-slate-600 space-y-2\">\n              <li>Pendant &amp; wall lights<\/li>\n              <li>Pipe &amp; conduit fittings<\/li>\n              <li>Ceiling roses<\/li>\n            <\/ul>\n          <\/div>\n          <div class=\"bg-slate-100 p-6 rounded-lg\">\n            <div class=\"flex items-center text-amber-500 mb-4\">\n<svg stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" fill=\"none\" class=\"w-8 h-8\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 21v-1.5M15.75 3v1.5M12 4.5v15M15.75 21v-1.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><\/path><\/svg>\n              <h4 class=\"text-xl font-semibold text-slate-900 ml-4\">Drivers &amp; Transformers<\/h4>\n            <\/div>\n            <ul class=\"list-disc list-inside text-slate-600 space-y-2\">\n              <li>5V, 12V, and 24V options<\/li>\n              <li>Reliable power solutions<\/li>\n            <\/ul>\n          <\/div>\n          <div class=\"bg-slate-100 p-6 rounded-lg\">\n            <div class=\"flex items-center text-amber-500 mb-4\">\n<svg stroke-width=\"2\" stroke=\"currentColor\" viewbox=\"0 0 24 24\" fill=\"none\" class=\"w-8 h-8\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><\/path><\/svg>\n              <h4 class=\"text-xl font-semibold text-slate-900 ml-4\">Specialty &amp; Accessories<\/h4>\n            <\/div>\n            <ul class=\"list-disc list-inside text-slate-600 space-y-2\">\n              <li>Vintage filament styles<\/li>\n              <li>Fabric cables &amp; switches<\/li>\n              <li>Emergency lighting<\/li>\n            <\/ul>\n          <\/div>\n        <\/div>\n        <p class=\"mt-6 text-slate-500\">Beyond lighting, our range extends to household and office essentials like clocks, kitchen gadgets, and postal bags — all crafted with the same focus on quality.<\/p>\n      <\/div>\n    <\/section>\n\n    \n    <section class=\"py-12 sm:py-16\" data-animate-section=\"\">\n      <h2 class=\"text-3xl font-bold text-slate-900 mb-8 tracking-tight sm:text-4xl\">A Brand Built on Values<\/h2>\n      <div class=\"space-y-6 text-slate-700 leading-relaxed text-lg\">\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          <div class=\"bg-slate-100 p-6 rounded-lg shadow-lg transform hover:-translate-y-2 transition-transform duration-300\">\n            <div class=\"flex items-center mb-4\">\n              <div class=\"text-amber-500\"><svg stroke-width=\"2\" stroke=\"currentColor\" viewbox=\"0 0 24 24\" fill=\"none\" class=\"w-8 h-8\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><\/path><\/svg><\/div>\n              <h3 class=\"text-xl font-bold text-slate-900 ml-3\">Innovation<\/h3>\n            <\/div>\n            <p class=\"text-slate-600\">We are committed to delivering cutting-edge, modern designs that combine style with long-lasting performance.<\/p>\n          <\/div>\n          <div class=\"bg-slate-100 p-6 rounded-lg shadow-lg transform hover:-translate-y-2 transition-transform duration-300\">\n            <div class=\"flex items-center mb-4\">\n              <div class=\"text-amber-500\"><svg stroke-width=\"2\" stroke=\"currentColor\" viewbox=\"0 0 24 24\" fill=\"none\" class=\"w-8 h-8\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><\/path><\/svg><\/div>\n              <h3 class=\"text-xl font-bold text-slate-900 ml-3\">Sustainability<\/h3>\n            <\/div>\n            <p class=\"text-slate-600\">Our eco-friendly lighting helps reduce energy costs and contributes to a greener, more sustainable future.<\/p>\n          <\/div>\n          <div class=\"bg-slate-100 p-6 rounded-lg shadow-lg transform hover:-translate-y-2 transition-transform duration-300\">\n            <div class=\"flex items-center mb-4\">\n              <div class=\"text-amber-500\"><svg stroke-width=\"2\" stroke=\"currentColor\" viewbox=\"0 0 24 24\" fill=\"none\" class=\"w-8 h-8\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M13 10V3L4 14h7v7l9-11h-7z\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><\/path><\/svg><\/div>\n              <h3 class=\"text-xl font-bold text-slate-900 ml-3\">Energy Efficiency<\/h3>\n            <\/div>\n            <p class=\"text-slate-600\">We ensure every product helps you save on energy bills without compromising on brightness or quality.<\/p>\n          <\/div>\n          <div class=\"bg-slate-100 p-6 rounded-lg shadow-lg transform hover:-translate-y-2 transition-transform duration-300\">\n            <div class=\"flex items-center mb-4\">\n              <div class=\"text-amber-500\"><svg stroke-width=\"2\" stroke=\"currentColor\" viewbox=\"0 0 24 24\" fill=\"none\" class=\"w-8 h-8\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M15 21a6 6 0 00-9-5.197m0 0A10.004 10.004 0 0012 11.197M15 21a6 6 0 01-5.197-9m0 0A10.004 10.004 0 0112 11.197\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><\/path><\/svg><\/div>\n              <p class=\"text-xl font-bold text-slate-900 ml-3\">Customer Satisfaction<\/p>\n            <\/div>\n            <p class=\"text-slate-600\">Our promise is to deliver quality, affordability, and a seamless experience to our 1 million+ customers.<\/p>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/section>\n\n    <section class=\"py-12 sm:py-16\" data-animate-section=\"\">\n      <p class=\"text-3xl font-bold text-slate-900 mb-8 tracking-tight sm:text-4xl\">Lighting the Future Together<\/p>\n      <div class=\"space-y-6 text-slate-700 leading-relaxed text-lg\">\n        <p>As we continue to grow, our commitment remains the same: to be a trusted partner for customers seeking sustainable, energy-efficient, and contemporary LED fixtures. Our journey is far from over — in fact, it’s just beginning. Together with our community, we’re building a future where every space shines with light, innovation, and possibility.<\/p>\n        <blockquote class=\"mt-10 text-center text-2xl italic text-amber-600 font-medium p-6 bg-slate-100 rounded-lg\">\"At Ledsone, we don’t just sell lights. We brighten lives.\"<\/blockquote>\n      <\/div>\n    <\/section>\n\n  <\/main>\n<\/div>\n\n<script>\n  \/* Simple, lightweight section entrance observer — non-invasive and safe for Shopify *\/\n  (function(){\n    try {\n      var els = document.querySelectorAll('[data-animate-section]');\n      if (!('IntersectionObserver' in window) || !els.length) {\n        els.forEach(function(i){ i.classList.add('visible'); });\n        return;\n      }\n      var io = new IntersectionObserver(function(entries){\n        entries.forEach(function(e){\n          if (e.isIntersecting) {\n            e.target.classList.add('visible');\n            io.unobserve(e.target);\n          }\n        });\n      }, { threshold: 0.15 });\n      els.forEach(function(el){ io.observe(el); });\n    } catch (err) {\n      \/* fail silently — keep page functional *\/\n      console.error(err);\n    }\n  })();\n<\/script>","padding_top":0,"padding_bottom":0,"reset_spacing":false}}},"order":["page_heading_GMaNDE","main","custom_html_pFEFVc"]}