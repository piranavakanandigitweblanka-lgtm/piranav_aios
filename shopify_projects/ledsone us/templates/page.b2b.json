{"sections":{"page_heading_GMaNDE":{"type":"page-heading","blocks":{"1_e7Mz4t":{"type":"1","settings":{"page_title":"Trade page","text_fs":36}}},"block_order":["1_e7Mz4t"],"name":"t:sections.page-heading.name","settings":{"container":"container","color_scheme":"scheme-d127e173-a562-42f4-a41e-3483b672d918","show_banner":false,"min_height":200,"parallax":false,"show_overlay":false,"overlay":54,"design":"text-overlay-image","text_postion":"text-center"}},"main":{"type":"main-page","disabled":true,"custom_css":[".page-title {display: none;}"],"settings":{}},"custom_html_YWpy4w":{"type":"custom-html","name":"t:sections.custom-html.name","settings":{"heading_logo_svg":"","subheading":"","heading":"","description":"","text_alignment":"text-center","container":"container","color_scheme":"","content_html":"<section class=\"trade-section\">\n  <div class=\"title-row\">\n    <h2 class=\"trade-title\">Secure Your Bulk Discount!<\/h2>\n    <a href=\"#app-embed\" class=\"register-top-btn\">Register<\/a>\n  <\/div>\n\n  <div class=\"benefits-container\">\n    <div class=\"benefit\">\n      <div class=\"benefit-icon\">%<\/div>\n      <p>Special Prices<\/p>\n    <\/div>\n\n    <div class=\"benefit\">\n      <div class=\"benefit-icon\">🎧<\/div>\n      <p>Personal Support<\/p>\n    <\/div>\n\n    <div class=\"benefit\">\n      <div class=\"benefit-icon\">👤<\/div>\n      <p>Custom Products<\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"cta\">\n    <!-- Email Button -->\n    <a href=\"https:\/\/mail.google.com\/mail\/?view=cm&amp;fs=1&amp;to=info@ledsone.us&amp;su=Bulk%20Discount%20Inquiry&amp;body=Hi%2C%0A%0AI%20am%20interested%20in%20the%20bulk%20discount.\" class=\"email-btn\">\n      <img width=\"48\" height=\"48\" src=\"https:\/\/img.icons8.com\/color\/48\/gmail-new.png\" alt=\"gmail-new\" class=\"email-icon\">\n      Send Email Now\n      <i class=\"fas fa-circle online-icon\"><\/i>\n    <\/a>\n  <\/div>\n<\/section>\n\n<style>\n  .trade-section {\n    background-color: #ffffff;\n    color: #111827;\n    font-family: \"Inter\", sans-serif;\n    padding: 35px 20px;\n  }\n\n  \/* Title and Register button *\/\n  .title-row {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 25px;\n    margin-bottom: 15px;\n    flex-wrap: wrap;\n  }\n\n  .trade-title {\n    font-size: 24px;\n    font-weight: 600;\n    color: #111827;\n    margin: 0;\n  }\n\n  .register-top-btn {\n    border: 2px solid #111827;\n    color: #111827;\n    background: #ffffff;\n    padding: 8px 20px;\n    border-radius: 8px;\n    font-size: 15px;\n    font-weight: 600;\n    text-decoration: none;\n    transition: all 0.3s ease;\n    cursor: pointer;\n  }\n\n  .register-top-btn:hover {\n    background: #111827;\n    color: #ffffff;\n  }\n\n  \/* Benefits section *\/\n  .benefits-container {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 25px;\n    flex-wrap: wrap;\n    margin-bottom: 20px;\n  }\n\n  .benefit {\n    text-align: center;\n  }\n\n  .benefit-icon {\n    width: 55px;\n    height: 55px;\n    background-color: #fff;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 24px;\n    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);\n    margin: 0 auto 6px;\n  }\n\n  .benefit p {\n    font-size: 14px;\n    font-weight: 500;\n    color: #1f2937;\n    margin: 0;\n  }\n\n  \/* Button styling *\/\n  .cta {\n    text-align: center;\n    margin-top: 10px;\n    display: flex;\n    justify-content: center;\n    gap: 20px;\n  }\n\n  \/* Email button *\/\n  .email-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background-color: #003366;\n    color: white;\n    font-weight: 600;\n    font-size: 15px;\n    padding: 12px 26px;\n    border-radius: 40px;\n    text-decoration: none;\n    transition: background 0.3s ease;\n    box-shadow: 0 3px 8px rgba(0, 51, 102, 0.25);\n  }\n\n  .email-btn:hover {\n    background-color: #00204d;\n  }\n\n  .email-icon {\n    width: 20px;\n    height: 20px;\n    margin-right: 10px;\n  }\n\n  \/* Online Icon Styling *\/\n  .online-icon {\n    color: green;\n    font-size: 12px;\n    margin-left: 10px;\n  }\n\n  \/* Mobile *\/\n  @media (max-width: 768px) {\n    .trade-title {\n      font-size: 16px;\n    }\n\n    .register-top-btn {\n      font-size: 14px;\n      padding: 7px 16px;\n    }\n\n    .benefits-container {\n      gap: 35px;\n    }\n\n    .email-btn {\n      padding: 10px 22px;\n      font-size: 14px;\n    }\n  }\n<\/style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    const registerBtn = document.querySelector('.register-top-btn');\n    registerBtn.addEventListener('click', function (e) {\n      e.preventDefault();\n      const formSection = document.querySelector('#app-embed');\n      if (formSection) {\n        formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });\n      } else {\n        console.warn(\"Registration form not found. Make sure the form container has the ID #app-embed.\");\n      }\n    });\n  });\n<\/script>","padding_top":0,"padding_bottom":0,"reset_spacing":true}},"custom_html_MkCRjH":{"type":"custom-html","name":"t:sections.custom-html.name","settings":{"heading_logo_svg":"","subheading":"","heading":"","description":"","text_alignment":"text-center","container":"container","color_scheme":"","content_html":"<section class=\"steps-section\">\n  <h2>Register as a Business Customer – Quick &amp; Easy!<\/h2>\n\n  <div class=\"steps-container\">\n\n    <!-- Step 1 -->\n    <div class=\"step-box\">\n      <div class=\"step-icon\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"#1f1f1f\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"60\" height=\"60\">\n          <path d=\"M20 21v-2a4 4 0 0 0-3-3.87\"><\/path>\n          <path d=\"M4 21v-2a4 4 0 0 1 3-3.87\"><\/path>\n          <circle cx=\"12\" cy=\"7\" r=\"4\"><\/circle>\n        <\/svg>\n      <\/div>\n      <h3>Step 1<\/h3>\n      <h4>Create an Account &amp; Unlock Benefits<\/h4>\n      <p>Fill out the registration form completely to immediately benefit from all exclusive partner conditions and advantages — starting from your very first order.<\/p>\n    <\/div>\n\n    <!-- Step 2 -->\n    <div class=\"step-box\">\n      <div class=\"step-icon\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"#1f1f1f\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"60\" height=\"60\">\n          <path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"><\/path>\n          <polyline points=\"22,6 12,13 2,6\"><\/polyline>\n        <\/svg>\n      <\/div>\n      <h3>Step 2<\/h3>\n      <h4>Verification &amp; Contact<\/h4>\n      <p>After registration, you can reach us directly via\n        <a href=\"https:\/\/mail.google.com\/mail\/?view=cm&amp;fs=1&amp;to=info@ledsone.us&amp;su=B2B%20Registration%20-%20Verification&amp;body=Hi%2C%0A%0AI%20have%20just%20registered%20as%20a%20business%20customer%20and%20would%20like%20to%20proceed%20with%20verification.\" target=\"_blank\" class=\"email-link\">\n          Email\n        <\/a>\n        to speed up the process. Alternatively, we will contact you to verify your details and activate your account.\n      <\/p>\n    <\/div>\n\n    <!-- Step 3 -->\n    <div class=\"step-box\">\n      <div class=\"step-icon\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"#1f1f1f\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"60\" height=\"60\">\n          <circle cx=\"12\" cy=\"12\" r=\"10\"><\/circle>\n          <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"><\/line>\n          <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"><\/line>\n        <\/svg>\n      <\/div>\n      <h3>Step 3<\/h3>\n      <h4>Get Exclusive Discounts<\/h4>\n      <p>Once your account is verified, you can start shopping. Based on your order volume and value, we will provide you with exclusive discount codes for future purchases.<\/p>\n    <\/div>\n\n   \n\n<style>\n  .steps-section {\n    text-align: center;\n    padding: 60px 20px;\n    background-color: #ffffff;\n    font-family: \"Inter\", sans-serif;\n  }\n\n  .steps-section h2 {\n    font-size: 28px;\n    font-weight: 700;\n    margin-bottom: 40px;\n    color: #111111;\n  }\n\n  .steps-container {\n    display: flex;\n    justify-content: center;\n    align-items: stretch;\n    flex-wrap: wrap;\n    gap: 80px;\n    max-width: 1600px;\n    margin: 0 auto;\n  }\n\n  .step-box {\n    background: #f8f8f8;\n    border-radius: 16px;\n    box-shadow: 0 3px 10px rgba(0,0,0,0.05);\n    flex: 1 1 300px;\n    max-width: 340px;\n    padding: 30px 20px;\n    transition: box-shadow 0.3s ease, transform 0.3s ease;\n  }\n\n  .step-box:hover {\n    box-shadow: 0 8px 16px rgba(0,0,0,0.1);\n    transform: translateY(-2px);\n  }\n\n  .step-icon {\n    margin-bottom: 20px;\n  }\n\n  .step-box h3 {\n    font-size: 20px;\n    color: #1f1f1f;\n    margin-bottom: 8px;\n  }\n\n  .step-box h4 {\n    font-size: 17px;\n    font-weight: 600;\n    color: #2e2e2e;\n    margin-bottom: 10px;\n  }\n\n  .step-box p {\n    font-size: 15px;\n    color: #3a3a3a;\n    line-height: 1.6;\n  }\n\n  .step-box a {\n    color: #1f1f1f;\n    font-weight: 600;\n    text-decoration: underline;\n  }\n\n  .step-box .email-link {\n    color: #003366;\n    text-decoration: none;\n    font-weight: 600;\n  }\n\n  .step-box .email-link:hover {\n    text-decoration: underline;\n  }\n\n  @media (max-width: 768px) {\n    .steps-section h2 {\n      font-size: 22px;\n    }\n    .step-box {\n      max-width: 100%;\n    }\n  }\n<\/style>\n<\/div><\/section>","padding_top":0,"padding_bottom":0,"reset_spacing":true}},"1776682407eef321e0":{"type":"apps","blocks":{"forms_inline_bbWhky":{"type"