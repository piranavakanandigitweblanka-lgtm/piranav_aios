{"sections":{"page_heading_GMaNDE":{"type":"page-heading","blocks":{"1_e7Mz4t":{"type":"1","settings":{"page_title":"Review Us","text_fs":36}}},"block_order":["1_e7Mz4t"],"name":"t:sections.page-heading.name","settings":{"container":"container","color_scheme":"","show_banner":false,"min_height":200,"parallax":false,"show_overlay":false,"overlay":54,"design":"text-overlay-image","text_postion":"text-center"}},"main":{"type":"main-page","disabled":true,"custom_css":[".page-title {display: none;}"],"settings":{}},"custom_html_Dga8Lt":{"type":"custom-html","name":"t:sections.custom-html.name","settings":{"heading_logo_svg":"","subheading":"","heading":"","description":"","text_alignment":"text-center","container":"container","color_scheme":"","content_html":"<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Customer Review Form<\/title>\n    <style>\n        #reviewForm {\n            border: 1px solid #ddd;\n            padding: 15px;\n            margin-bottom: 30px;\n            background-color: #f9f9f9;\n        }\n\n        #reviewForm input, #reviewForm select, #reviewForm textarea {\n            width: 100%;\n            padding: 10px;\n            margin: 5px 0;\n            border: 1px solid #ccc;\n        }\n\n        #reviewsSection {\n            margin-top: 50px;\n        }\n\n        .review {\n            border: 1px solid #ddd;\n            padding: 15px;\n            margin-top: 15px;\n            background-color: #f1f1f1;\n        }\n\n        .review img {\n            display: block;\n            margin-top: 10px;\n            max-width: 200px;\n            height: auto;\n        }\n    <\/style>\n\n\n\n    <h2>Leave a Review<\/h2>\n    <form id=\"reviewForm\" enctype=\"multipart\/form-data\">\n        <label for=\"name\">Your Name:<\/label><br>\n        <input type=\"text\" id=\"name\" name=\"name\" required=\"\"><br><br>\n\n        <label for=\"email\">Your Email:<\/label><br>\n        <input type=\"email\" id=\"email\" name=\"email\" required=\"\"><br><br>\n\n        <label for=\"rating\">Rating (1 to 5):<\/label><br>\n        <select id=\"rating\" name=\"rating\" required=\"\">\n            <option value=\"1\">1<\/option>\n            <option value=\"2\">2<\/option>\n            <option value=\"3\">3<\/option>\n            <option value=\"4\">4<\/option>\n            <option value=\"5\">5<\/option>\n        <\/select><br><br>\n\n        <label for=\"review\">Your Review:<\/label><br>\n        <textarea id=\"review\" name=\"review\" rows=\"4\" cols=\"50\" required=\"\"><\/textarea><br><br>\n\n        <label for=\"photo\">Upload a Photo (optional):<\/label><br>\n        <input type=\"file\" id=\"photo\" name=\"photo\" accept=\"image\/*\"><br><br>\n\n        <button type=\"submit\">Submit Review<\/button>\n    <\/form>\n\n    <hr>\n\n    <!-- Display Reviews Section -->\n    <div id=\"reviewsSection\">\n        <h3>Customer Reviews<\/h3>\n        <div id=\"reviewsList\">\n            <!-- Reviews will be displayed here -->\n        <\/div>\n    <\/div>\n\n    <script>\n        \/\/ Replace this with your Google Apps Script Web App URL\n        var googleScriptUrl = 'https:\/\/script.google.com\/macros\/s\/AKfycbwPAIVumQQVYBpG1OBqrIE66D2gARCltrcvRJTZpl2fWJ9t1TA0XCNO9thTxn185KMT0A\/exec';  \/\/ Replace with the actual URL you got from Google Apps Script deployment\n\n        \/\/ Function to display a review\n        function displayReview(review) {\n            var reviewContainer = document.getElementById('reviewsList');\n            var reviewElement = document.createElement('div');\n            reviewElement.classList.add('review');\n            \n            var reviewContent = `\n                <p><strong>${review.name}<\/strong> - Rating: ${review.rating}<\/p>\n                <p>${review.reviewText}<\/p>\n            `;\n            \n            \/\/ Display the photo if uploaded\n            if (review.photo) {\n                reviewContent += `<img src=\"${review.photo}\" alt=\"Review photo\" style=\"max-width: 200px; margin-top: 10px;\" \/>`;\n            }\n            \n            reviewElement.innerHTML = reviewContent;\n            reviewContainer.appendChild(reviewElement);\n        }\n\n        \/\/ Function to handle form submission\n        document.getElementById('reviewForm').addEventListener('submit', function(event) {\n            event.preventDefault();\n\n            var name = document.getElementById('name').value;\n            var email = document.getElementById('email').value;\n            var rating = document.getElementById('rating').value;\n            var reviewText = document.getElementById('review').value;\n            var photoInput = document.getElementById('photo');\n\n            \/\/ Handle the photo upload\n            var photoURL = null;\n            if (photoInput.files.length > 0) {\n                photoURL = URL.createObjectURL(photoInput.files[0]);\n            }\n\n            \/\/ Create a new review object\n            var newReview = {\n                name: name,\n                email: email,\n                rating: rating,\n                reviewText: reviewText,\n                photo: photoURL\n            };\n\n            \/\/ Send the review data to Google Apps Script (Google Sheets)\n            fetch(googleScriptUrl, {\n                method: 'POST',\n                headers: {\n                    'Content-Type': 'application\/json',\n                },\n                body: JSON.stringify(newReview),\n            })\n            .then(response => response.json()) \/\/ Assuming response is in JSON format\n            .then(data => {\n                alert('Thank you for your review!');\n\n                \/\/ Optionally display the review immediately (if desired)\n                displayReview(newReview);\n\n                \/\/ Reset the form\n                document.getElementById('reviewForm').reset();\n            })\n            .catch(error => {\n                console.error('Error:', error);\n                alert('There was an issue submitting your review. Please try again.');\n            });\n        });\n    <\/script>","padding_top":0,"padding_bottom":0,"reset_spacing":false}}},"order":["page_heading_GMaNDE","main","custom_html_Dga8Lt"]}