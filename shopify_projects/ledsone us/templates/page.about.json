b2d9c6f4c","show_banner":false,"min_height":200,"parallax":false,"show_overlay":false,"overlay":54,"design":"text-overlay-image","text_postion":"text-center"}},"custom_html_6MALMz":{"type":"custom-html","name":"t:sections.custom-html.name","settings":{"heading_logo_svg":"","subheading":"","heading":"","description":"","text_alignment":"text-center","container":"container","color_scheme":"","content_html":"<!-- Intro Section -->\n<section style=\"background: white; padding: 60px 0; text-align: center;\">\n<div style=\"max-width: 1200px; margin: 0 auto; padding: 0 20px;\">\n<div style=\"max-width: 900px; margin: 0 auto;\">\n<h2 style=\"color: #2c3e50; margin-bottom: 20px;\">Our Story<\/h2>\n<p style=\"margin-bottom: 15px;\">At Ledsone, we believe lighting is more than just illumination – it's about creating comfort, enhancing spaces, and inspiring lifestyles. Since our founding, we have dedicated ourselves to providing customers worldwide with high-quality LED lighting solutions at affordable prices.<\/p>\n<p style=\"margin-bottom: 15px;\">From our humble beginnings, we have grown into a trusted international retailer serving customers across the UK, Europe, Canada, and the USA. With 500+ employees, fulfillment centres in the UK, Germany, and now the USA, we combine global reach with local reliability to ensure every order is handled with care.<\/p>\n<\/div>\n<\/div>\n<\/section>\n<!-- Features Section -->\n<section style=\"background: #f8f9fa; padding: 60px 0;\">\n<div style=\"max-width: 1200px; margin: 0 auto; padding: 0 20px;\">\n<h2 style=\"color: #2c3e50; margin-bottom: 20px; text-align: center;\">Why Choose Ledsone?<\/h2>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-top: 40px;\">\n<div style=\"background: white; padding: 30px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05); transition: transform 0.3s ease;\">\n<div style=\"font-size: 2.5rem; color: #3498db; margin-bottom: 20px;\">\n<i class=\"fas fa-box-open\"><\/i><br>\n<\/div>\n<h3 style=\"color: #2c3e50; margin-bottom: 20px;\">1,000+ Products<\/h3>\n<p style=\"margin-bottom: 15px;\">From modern LEDs and decorative fixtures to practical everyday lighting, our catalogue is continuously updated to meet both home and business needs.<\/p>\n<\/div>\n<div style=\"background: white; padding: 30px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05); transition: transform 0.3s ease;\">\n<div style=\"font-size: 2.5rem; color: #3498db; margin-bottom: 20px;\">\n<i class=\"fas fa-globe-americas\"><\/i><br>\n<\/div>\n<h3 style=\"color: #2c3e50; margin-bottom: 20px;\">Global Shipping<\/h3>\n<p style=\"margin-bottom: 15px;\">We proudly deliver across the UK, Europe, Canada, and the USA, backed by a strong logistics network.<\/p>\n<\/div>\n<div style=\"background: white; padding: 30px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05); transition: transform 0.3s ease;\">\n<div style=\"font-size: 2.5rem; color: #3498db; margin-bottom: 20px;\">\n<i class=\"fas fa-users\"><\/i><br>\n<\/div>\n<h3 style=\"color: #2c3e50; margin-bottom: 20px;\">Customer First<\/h3>\n<p style=\"margin-bottom: 15px;\">We offer flexible payment methods, hassle-free returns, and responsive customer support to give you confidence with every purchase.<\/p>\n<\/div>\n<div style=\"background: white; padding: 30px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05); transition: transform 0.3s ease;\">\n<div style=\"font-size: 2.5rem; color: #3498db; margin-bottom: 20px;\">\n<i class=\"fas fa-shipping-fast\"><\/i><br>\n<\/div>\n<h3 style=\"color: #2c3e50; margin-bottom: 20px;\">Fast &amp; Reliable Delivery<\/h3>\n<p style=\"margin-bottom: 15px;\">With warehouses in three continents, our logistics network ensures quick dispatch and dependable shipping.<\/p>\n<\/div>\n<div style=\"background: white; padding: 30px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05); transition: transform 0.3s ease;\">\n<div style=\"font-size: 2.5rem; color: #3498db; margin-bottom: 20px;\">\n<i class=\"fas fa-lightbulb\"><\/i><br>\n<\/div>\n<h3 style=\"color: #2c3e50; margin-bottom: 20px;\">Expert Knowledge<\/h3>\n<p style=\"margin-bottom: 15px;\">Our dedicated support team helps you choose the right lighting for your space, whether for homes, offices, or large commercial projects.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<\/section>\n<!-- Mission Section -->\n<section style=\"background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%); color: white; padding: 60px 0;\">\n<div style=\"max-width: 1200px; margin: 0 auto; padding: 0 20px;\">\n<h2 style=\"color: white; margin-bottom: 20px; text-align: center;\">Our Mission<\/h2>\n<p style=\"margin-bottom: 15px; text-align: center;\">We are committed to making sustainable, energy-efficient lighting accessible worldwide. By focusing on LED technology, we not only help our customers save on energy costs but also contribute to reducing environmental impact.<\/p>\n<\/div>\n<\/section>\n<!-- Timeline Section (Reformatted Two-Column Layout) -->\n<section style=\"background: white; padding: 60px 0;\">\n  <div style=\"max-width: 1200px; margin: 0 auto; padding: 0 20px;\">\n    <h2 style=\"color: #2c3e50; margin-bottom: 40px; text-align: center;\">Our Journey<\/h2>\n    \n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;\">\n      \n      <div style=\"background: white; padding: 25px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);\">\n        <div style=\"font-weight: bold; color: #3498db; font-size: 1.2rem; margin-bottom: 10px;\">2015<\/div>\n        <p>Ledsone was founded with a vision to provide affordable, high-quality LED products to UK households.<\/p>\n      <\/div>\n\n      <div style=\"background: white; padding: 25px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);\">\n        <div style=\"font-weight: bold; color: #3498db; font-size: 1.2rem; margin-bottom: 10px;\">2018<\/div>\n        <p>Expansion to Europe, with a dedicated warehouse in Germany.<\/p>\n      <\/div>\n\n      <div style=\"background: white; padding: 25px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);\">\n        <div style=\"font-weight: bold; color: #3498db; font-size: 1.2rem; margin-bottom: 10px;\">2020<\/div>\n        <p>Strengthened back-office operations in Sri Lanka, scaling to over 100 staff to ensure smooth order management and customer support.<\/p>\n      <\/div>\n\n      <div style=\"background: white; padding: 25px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);\">\n        <div style=\"font-weight: bold; color: #3498db; font-size: 1.2rem; margin-bottom: 10px;\">2023<\/div>\n        <p>Surpassed 500 employees and expanded product range to 1,000+ items.<\/p>\n      <\/div>\n\n      <div style=\"background: white; padding: 25px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);\">\n        <div style=\"font-weight: bold; color: #3498db; font-size: 1.2rem; margin-bottom: 10px;\">2024<\/div>\n        <p>Opened a new warehouse in the USA, allowing us to serve North American customers faster and more efficiently.<\/p>\n      <\/div>\n\n      <div style=\"background: white; padding: 25px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);\">\n        <div style=\"font-weight: bold; color: #3498db; font-size: 1.2rem; margin-bottom: 10px;\">Today<\/div>\n        <p>Ledsone continues to innovate, expand globally, and serve a growing community of loyal customers across multiple continents.<\/p>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/section>\n<!-- Promise Section -->\n<section style=\"background: #f8f9fa; padding: 60px 0; text-align: center;\">\n<div style=\"max-width: 1200px; margin: 0 auto; padding: 0 20px;\">\n<h2 style=\"color: #2c3e50; margin-bottom: 20px;\">Our Promise<\/h2>\n<p style=\"margin-bottom: 15px;\">At Ledsone, we stand by three values: quality, trust, and sustainability. Every product is carefully sourced and tested to meet our standards, and every order is backed by our commitment to excellent service.<\/p>\n<div style=\"display: flex; justify-content: center; flex-wrap: wrap; gap: 30px; margin-top: 40px;\">\n<div style=\"background: white; padding: 30px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05); width: 300px; transition: transform 0.3s ease;\">\n<div style=\"font-size: 2.5rem; color: #3498db; margin-bottom: 20px;\">\n<i class=\"fas fa-award\"><\/i><br>\n<\/div>\n<h3 style=\"color: #2c3e50; margin-bottom: 20px;\">Quality<\/h3>\n<p style=\"margin-bottom: 15px;\">Rigorous testing and careful selection process for all our products.<\/p>\n<\/div>\n<div style=\"background: white; padding: 30px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05); width: 300px; transition: transform 0.3s ease;\">\n<div style=\"font-size: 2.5rem; color: #3498db; margin-bottom: 20px;\">\n<i class=\"fas fa-handshake\"><\/i><br>\n<\/div>\n<h3 style=\"color: #2c3e50; margin-bottom: 20px;\">Trust<\/h3>\n<p style=\"margin-bottom: 15px;\">Building long-term relationships with customers through transparency and reliability.<\/p>\n<\/div>\n<div style=\"background: white; padding: 30px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05); width: 300px; transition: transform 0.3s ease;\">\n<div style=\"font-size: 2.5rem; color: #3498db; margin-bottom: 20px;\">\n<i class=\"fas fa-leaf\"><\/i><br>\n<\/div>\n<h3 style=\"color: #2c3e50; margin-bottom: 20px;\">Sustainability<\/h3>\n<p style=\"margin-bottom: 15px;\">Promoting energy-efficient solutions for a greener future.<\/p>\n<\/div>\n<\/div>\n<p style=\"margin-top: 40px; font-style: italic;\">Because for us, lighting isn't just business—it's about brightening lives worldwide.<\/p>\n<\/div>\n<\/section>\n<!-- Footer -->","padding_top":0,"padding_bottom":0,"reset_spacing":false}},"custom_html_xdzATn":{"type":"custom-html","name":"t:sections.custom-html.name","settings":{"heading_logo_svg":"","subheading":"","heading":"","description":"","text_alignment":"text-center","container":"container","color_scheme":"","content_html":"<div class=\"review-section-wrapper\" style=\"padding: 20px; background-color: #f8f9fc;\">\n\n  <style>\n    .review-section {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 25px;\n      flex-wrap: wrap; \/* allows stacking on mobile *\/\n      max-width: 100%;\n      text-align: center;\n    }\n\n    @media (max-width: 600px) {\n      .review-section {\n        flex-direction: column;\n        gap: 15px;\n      }\n\n      .google-review-button,\n      .trustpilot-clean-button {\n        width: 100%;\n        justify-content: center;\n      }\n    }\n\n    \/* General Button Styles (For Both Buttons) *\/\n    .review-button {\n      display: inline-flex;\n      align-items: center;\n      padding: 8px 16px;\n      border-radius: 4px;\n      background-color: #ffffff; \/* White background *\/\n      color: black;              \/* Black text *\/\n      font-size: 15px;\n      font-weight: 500;\n      text-decoration: none;\n      cursor: pointer;\n      box-shadow: none;          \/* No box-shadow *\/\n      border: 1px solid #00B67A; \/* Green border *\/\n    }\n\n    \/* Hover Effect *\/\n    .review-button:hover {\n      background-color: #ffffff; \/* No change on hover *\/\n      border-color: #00B67A;     \/* Keep the same green border *\/\n      color: black;              \/* Text stays black *\/\n    }\n\n    \/* Google Review Button Icon Styles *\/\n    .google-review-button img,\n    .trustpilot-star {\n      width: 18px; \/* Adjusted size for consistency *\/\n      height: 18px;\n      margin-right: 5px; \/* Reduced spacing between icon and text *\/\n      border-radius: 5px;\n    }\n\n    \/* Google Review Star Icon *\/\n    .google-star {\n      fill: #FFC300; \/* Yellow color *\/\n     width: 24px;     \n    height: 24px; \n     \n    }\n\n    \/* Trustpilot Star Icon *\/\n    .trustpilot-star {\n      fill: #00B67A; \/* Trustpilot green *\/\n    }\n  <\/style>\n\n  <div class=\"review-section\">\n    <!-- Google Review Button -->\n    <a href=\"https:\/\/search.google.com\/local\/writereview?placeid=ChIJWR7GeYhLd0gR-kkzQoy2fhQ\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"review-button google-review-button\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0250\/4094\/5248\/files\/google_logo.png?v=1732103956\" alt=\"Google G icon\">\n      Google Review\n      <svg class=\"google-star\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewbox=\"0 0 24 24\">\n        <path d=\"M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z\"><\/path>\n      <\/svg>\n    <\/a>\n\n    <!-- Trustpilot Button -->\n    <a href=\"https:\/\/uk.trustpilot.com\/review\/ledsone.co.uk\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"review-button trustpilot-clean-button\">\n      Review us on \n      <svg class=\"trustpilot-star\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewbox=\"0 0 24 24\">\n        <path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.847 1.416 8.261L12 19.896l-7.416 3.96L6 15.595 0 9.748l8.332-1.73z\"><\/path>\n      <\/svg> \n      <strong>Trustpilot<\/strong>\n    <\/a>\n  <\/div>\n<\/div>","padding_top":0,"padding_bottom":0,"reset_spacing":false}},"subscribe_form_Yid3ri":{"type":"subscribe-form","name":"t:sections.newsletters.name","settings":{"heading_logo_svg":"","heading":"Sign up now & get 10% off","description":"<p>Be the first to get the latest news about trends, promotions, and much more!<\/p>","text_alignment":"text-center","container":"container","color_scheme":"","email_placeholder":"Your email address...","btn_text":"Subscribe","form_layout":"vertical","padding_top":0,"padding_bottom":0,"reset_spacing":false}}},"order":["main","d5c751ad-2b85-4c9d-b68f-d9a66d5e9199","174faa98-7109-44fa-bcb2-0fb5dbeea6c3","d2b8393e-8792-40a7-a4c8-5c192feb9e83","4205dfc1-7103-45d0-8f15-320364f52bf1","de27bbae-8b57-4758-bfe7-5ac9b1179505","75a2bab7-280b-45ab-bb79-213765e91dbc","2dc0f1df-4f5b-4b3c-869a-2e69745ae766","26c21a87-4e2f-4f70-a443-ad63d4341ac2","c3ebe82c-835b-4f82-b2f6-b38befcf6797","95d79fa1-7731-438b-9904-b1f771187a9e","b22a2023-fa5f-4a8e-b136-09a7d17cf092","9395d545-fb75-45d2-8b34-0d5e3af71b31","page_heading_qFhnhC","custom_html_6MALMz","custom_html_xdzATn","subscribe_form_Yid3ri"]}