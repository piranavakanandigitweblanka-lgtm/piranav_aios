        "text_alignment": "text-center",
        "container": "container",
        "color_scheme": "",
        "content_html": "<div class=\"review-section-wrapper\" style=\"padding: 20px; background-color: #f8f9fc;\">\n\n  <style>\n    .review-section {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 25px;\n      flex-wrap: wrap;\n      max-width: 100%;\n      text-align: center;\n    }\n\n    @media (max-width: 600px) {\n      .review-section {\n        flex-direction: column;\n        gap: 15px;\n      }\n\n      .google-review-button,\n      .trustpilot-clean-button {\n        width: 100%;\n        justify-content: center;\n      }\n    }\n\n    .review-button {\n      display: inline-flex;\n      align-items: center;\n      padding: 8px 16px;\n      border-radius: 4px;\n      background-color: #ffffff;\n      color: black;\n      font-size: 15px;\n      font-weight: 500;\n      text-decoration: none;\n      cursor: pointer;\n      box-shadow: none;\n      border: 1px solid #00B67A;\n    }\n\n    .review-button:hover {\n      background-color: #ffffff;\n      border-color: #00B67A;\n      color: black;\n    }\n\n    .google-review-button img,\n    .trustpilot-star {\n      width: 18px;\n      height: 18px;\n      margin-right: 5px;\n      border-radius: 5px;\n    }\n\n    .google-star {\n      fill: #FFC300;\n      width: 24px;\n      height: 24px;\n    }\n\n    .trustpilot-star {\n      fill: #00B67A;\n    }\n  <\/style>\n\n  <div class=\"review-section\">\n    <a href=\"https:\/\/g.page\/r\/CVf461BWK9CjEAI\/review\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"review-button google-review-button\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0250\/4094\/5248\/files\/google_logo.png?v=1732103956\" alt=\"Google G icon\">\n      Google Review\n      <svg class=\"google-star\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewbox=\"0 0 24 24\">\n        <path d=\"M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z\"><\/path>\n      <\/svg>\n    <\/a>\n\n    <a href=\"https:\/\/uk.trustpilot.com\/review\/ledsone.co.uk\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"review-button trustpilot-clean-button\">\n      Review us on\n      <svg class=\"trustpilot-star\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewbox=\"0 0 24 24\">\n        <path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.847 1.416 8.261L12 19.896l-7.416 3.96L6 15.595 0 9.748l8.332-1.73z\"><\/path>\n      <\/svg>\n      <strong>Trustpilot<\/strong>\n    <\/a>\n  <\/div>\n<\/div>",
