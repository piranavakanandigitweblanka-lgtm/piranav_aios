{% schema %}
{
  "name": "HVC Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "heading_subtext",
      "label": "Heading Subtext (optional)"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "number",
      "id": "limit",
      "label": "Products limit",
      "default": 12
    },
    {
      "type": "range",
      "id": "left_image_width",
      "label": "Left Image Width",
      "default": 300,
      "min": 100,
      "max": 600,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoscroll Speed (seconds)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Badge Settings"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Christmas Deal"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge Background Color",
      "default": "#064D68"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "default": 40,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "default": 40,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "View More Button"
    },
    {
      "type": "text",
      "id": "view_more_text",
      "label": "SAMMLUNG ANZEIGEN Button Text",
      "default": "SAMMLUNG ANZEIGEN"
    },
    {
      "type": "checkbox",
      "id": "show_view_more",
      "label": "Show View More Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HVC Products"
    }
  ]
}
{% endschema %}

{% assign hide_for_collection = "ledsone-premium-led-beleuchtung" %}
{% assign is_in_collection = false %}
{% for c in product.collections %}
  {% if c.handle == hide_for_collection %}
    {% assign is_in_collection = true %}
  {% endif %}
{% endfor %}

{% unless is_in_collection %}

{% assign pt = section.settings.padding_top %}
{% assign pb = section.settings.padding_bottom %}

<div class="hvc-section-outer" style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;">

  {% if section.settings.heading != blank %}
    <div class="hvc-heading-block" style="text-align: {{ section.settings.heading_alignment }};">
      <h2 class="hvc-heading">{{ section.settings.heading }}</h2>
      {% if section.settings.heading_subtext != blank %}
        <p class="hvc-heading-sub">{{ section.settings.heading_subtext }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="hvc-wrapper">

    <div class="hvc-frame">
      <div class="hvc-container">

        {% assign coll = collections[section.settings.collection] %}

        {% if coll != blank %}
          {% for product in coll.products limit: section.settings.limit %}

          <a href="{{ product.url }}" class="hvc-item">

            {% if section.settings.show_badge %}
              <div class="hvc-badge">
                {{ section.settings.badge_text }}
              </div>
            {% endif %}

            {% assign f = product.variants.first %}
            {% if f.compare_at_price > f.price %}
              {% assign diff = f.compare_at_price | minus: f.price %}
              {% assign percent = diff | times: 100.0 | divided_by: f.compare_at_price | round %}
              <div class="hvc-green-badge">
                -{{ percent }}% OFF
              </div>
            {% endif %}

            <div class="hvc-image">
              <img 
                src="{{ product.featured_image | img_url: '600x600' }}" 
                alt="{{ product.title | escape }}"
                class="main-img"
                loading="{% if forloop.index <= 6 %}eager{% else %}lazy{% endif %}"
                width="220"
                height="220"
              />
            </div>

            <div class="hvc-info">
              <div class="hvc-price">
               {% assign first_variant = product.variants.first %}
                <span class="price">{{ first_variant.price | money }}</span>
                {% if first_variant.compare_at_price > first_variant.price %}
                  <span class="compare">{{ first_variant.compare_at_price | money }}</span>
                {% endif %}
              </div>
              <div class="hvc-title">{{ product.title }}</div>
            </div>

          </a>

          {% endfor %}
        {% else %}
          <p>Select a collection in settings.</p>
        {% endif %}

      </div>
    </div>

    <!-- ✅ VIEW MORE BUTTON -->
    {% if section.settings.show_view_more and coll != blank %}
      <div class="hvc-view-more-wrapper">
        <a href="{{ coll.url }}" class="hvc-view-more-btn">
          {{ section.settings.view_more_text | default: 'SAMMLUNG ANZEIGEN' }}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    {% endif %}

  </div>

</div>

<style>

/* ✅ SECTION OUTER (padding wrapper) */
.hvc-section-outer {
  width: 100%;
}

/* ✅ HEADING STYLES */
.hvc-heading-block {
  width: 100%;
  max-width: 1600px;
  margin: 0 auto 28px auto;
  padding: 0 16px;
}

.hvc-heading {
  font-size: 28px;
  font-weight: 500;
  color: #111111;
  margin: 0 0 6px 0;
  line-height: 1.2;
}

.hvc-heading-sub {
  font-size: 14px;
  color: #666666;
  margin: 0;
  line-height: 1.5;
}

@media only screen and (max-width: 768px) {
  .hvc-heading-block {
    margin-bottom: 20px;
  }
  .hvc-heading {
    font-size: 22px;
  }
}

.hvc-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  min-height: 350px;
}

.hvc-frame {
  width: 1330px;
  max-width: 100%;
  overflow-x: auto;
  scrollbar-width: none;
  display: flex;
  gap: 20px;
}
.hvc-frame::-webkit-scrollbar { display: none; }

.hvc-container {
  display: flex;
  gap: 20px;
  width: max-content;
  padding: 10px 0;
}

.hvc-item {
  width: 220px;
  text-decoration: none;
  color: inherit;
  position: relative;
}

/* ✅ BADGE — color controlled via inline style */
.hvc-badge {
  position: absolute;
  top: -5px;
  left: -5px;
  background-color: {{ section.settings.badge_bg_color }};
  color: {{ section.settings.badge_text_color }};
  padding: 3px 9px;
  font-size: 10px;
  font-weight: 650;
  border-radius: 4px;
  z-index: 1;
}

.hvc-green-badge {
  position: absolute;
  top: -5px;
  right: -5px;
  background: rgb(11, 95, 2);
  color: #fff;
  padding: 3px 9px;
  font-size: 10px;
  font-weight: 650;
  border-radius: 4px;
  z-index: 1;
}

.hvc-image {
  position: relative;
  overflow: hidden;
}

.hvc-image img.main-img {
  width: 100%;
  transition: 0.2s ease;
}

.hvc-price {
  margin-top: 10px;
  font-size: 17px;
  font-weight: 600;
}

.compare {
  text-decoration: line-through;
  margin-left: 5px;
  color: #777;
}

.hvc-title {
  margin-top: 6px;
  font-size: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ✅ VIEW MORE BUTTON STYLES — Outlined */
.hvc-view-more-wrapper {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-top: 22px;
}

.hvc-view-more-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background-color: transparent;
  color: #111111;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  padding: 13px 32px;
  border: 1.5px solid #111111;
  border-radius: 4px;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.hvc-view-more-btn:hover {
  background-color: #111111;
  color: #ffffff;
}

.hvc-view-more-btn svg {
  transition: transform 0.2s ease;
}

.hvc-view-more-btn:hover svg {
  transform: translateX(3px);
  stroke: #ffffff;
}

@media only screen and (max-width: 768px) {
  .hvc-wrapper {
    padding-left: 16px;
    padding-right: 16px;
  }

  .hvc-view-more-btn {
    width: 70%;
    justify-content: center;
    padding: 13px 20px;
  }
}
</style>

<script>
/* AUTOSCROLL */
document.addEventListener("DOMContentLoaded", function () {
  const autoplay = {{ section.settings.autoplay | json }};
  const speed = {{ section.settings.autoplay_speed | json }} * 1000;

  if (!autoplay) return;

  const frame = document.querySelector(".hvc-frame");
  if (!frame) return;

  let cardWidth = 240;

  function autoScrollLeft() {
    if (frame.scrollLeft + frame.clientWidth >= frame.scrollWidth - 5) {
      frame.scrollTo({ left: 0, behavior: "smooth" });
      return;
    }
    frame.scrollBy({ left: cardWidth, behavior: "smooth" });
  }

  setInterval(autoScrollLeft, speed);
});
</script>

{% endunless %}
