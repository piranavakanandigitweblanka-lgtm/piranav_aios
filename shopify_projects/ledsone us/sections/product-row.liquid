{% if template.name == 'product' %}
  {% assign product_collections = product.collections | map: 'handle' %}
  {% assign collections_config = section.blocks %}
  {% assign matched_block = nil %}

  {% for block in collections_config %}
    {% if block.settings.collection %}
      {% assign target_handle = block.settings.collection.handle %}
      {% if product_collections contains target_handle %}
        {% assign matched_block = block %}
        {% break %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% if matched_block %}
  <section class="five-product-row-section">
    <div class="container">
      {% if matched_block.settings.heading != blank %}
        <h2 class="five-product-row-heading" style="text-align: {{ matched_block.settings.heading_alignment }};">
          {{ matched_block.settings.heading }}
        </h2>
      {% endif %}

      <div class="five-product-row">
        {% for i in (1..5) %}
          {% assign product_key = 'product_' | append: i %}
          {% assign product_handle = matched_block.settings[product_key] %}
          {% if product_handle %}
            {% assign product_item = all_products[product_handle] %}
            {% if product_item %}
              <div class="five-product-item">
                <a href="{{ product_item.url }}" class="product-image">
                  <img 
                    src="{{ product_item.featured_image | img_url: '400x' }}" 
                    alt="{{ product_item.title | escape }}"
                    loading="lazy">
                </a>

                <h3 class="product-title">
                  <a href="{{ product_item.url }}">{{ product_item.title | truncate: 45 }}</a>
                </h3>

                <div class="product-prices">
                  {% if product_item.compare_at_price > product_item.price %}
                    <span class="price">{{ product_item.price | money }}</span>
                    <span class="compare-price">{{ product_item.compare_at_price | money }}</span>
                  {% else %}
                    <span class="price">{{ product_item.price | money }}</span>
                  {% endif %}
                </div>

                <div class="product-rating">⭐⭐⭐⭐⭐</div>

                <!-- Quantity Selector + Add to Cart -->
                <form method="post" action="/cart/add" class="add-to-cart-form" data-product-id="{{ product_item.variants.first.id }}">
                  <div class="quantity-wrapper">
                    <button type="button" class="qty-btn minus" aria-label="Decrease quantity">−</button>
                    <input type="number" name="quantity" value="1" min="1" class="qty-input" aria-label="Quantity">
                    <button type="button" class="qty-btn plus" aria-label="Increase quantity">+</button>
                  </div>

                  <input type="hidden" name="id" value="{{ product_item.variants.first.id }}">
                  <button type="submit" class="add-to-cart-btn">Add to cart</button>
                </form>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>

      <!-- Mobile arrows -->
      <button class="mobile-arrow prev" aria-label="Scroll left">‹</button>
      <button class="mobile-arrow next" aria-label="Scroll right">›</button>
    </div>
  </section>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Similar Products",
  "settings": [],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection Setup",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Select Collection" },
        { "type": "text", "id": "heading", "label": "Section Heading", "default": "Similar Products" },
        {
          "type": "select",
          "id": "heading_alignment",
          "label": "Heading Alignment",
          "default": "center",
          "options": [
            { "label": "Left", "value": "left" },
            { "label": "Center", "value": "center" },
            { "label": "Right", "value": "right" }
          ]
        },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "product", "id": "product_3", "label": "Product 3" },
        { "type": "product", "id": "product_4", "label": "Product 4" },
        { "type": "product", "id": "product_5", "label": "Product 5" }
      ]
    }
  ],
  "presets": [
    { "name": "Similar Products by Collection", "category": "Product" }
  ]
}
{% endschema %}

<style>
.container {
  max-width: 1600px;
  width: 100%;
  margin: 0 auto;
  padding: 0 20px;
}

.five-product-row-section {
  padding: 40px 0;
  position: relative;
}

.five-product-row-heading {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 25px;
  color: #000;
}

.five-product-row {
  display: flex;
  justify-content: space-between;
  flex-wrap: nowrap;
  gap: 20px;
}

.five-product-item {
  flex: 1 1 0;
  background: #fff;
  padding: 15px;
  border-radius: 0;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  text-align: center;
  transition: box-shadow 0.25s ease;
}

.five-product-item:hover {
  box-shadow: 0 4px 14px rgba(0,0,0,0.15);
}

.product-image img {
  max-width: 100%;
  height: auto;
  border-radius: 0;
  margin-bottom: 12px;
}

.product-title {
  font-size: 15px;
  font-weight: 600;
  color: #000;
  margin: 10px 0;
}

.product-title a {
  color: inherit;
  text-decoration: none;
}

.product-prices {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin: 8px 0;
}

.price {
  font-weight: bold;
  color: #000;
}

.compare-price {
  text-decoration: line-through;
  color: #888;
  font-size: 13px;
}

.product-rating {
  font-size: 13px;
  margin-bottom: 10px;
}

/* ---------- Quantity + Add to Cart ---------- */
.add-to-cart-form {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
  flex-wrap: nowrap;
}

.quantity-wrapper {
  display: inline-flex;
  align-items: center;
  height: 40px;
  border-radius: 6px;
  background: #f9f9f9;
  border: 1px solid #ddd;
  padding: 0 6px;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* ✅ Always visible + and − buttons */
.qty-btn {
  background: transparent;
  border: none;
  color: #000;
  width: 36px;
  height: 100%;
  font-size: 18px;
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: background 0.2s ease, color 0.2s ease;
  visibility: visible !important;
}

.qty-btn:hover {
  background: #e0e0e0;
  color: #000 !important;
  border-radius: 4px;
}

.qty-input {
  width: 55px;
  text-align: center;
  border: none !important;
  outline: none !important;
  background: transparent !important;
  color: #000;
  font-size: 14px;
  font-weight: 600;
}

/* ---------- Add to Cart Button States ---------- */
.add-to-cart-btn {
  background: #000;
  color: #fff;
  border: none;
  padding: 10px 20px;
  height: 40px;
  min-width: 130px;
  font-size: 13px;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.25s ease;
  white-space: nowrap;
  flex-shrink: 0;
}

/* Green Adding State */
.add-to-cart-btn.adding,
.add-to-cart-btn.adding:hover {
  background: #2e7d32 !important;
  color: #fff !important;
}

/* Teal View Cart State */
.add-to-cart-btn.view-cart,
.add-to-cart-btn.view-cart:hover {
  background: #00a2c2 !important;
  color: #fff !important;
}

/* Normal hover (only when not adding/viewing) */
.add-to-cart-btn:hover:not(.adding):not(.view-cart) {
  background: #333;
}

/* ---------- Responsive ---------- */
.mobile-arrow {
  display: none;
}

@media (max-width: 768px) {
  .five-product-row {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    flex-wrap: nowrap !important;
    gap: 12px;
  }

  .five-product-item {
    flex: 0 0 80%;
    scroll-snap-align: start;
  }

  .mobile-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: #000;
    color: #fff;
    font-size: 22px;
    line-height: 36px;
    text-align: center;
    cursor: pointer;
    z-index: 2;
    padding: 0;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  }

  .mobile-arrow.prev { left: 8px; }
  .mobile-arrow.next { right: 8px; }
}

@media (max-width: 480px) {
  .five-product-item {
    flex: 0 0 85%;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const forms = document.querySelectorAll('.add-to-cart-form');

  forms.forEach(form => {
    const btn = form.querySelector('.add-to-cart-btn');
    const minusBtn = form.querySelector('.qty-btn.minus');
    const plusBtn = form.querySelector('.qty-btn.plus');
    const qtyInput = form.querySelector('.qty-input');

    if (minusBtn && plusBtn && qtyInput) {
      minusBtn.addEventListener('click', () => {
        let val = parseInt(qtyInput.value, 10) || 1;
        if (val > 1) qtyInput.value = val - 1;
      });
      plusBtn.addEventListener('click', () => {
        let val = parseInt(qtyInput.value, 10) || 1;
        qtyInput.value = val + 1;
      });
      qtyInput.addEventListener('input', () => {
        let v = parseInt(qtyInput.value, 10);
        if (!v || v < 1) qtyInput.value = 1;
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (btn.classList.contains('view-cart')) {
        window.location.href = '/cart';
        return;
      }

      const formData = new FormData(form);
      btn.textContent = 'Adding...';
      btn.classList.add('adding');

      const response = await fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        // Show "Adding..." for 3 seconds, then "View Cart" for 5 seconds
        setTimeout(() => {
          btn.textContent = 'View Cart';
          btn.classList.remove('adding');
          btn.classList.add('view-cart');
          btn.onclick = () => window.location.href = '/cart';
        }, 800);

        setTimeout(() => {
          btn.textContent = 'Add to cart';
          btn.classList.remove('view-cart');
          btn.onclick = null;
        }, 4000);
      }
    });
  });

  /* Mobile arrow scroll behavior */
  const sections = document.querySelectorAll('.five-product-row-section');
  sections.forEach(sec => {
    const row = sec.querySelector('.five-product-row');
    const prev = sec.querySelector('.mobile-arrow.prev');
    const next = sec.querySelector('.mobile-arrow.next');

    if (row && prev && next) {
      const gapPx = parseInt(getComputedStyle(row).gap || '12', 10);
      const amount = () => {
        const item = row.querySelector('.five-product-item');
        return item ? item.getBoundingClientRect().width + gapPx : Math.round(row.clientWidth * 0.8);
      };
      prev.addEventListener('click', () => row.scrollBy({ left: -amount(), behavior: 'smooth' }));
      next.addEventListener('click', () => row.scrollBy({ left: amount(), behavior: 'smooth' }));
    }
  });
});
</script>
