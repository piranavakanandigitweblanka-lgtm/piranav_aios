{{ 'ld-shop-by-room.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign st           = section.settings
  assign container    = st.container
  assign color_scheme = st.color_scheme
  assign heading      = st.heading
  assign enabled_animations = settings.animations_enabled

  assign spt_tablet = ''
  if st.padding_top > 50
    assign spt_tablet = ' spt-tablet'
  endif
  assign spt_mobile = ''
  if st.padding_top > 30
    assign spt_mobile = ' spt-mobile'
  endif
  assign spb_tablet = ''
  if st.padding_bottom > 50
    assign spb_tablet = ' spb-tablet'
  endif
  assign spb_mobile = ''
  if st.padding_bottom > 30
    assign spb_mobile = ' spb-mobile'
  endif
  assign reset_spacing = ''
  if st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
-%}

{%- capture section_style -%}
  --section-padding-top: {{ st.padding_top }}px;
  --section-padding-bottom: {{ st.padding_bottom }}px;
  --ldroom-columns: {{ st.columns_desktop | default: 3 }};
{%- endcapture -%}

<section
  class="bls__section{{ spt_tablet }}{{ spb_tablet }}{{ spt_mobile }}{{ spb_mobile }} color-{{ color_scheme }} gradient bls__ld-rooms{{ reset_spacing }}"
  style="{{ section_style | strip | strip_newlines }}"
  id="{{ section.id }}"
>
  <div class="{{ container }} section-full">

    {%- if heading != blank -%}
      <h2 class="ldroom-heading {% if enabled_animations %}scroll-trigger animate--slide-in{% endif %}">{{ heading }}</h2>
    {%- endif -%}

    <div class="ldroom-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col        = collections[block.settings.collection]
          assign room_img   = block.settings.image
          assign room_name  = block.settings.title
          assign room_cta   = block.settings.cta_text
          assign href       = col.url | default: block.settings.url | default: '#'

          if room_name == blank and col != blank
            assign room_name = col.title
          endif
          if room_cta == blank
            assign room_cta = 'Shop the room →'
          endif

          if room_img != blank
            assign feat_img = room_img
          elsif col != blank and col.featured_image != blank
            assign feat_img = col.featured_image
          else
            assign feat_img = blank
          endif
        -%}

        <a
          class="ldroom-card {% if enabled_animations %}scroll-trigger animate--slide-in{% endif %}"
          href="{{ href }}"
          {{ block.shopify_attributes }}
          {% if enabled_animations %}data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}
        >
          {%- if feat_img != blank -%}
            <img
              class="ldroom-img"
              srcset="
                {%- if feat_img.width >= 600 -%}{{ feat_img | image_url: width: 600 }} 600w,{%- endif -%}
                {%- if feat_img.width >= 900 -%}{{ feat_img | image_url: width: 900 }} 900w,{%- endif -%}
                {%- if feat_img.width >= 1200 -%}{{ feat_img | image_url: width: 1200 }} 1200w,{%- endif -%}
                {{ feat_img | image_url }} {{ feat_img.width }}w
              "
              src="{{ feat_img | image_url: width: 900 }}"
              sizes="(min-width: 990px) 33vw, (min-width: 768px) 50vw, 84vw"
              alt="{{ feat_img.alt | default: room_name | escape }}"
              width="{{ feat_img.width }}"
              height="{{ feat_img.height }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'ldroom-placeholder' }}
          {%- endif -%}

          <span class="ldroom-name">{{ room_name }}</span>
          <span class="ldroom-meta">
            {%- if col != blank -%}{{ col.products_count }} lights · {%- endif -%}
            {{ room_cta }}
          </span>
        </a>

      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "LD Shop by Room",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by room"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "default": 3,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "default": "container",
      "options": [
        { "value": "container",       "label": "Default"    },
        { "value": "container-fluid", "label": "Fluid"      },
        { "value": "strecth-width",   "label": "Stretch"    },
        { "value": "full-width",      "label": "Full width" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Room",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Pulls URL and product count automatically"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Room image (overrides collection image)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Room name",
          "info": "Leave blank to use collection name"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link (if no collection selected)"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Shop the room →"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LD Shop by Room",
      "blocks": [
        { "type": "room" },
        { "type": "room" },
        { "type": "room" }
      ]
    }
  ]
}
{% endschema %}
