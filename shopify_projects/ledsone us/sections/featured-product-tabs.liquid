{{ 'featured-product-tabs.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign st           = section.settings
  assign container    = st.container
  assign color_scheme = st.color_scheme
  assign heading      = st.heading
  assign view_all_label = st.view_all_label
  assign view_all_url   = st.view_all_url
  assign limit        = st.limit_products
  assign columns      = st.item_desktop
  assign show_second_image = st.show_second_image
  assign show_wishlist     = st.show_wishlist
  assign enabled_animations = settings.animations_enabled

  assign spt_tablet = ''
  if st.padding_top > 50
    assign spt_tablet = ' spt-tablet'
  endif
  assign spt_mobile = ''
  if st.padding_top > 30
    assign spt_mobile = ' spt-mobile'
  endif
  assign spb_tablet = ''
  if st.padding_bottom > 50
    assign spb_tablet = ' spb-tablet'
  endif
  assign spb_mobile = ''
  if st.padding_bottom > 30
    assign spb_mobile = ' spb-mobile'
  endif
  assign reset_spacing = ''
  if st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
-%}

{%- capture section_style -%}
  --section-padding-top: {{ st.padding_top }}px;
  --section-padding-bottom: {{ st.padding_bottom }}px;
  --fpt-columns: {{ columns }};
{%- endcapture -%}

<section
  class="bls__section{{ spt_tablet }}{{ spb_tablet }}{{ spt_mobile }}{{ spb_mobile }} color-{{ color_scheme }} gradient bls__fpt{{ reset_spacing }}"
  style="{{ section_style | strip | strip_newlines }}"
  id="{{ section.id }}"
>
  <div class="{{ container }} section-full">

    <!-- Section header -->
    <div class="fpt-head{% if enabled_animations %} scroll-trigger animate--slide-in{% endif %}">
      <div class="fpt-head__left">
        {%- if heading != blank -%}
          <h2 class="fpt-h2">{{ heading }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 1 -%}
          <div class="fpt-chips" role="tablist" aria-label="{{ heading | escape }}">
            {%- for block in section.blocks -%}
              {%- liquid
                assign tab_name = block.settings.title
                if tab_name == blank
                  if block.settings.collection != blank
                    assign tab_name = collections[block.settings.collection].title
                  else
                    assign tab_name = 'Tab ' | append: forloop.index
                  endif
                endif
                assign active_class = ''
                if forloop.first
                  assign active_class = ' is-active'
                endif
              -%}
              <button
                type="button"
                class="fpt-chip{{ active_class }}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="fpt-panel-{{ block.id }}"
                id="fpt-btn-{{ block.id }}"
                data-panel="fpt-panel-{{ block.id }}"
                {{ block.shopify_attributes }}
              >{{ tab_name }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if view_all_url != blank and view_all_label != blank -%}
        <a href="{{ view_all_url }}" class="fpt-ulink">{{ view_all_label }}</a>
      {%- endif -%}
    </div>

    <!-- Tab panels -->
    {%- for block in section.blocks -%}
      {%- assign col = collections[block.settings.collection] -%}
      {%- assign custom_label = block.settings.custom_label -%}
      <div
        class="fpt-grid{% unless forloop.first %} fpt-grid--hidden{% endunless %}"
        id="fpt-panel-{{ block.id }}"
        role="tabpanel"
        aria-labelledby="fpt-btn-{{ block.id }}"
        {{ block.shopify_attributes }}
      >
        {%- if col != blank -%}
          {%- for product in col.products limit: limit -%}
            {%- liquid
              assign first_img  = product.featured_image
              assign second_img = product.images[1]
              assign on_sale    = false
              if product.compare_at_price > product.price
                assign on_sale = true
              endif
              assign single_variant = false
              if product.variants.size == 1 and product.available
                assign single_variant = true
              endif
            -%}
            <article class="fpt-card">

              <!-- Image block -->
              <a class="fpt-media" href="{{ product.url }}">
                {%- if first_img != blank -%}
                  <img
                    class="fpt-pimg"
                    srcset="
                      {%- if first_img.width >= 400 -%}{{ first_img | image_url: width: 400 }} 400w,{%- endif -%}
                      {%- if first_img.width >= 600 -%}{{ first_img | image_url: width: 600 }} 600w,{%- endif -%}
                      {%- if first_img.width >= 800 -%}{{ first_img | image_url: width: 800 }} 800w,{%- endif -%}
                      {{ first_img | image_url }} {{ first_img.width }}w
                    "
                    src="{{ first_img | image_url: width: 600 }}"
                    sizes="(min-width: 990px) calc(100vw / {{ columns }} - 40px), 50vw"
                    alt="{{ first_img.alt | default: product.title | escape }}"
                    width="{{ first_img.width }}"
                    height="{{ first_img.height }}"
                    loading="lazy"
                  >
                {%- endif -%}

                {%- if show_second_image and second_img != blank -%}
                  <img
                    class="fpt-pimg fpt-pimg--hover"
                    src="{{ second_img | image_url: width: 600 }}"
                    alt=""
                    width="{{ second_img.width }}"
                    height="{{ second_img.height }}"
                    loading="lazy"
                  >
                {%- endif -%}

                {%- if custom_label != blank -%}
                  <span class="fpt-badge fpt-badge--custom" style="background:{{ block.settings.custom_label_color }};color:{{ block.settings.custom_label_text_color }}">{{ custom_label }}</span>
                {%- elsif on_sale -%}
                  <span class="fpt-badge">SALE</span>
                {%- endif -%}
              </a>

              <!-- Wishlist icon -->
              {%- if show_wishlist -%}
                <a class="fpt-wish" href="/pages/wishlist" aria-label="Add to wishlist">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>
                  </svg>
                </a>
              {%- endif -%}

              <!-- Product type -->
              {%- if product.type != blank -%}
                <div class="fpt-ptype">{{ product.type | upcase }}</div>
              {%- endif -%}

              <!-- Title -->
              <a class="fpt-pname" href="{{ product.url }}">{{ product.title }}</a>

              <!-- Price -->
              <div class="fpt-price">
                <span class="fpt-now">{{ product.price | money }}</span>
                {%- if on_sale -%}
                  <span class="fpt-was">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>

              <!-- CTA button -->
              {%- if product.available == false -%}
                <span class="fpt-btn fpt-btn--card fpt-btn--disabled" aria-disabled="true">Sold out</span>
              {%- elsif single_variant -%}
                <button
                  type="button"
                  class="fpt-btn fpt-btn--card fpt-atc"
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                >Add to cart</button>
              {%- else -%}
                <a class="fpt-btn fpt-btn--card" href="{{ product.url }}">Choose options</a>
              {%- endif -%}

            </article>
          {%- else -%}
            <p style="color:var(--grey-color);font-size:14px;">No products found in this collection.</p>
          {%- endfor -%}
        {%- else -%}
          <p style="color:var(--grey-color);font-size:14px;">Select a collection for this tab.</p>
        {%- endif -%}
      </div>
    {%- endfor -%}

  </div>
</section>

<!-- Add to cart JS (single-variant) -->
<script>
(function () {
  var section = document.getElementById('{{ section.id }}');
  if (!section) return;
  section.addEventListener('click', function (e) {
    var btn = e.target.closest('.fpt-atc');
    if (!btn) return;
    btn.disabled = true;
    btn.textContent = 'Adding…';
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: btn.dataset.variantId, quantity: 1 })
    })
    .then(function (r) { return r.json(); })
    .then(function () {
      btn.textContent = 'Added!';
      /* update header cart count if theme exposes it */
      document.dispatchEvent(new CustomEvent('cart:refresh'));
      setTimeout(function () { btn.disabled = false; btn.textContent = 'Add to cart'; }, 1800);
    })
    .catch(function () { btn.disabled = false; btn.textContent = 'Add to cart'; });
  });

  /* Tab switching */
  section.querySelectorAll('.fpt-chip').forEach(function (chip) {
    chip.addEventListener('click', function () {
      section.querySelectorAll('.fpt-chip').forEach(function (c) {
        c.classList.remove('is-active');
        c.setAttribute('aria-selected', 'false');
      });
      section.querySelectorAll('.fpt-grid').forEach(function (p) {
        p.classList.add('fpt-grid--hidden');
      });
      chip.classList.add('is-active');
      chip.setAttribute('aria-selected', 'true');
      var panel = section.querySelector('#' + chip.dataset.panel);
      if (panel) panel.classList.remove('fpt-grid--hidden');
    });
  });
}());
</script>

{% schema %}
{
  "name": "Featured Product Tabs",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "default": "container",
      "options": [
        { "value": "container",       "label": "Default"    },
        { "value": "container-fluid", "label": "Fluid"      },
        { "value": "strecth-width",   "label": "Stretch"    },
        { "value": "full-width",      "label": "Full width" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "range",
      "id": "limit_products",
      "label": "Products per tab",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "item_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap (px)",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": false
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab label",
          "info": "Leave blank to use collection name"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_label",
          "label": "Product badge label",
          "info": "Shown top-left on every product in this tab (e.g. NEW, HOT, SALE). Leave blank to show SALE badge only on discounted products."
        },
        {
          "type": "color",
          "id": "custom_label_color",
          "label": "Badge background color",
          "default": "#141414"
        },
        {
          "type": "color",
          "id": "custom_label_text_color",
          "label": "Badge text color",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Product Tabs",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
